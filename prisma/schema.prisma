// ============================================================================
// NARA - 영어학원 AI ERP Platform
// Provider: PostgreSQL (Supabase)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// 1. CORE — Academy, Staff, School, Student, Parent
// ============================================================================

/// Academy (학원) — the root tenant entity
/// status: "ACTIVE" | "TRIAL" | "SUSPENDED" | "DEACTIVATED"
model Academy {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  address   String?
  logoUrl   String?
  color     String?  @default("#3B82F6") // Brand color
  code      String   @unique @db.Char(4) // Tutor academy login code
  status    String   @default("ACTIVE") // "ACTIVE" | "TRIAL" | "SUSPENDED" | "DEACTIVATED"
  settings  String?  @db.Text // JSON: business hours, notification prefs, etc.
  memo      String?  @db.Text // Admin internal notes shown on 회원 관리 (member management)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  staff                     Staff[]
  students                  Student[]
  parents                   Parent[]
  schools                   School[]
  classes                   Class[]
  attendances               Attendance[]
  invoices                  Invoice[]
  expenses                  Expense[]
  salaries                  Salary[]
  calendarEvents            CalendarEvent[]
  consultations             Consultation[]
  assignments               Assignment[]
  passages                  Passage[]
  questions                 Question[]
  questionSets              QuestionSet[]
  questionCollections       QuestionCollection[]
  passageCollections        PassageCollection[]
  examCollections           ExamCollection[]
  webtoonCollections        WebtoonCollection[]
  m1PassageDraftCollections M1PassageDraftCollection[]
  exams                     Exam[]
  vocabLists                VocabularyList[]
  teacherPrompts            TeacherPrompt[]
  textbooks                 Textbook[]
  achievements              Achievement[]
  studySeasons              StudySeason[]
  naeshinQuestions          NaeshinQuestion[]
  learningSets              LearningSet[]
  subscriptions             AcademySubscription[]
  portoneBillingKeys        PortOneBillingKey[]
  subscriptionPayments      SubscriptionPayment[]
  creditBalance             CreditBalance?
  creditTransactions        CreditTransaction[]
  creditTopUps              CreditTopUp[]
  extractionJobs            ExtractionJob[]
  workbenchAiJobs           WorkbenchAiJob[]
  extractionAuditLogs       ExtractionAuditLog[]
  sourceMaterials           SourceMaterial[]
  webtoons                  Webtoon[]
  classMaterials            ClassMaterial[]
  tutorStudentSessions      TutorStudentSession[]
  parentConsents            ParentConsent[]
  appEvents                 AppEvent[]
  tutorPrograms             TutorProgram[]
  tutorLessons              TutorLesson[]
  tutorActivities           TutorActivity[]
  tutorAssignments          TutorAssignment[]
  tutorAssignmentTargets    TutorAssignmentTarget[]
  tutorAssignmentRecipients TutorAssignmentRecipient[]
  tutorProgress             TutorProgress[]
  tutorAttempts             TutorAttempt[]
  tutorAttemptItems         TutorAttemptItem[]
  tutorConversations        TutorConversation[]
  tutorMessages             TutorMessage[]
  tutorMastery              TutorMastery[]
  tutorReviewSchedules      TutorReviewSchedule[]
  tutorCoverageSnapshots    TutorCoverageSnapshot[]
  tutorWeaknessSnapshots    TutorWeaknessSnapshot[]
  tutorAiLogs               TutorAiLog[]
  platformApiUsageCosts     PlatformApiUsageCost[]
  moderationLogs            ModerationLog[]
  tutorLearningEvents       TutorLearningEvent[]
  tutorBillingPlan          BillingPlan?
  tutorSeatBillingRuns      SeatBillingRun[]
  academyTheme              AcademyTheme?
  academyFeatureFlags       AcademyFeatureFlag[]
  passageReports            PassageReport[]
  examAnalyses              ExamAnalysis[]
  examReportStudents        ExamReportStudent[]
  // ── Growth: referral / credit missions / notifications ──
  referralCode              ReferralCode?
  referralsMade             Referral[]                 @relation("ReferralsMade")
  referralReceived          Referral?                  @relation("ReferralReceived")
  missionClaims             AcademyMissionClaim[]
  notifications             Notification[]

  @@map("academies")
}

/// Staff — Directors and Teachers
/// role: "DIRECTOR" | "TEACHER"
model Staff {
  id                     String    @id @default(cuid())
  academyId              String
  email                  String    @unique
  password               String
  name                   String
  phone                  String?
  role                   String    @default("TEACHER") // "DIRECTOR" | "TEACHER"
  avatarUrl              String?
  isActive               Boolean   @default(true)
  supabaseUserId         String?   @unique @map("supabase_user_id") @db.Uuid
  kakaoId                String?   @unique @map("kakao_id")
  authProvider           String?   @map("auth_provider") // credentials | google | kakao
  lastLoginAt            DateTime? @map("last_login_at") @db.Timestamptz(6)
  // 스모트 소식(플랫폼 공지) 마지막 확인 시각 — 이 시각 이후 발행된 글이 있으면
  // "새 소식" 배지를 띄운다. 공지별 읽음 레코드 대신 프로필당 타임스탬프 1개로 추적.
  lastAnnouncementReadAt DateTime? @map("last_announcement_read_at")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // 마케팅 정보 수신 동의 (정보통신망법 제50조 opt-in 근거).
  // 선택 항목 — 동의해야만 SMS·카카오톡(브랜드메시지)·이메일 등 광고성 발송 대상이 된다.
  // marketingConsentAt 은 "언제 동의했는지" 증빙용 타임스탬프(미동의면 null).
  marketingConsent   Boolean   @default(false) @map("marketing_consent")
  marketingConsentAt DateTime? @map("marketing_consent_at") @db.Timestamptz(6)

  // Relations
  academy                Academy              @relation(fields: [academyId], references: [id])
  classes                Class[] // Classes taught
  staffAttendances       StaffAttendance[]
  salaries               Salary[]
  consultations          Consultation[]
  messages               Message[]            @relation("SentMessages")
  receivedMessages       Message[]            @relation("ReceivedStaffMessages")
  extractionJobs         ExtractionJob[]      @relation("ExtractionJobCreator")
  workbenchAiJobs        WorkbenchAiJob[]     @relation("WorkbenchAiJobCreator")
  extractionAuditLogs    ExtractionAuditLog[] @relation("ExtractionAuditActor")
  createdSourceMaterials SourceMaterial[]     @relation("SourceMaterialCreator")
  webtoons               Webtoon[]            @relation("WebtoonCreator")
  uploadedMaterials      ClassMaterial[]      @relation("ClassMaterialUploader")
  tutorProgramsAuthored  TutorProgram[]       @relation("TutorProgramAuthor")
  tutorLessonsAuthored   TutorLesson[]        @relation("TutorLessonAuthor")

  // ── Passage Reports (A4 자유 편집 학습자료) ──
  passageReportsCreated  PassageReport[]         @relation("PassageReportCreator")
  passageReportsEdited   PassageReport[]         @relation("PassageReportEditor")
  passageReportRevisions PassageReportRevision[] @relation("PassageReportRevisionAuthor")

  // ── Growth: per-staff notification inbox ──
  notifications     Notification[]
  notificationState NotificationState?

  @@index([academyId])
  @@map("staff")
}

/// School — Reference schools that students attend (강동중, 명일여고 etc.)
/// type: "MIDDLE" | "HIGH" | "ELEMENTARY"
model School {
  id        String   @id @default(cuid())
  academyId String
  name      String
  slug      String
  type      String // "MIDDLE" | "HIGH" | "ELEMENTARY"
  publisher String? // 교과서 출판사
  createdAt DateTime @default(now())

  // Relations
  academy          Academy           @relation(fields: [academyId], references: [id])
  students         Student[]
  passages         Passage[]
  exams            Exam[]
  naeshinQuestions NaeshinQuestion[]
  sourceMaterials  SourceMaterial[]

  @@unique([academyId, slug])
  @@index([academyId])
  @@map("schools")
}

/// Student — Academy students
/// status: "ACTIVE" | "PAUSED" | "WITHDRAWN" | "WAITING"
/// gender: "MALE" | "FEMALE" | null
model Student {
  id                    String    @id @default(cuid())
  academyId             String
  name                  String
  studentCode           String // legacy login code; tutor auth uses academy-scoped HMAC/hash fields
  studentCodeLookupHmac String?
  studentCodeHash       String?
  birthDate             DateTime?
  gender                String? // "MALE" | "FEMALE"
  phone                 String?
  schoolId              String?
  grade                 Int
  status                String    @default("ACTIVE") // "ACTIVE" | "PAUSED" | "WITHDRAWN" | "WAITING"
  enrollDate            DateTime  @default(now())
  withdrawDate          DateTime?
  pauseDate             DateTime?
  memo                  String?   @db.Text // Special notes (allergies, personality, etc.)
  avatarUrl             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Gamification
  xp                Int       @default(0)
  level             Int       @default(1)
  streak            Int       @default(0)
  streakFreezeCount Int       @default(0) // max 3
  lastStudyDate     DateTime?

  // 스모트 소식(플랫폼 공지) 마지막 확인 시각 — 프로필당 타임스탬프 1개로 신규 여부 판단.
  lastAnnouncementReadAt DateTime? @map("last_announcement_read_at")

  // Relations
  academy                   Academy                    @relation(fields: [academyId], references: [id])
  school                    School?                    @relation(fields: [schoolId], references: [id])
  parentLinks               ParentStudent[]
  classEnrollments          ClassEnrollment[]
  attendances               Attendance[]
  invoices                  Invoice[]
  consultations             Consultation[]
  assignmentSubs            AssignmentSubmission[]
  examSubmissions           ExamSubmission[]
  vocabTestResults          VocabTestResult[]
  wrongVocabAnswers         WrongVocabAnswer[]
  aiConversations           AIConversation[]
  studyProgress             StudyProgress[]
  studentAchievements       StudentAchievement[]
  studentAnalytics          StudentAnalytics?
  parentReports             ParentReport[]
  wrongAnswerLogs           WrongAnswerLog[]
  lessonProgress            LessonProgress[]
  sessionRecords            SessionRecord[]
  dailyMissions             StudentDailyMission[]
  naeshinWrongAnswerLogs    NaeshinWrongAnswerLog[]
  suneungWrongAnswerLogs    SuneungWrongAnswerLog[]
  tutorStudentSessions      TutorStudentSession[]
  parentConsents            ParentConsent[]
  tutorAssignmentRecipients TutorAssignmentRecipient[] @relation("TutorAssignmentRecipientStudent")
  tutorProgress             TutorProgress[]            @relation("TutorProgressStudent")
  tutorAttempts             TutorAttempt[]             @relation("TutorAttemptStudent")
  tutorConversations        TutorConversation[]        @relation("TutorConversationStudent")
  tutorMessages             TutorMessage[]             @relation("TutorMessageStudent")
  tutorMastery              TutorMastery[]             @relation("TutorMasteryStudent")
  tutorReviewSchedules      TutorReviewSchedule[]      @relation("TutorReviewScheduleStudent")
  tutorWeaknessSnapshots    TutorWeaknessSnapshot[]    @relation("TutorWeaknessSnapshotStudent")
  tutorLearningEvents       TutorLearningEvent[]       @relation("TutorLearningEventStudent")
  tutorModerationLogs       ModerationLog[]            @relation("TutorModerationStudent")

  @@unique([academyId, studentCode])
  @@index([academyId, studentCodeLookupHmac])
  @@index([academyId])
  @@index([schoolId])
  @@index([academyId, status])
  @@map("students")
}

/// Parent — Student guardians
model Parent {
  id                     String    @id @default(cuid())
  academyId              String
  name                   String
  phone                  String
  email                  String?
  relation               String? // "MOTHER" | "FATHER" | "GUARDIAN" | "OTHER"
  emergencyContact       String?
  memo                   String?   @db.Text
  loginToken             String?   @unique // For passwordless parent login via link
  // 스모트 소식(플랫폼 공지) 마지막 확인 시각 — 프로필당 타임스탬프 1개로 신규 여부 판단.
  lastAnnouncementReadAt DateTime? @map("last_announcement_read_at")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  academy       Academy         @relation(fields: [academyId], references: [id])
  studentLinks  ParentStudent[]
  parentReports ParentReport[]
  messages      Message[]       @relation("ParentMessages")

  @@index([academyId])
  @@index([phone])
  @@map("parents")
}

/// ParentStudent — Many-to-many: Parent ↔ Student (siblings support)
model ParentStudent {
  id        String @id @default(cuid())
  parentId  String
  studentId String

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_students")
}

// ============================================================================
// 2. CLASS MANAGEMENT
// ============================================================================

/// Class — Academy classes (반)
model Class {
  id        String   @id @default(cuid())
  academyId String
  name      String
  teacherId String?
  schedule  String?  @db.Text // JSON: [{ day: "MON", startTime: "14:00", endTime: "16:00" }]
  capacity  Int      @default(20)
  fee       Int      @default(0) // Monthly fee in KRW
  room      String? // Classroom name/number
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  academy     Academy           @relation(fields: [academyId], references: [id])
  teacher     Staff?            @relation(fields: [teacherId], references: [id])
  enrollments ClassEnrollment[]
  attendances Attendance[]
  assignments Assignment[]
  exams       Exam[]
  materials   ClassMaterial[]

  @@index([academyId])
  @@index([teacherId])
  @@map("classes")
}

/// ClassEnrollment — Student ↔ Class enrollment (supports multiple classes)
/// status: "ENROLLED" | "WAITLISTED" | "DROPPED"
model ClassEnrollment {
  id         String    @id @default(cuid())
  classId    String
  studentId  String
  status     String    @default("ENROLLED") // "ENROLLED" | "WAITLISTED" | "DROPPED"
  enrolledAt DateTime  @default(now())
  droppedAt  DateTime?

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
  @@map("class_enrollments")
}

// ============================================================================
// 3. ATTENDANCE
// ============================================================================

/// Attendance — Student attendance records
/// status: "PRESENT" | "ABSENT" | "LATE" | "EARLY_LEAVE" | "MAKEUP"
model Attendance {
  id           String    @id @default(cuid())
  academyId    String
  studentId    String
  classId      String?
  date         DateTime
  checkInTime  DateTime?
  checkOutTime DateTime?
  status       String    @default("PRESENT") // "PRESENT" | "ABSENT" | "LATE" | "EARLY_LEAVE" | "MAKEUP"
  note         String?
  method       String? // "KIOSK" | "QR" | "MANUAL"
  createdAt    DateTime  @default(now())

  // Relations
  academy Academy @relation(fields: [academyId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  class   Class?  @relation(fields: [classId], references: [id])

  @@unique([studentId, classId, date])
  @@index([academyId, date])
  @@index([studentId, date])
  @@map("attendances")
}

/// StaffAttendance — Staff clock-in/out records
model StaffAttendance {
  id       String    @id @default(cuid())
  staffId  String
  date     DateTime
  checkIn  DateTime?
  checkOut DateTime?
  note     String?

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@index([staffId, date])
  @@map("staff_attendances")
}

// ============================================================================
// 4. BILLING & FINANCE
// ============================================================================

/// Invoice — Monthly billing records
/// status: "PENDING" | "PAID" | "OVERDUE" | "PARTIAL" | "REFUNDED" | "CANCELLED"
model Invoice {
  id          String    @id @default(cuid())
  academyId   String
  studentId   String
  title       String // e.g. "2026년 3월 수강료"
  amount      Int // Total amount in KRW
  discount    Int       @default(0) // Discount amount
  finalAmount Int // amount - discount
  dueDate     DateTime
  paidDate    DateTime?
  status      String    @default("PENDING")
  memo        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  academy  Academy   @relation(fields: [academyId], references: [id])
  student  Student   @relation(fields: [studentId], references: [id])
  payments Payment[]

  @@index([academyId, status])
  @@index([studentId])
  @@index([academyId, dueDate])
  @@map("invoices")
}

/// Payment — Individual payment transactions
/// method: "CARD" | "TRANSFER" | "CASH" | "KAKAO_PAY" | "NAVER_PAY" | "TOSS"
model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Int
  method    String // "CARD" | "TRANSFER" | "CASH" | "KAKAO_PAY" | "NAVER_PAY" | "TOSS"
  reference String? // Transaction ID from payment gateway
  paidAt    DateTime @default(now())
  memo      String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

/// Expense — Academy expenditures
/// category: "RENT" | "SALARY" | "MATERIALS" | "MARKETING" | "UTILITIES" | "MAINTENANCE" | "OTHER"
model Expense {
  id          String   @id @default(cuid())
  academyId   String
  category    String // "RENT" | "SALARY" | "MATERIALS" | "MARKETING" | "UTILITIES" | "MAINTENANCE" | "OTHER"
  amount      Int
  date        DateTime
  description String?
  receipt     String? // Receipt image URL
  createdAt   DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id])

  @@index([academyId, date])
  @@index([academyId, category])
  @@map("expenses")
}

/// Salary — Staff salary records
model Salary {
  id         String    @id @default(cuid())
  academyId  String
  staffId    String
  month      String // "2026-03" format
  basePay    Int
  bonus      Int       @default(0)
  deductions Int       @default(0)
  totalPay   Int
  paidAt     DateTime?
  memo       String?
  createdAt  DateTime  @default(now())

  academy Academy @relation(fields: [academyId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])

  @@unique([staffId, month])
  @@index([academyId, month])
  @@map("salaries")
}

// ============================================================================
// 5. COMMUNICATION
// ============================================================================
//
// 학원 내부 공지(Notice/NoticeRead)는 플랫폼 공지(PlatformAnnouncement)로 교체되어
// 제거되었습니다. 개발 DB 의 기존 두 테이블은 notices_backup_20260707 /
// notice_reads_backup_20260707 로 이름만 바꿔 보존했고, 운영 DB 정리 SQL 은
// prisma/backups/retire-notices-prod.sql 에 있습니다.

/// Message — 1:1 messages (Teacher ↔ Parent, Director ↔ Anyone)
model Message {
  id           String   @id @default(cuid())
  senderId     String
  senderType   String // "STAFF" | "PARENT"
  receiverId   String
  receiverType String // "STAFF" | "PARENT"
  content      String   @db.Text
  attachments  String?  @db.Text // JSON array of file URLs
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Polymorphic relations
  senderStaff   Staff?  @relation("SentMessages", fields: [senderId], references: [id], map: "msg_sender_staff")
  receiverStaff Staff?  @relation("ReceivedStaffMessages", fields: [receiverId], references: [id], map: "msg_receiver_staff")
  senderParent  Parent? @relation("ParentMessages", fields: [senderId], references: [id], map: "msg_sender_parent")

  @@index([receiverId, receiverType, isRead])
  @@index([senderId, senderType])
  @@map("messages")
}

/// CalendarEvent — Academy calendar
/// type: "EXAM" | "EVENT" | "HOLIDAY" | "MEETING" | "OTHER"
model CalendarEvent {
  id          String    @id @default(cuid())
  academyId   String
  title       String
  description String?   @db.Text
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean   @default(false)
  type        String    @default("EVENT") // "EXAM" | "EVENT" | "HOLIDAY" | "MEETING" | "OTHER"
  color       String? // Custom event color
  createdAt   DateTime  @default(now())

  academy Academy @relation(fields: [academyId], references: [id])

  @@index([academyId, startDate])
  @@map("calendar_events")
}

// ============================================================================
// 6. CONSULTATION
// ============================================================================

/// Consultation — Counseling records
/// type: "NEW_INQUIRY" | "STUDENT" | "PARENT" | "LEVEL_TEST"
/// channel: "PHONE" | "VISIT" | "ONLINE" | "KAKAO"
/// status: "SCHEDULED" | "COMPLETED" | "CANCELLED" | "FOLLOW_UP"
model Consultation {
  id           String    @id @default(cuid())
  academyId    String
  studentId    String?
  staffId      String? // Counselor
  type         String // "NEW_INQUIRY" | "STUDENT" | "PARENT" | "LEVEL_TEST"
  channel      String? // "PHONE" | "VISIT" | "ONLINE" | "KAKAO"
  status       String    @default("SCHEDULED") // "SCHEDULED" | "COMPLETED" | "CANCELLED" | "FOLLOW_UP"
  date         DateTime
  content      String?   @db.Text
  category     String? // "GRADE" | "ATTITUDE" | "CAREER" | "PARENT_REQUEST" | "OTHER"
  followUpDate DateTime?
  followUpNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  academy Academy  @relation(fields: [academyId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])
  staff   Staff?   @relation(fields: [staffId], references: [id])

  @@index([academyId, date])
  @@index([studentId])
  @@map("consultations")
}

// ============================================================================
// 7. ASSIGNMENT
// ============================================================================

/// Assignment — Homework and tasks
/// targetType: "CLASS" | "INDIVIDUAL"
model Assignment {
  id          String   @id @default(cuid())
  academyId   String
  classId     String?
  title       String
  description String?  @db.Text
  targetType  String   @default("CLASS") // "CLASS" | "INDIVIDUAL"
  dueDate     DateTime
  maxScore    Int? // If graded
  attachments String?  @db.Text // JSON array of file URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academy     Academy                @relation(fields: [academyId], references: [id])
  class       Class?                 @relation(fields: [classId], references: [id])
  submissions AssignmentSubmission[]

  @@index([academyId, dueDate])
  @@index([classId])
  @@map("assignments")
}

/// AssignmentSubmission — Student submissions
/// status: "PENDING" | "SUBMITTED" | "LATE" | "GRADED"
model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  status       String    @default("PENDING") // "PENDING" | "SUBMITTED" | "LATE" | "GRADED"
  content      String?   @db.Text
  attachments  String?   @db.Text // JSON
  score        Int?
  feedback     String?   @db.Text
  submittedAt  DateTime?
  gradedAt     DateTime?
  createdAt    DateTime  @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

// ============================================================================
// 8. AI CONTENT — Passages
// ============================================================================

/// Passage — Text passages for study and question generation
/// difficulty: "BEGINNER" | "ELEMENTARY" | "INTERMEDIATE" | "UPPER_INTERMEDIATE" | "ADVANCED" | "EXPERT"
model Passage {
  id         String  @id @default(cuid())
  academyId  String
  schoolId   String? // Optional: school-specific passage
  title      String
  content    String  @db.Text
  source     String? // Source reference (legacy free-form)
  grade      Int?
  semester   String? // "FIRST" | "SECOND"
  unit       String?
  publisher  String? // 교과서 출판사
  difficulty String? // "BEGINNER" ~ "EXPERT"
  tags       String? @db.Text // JSON array of tags
  order      Int     @default(0)

  /// 지문 과목 — null=ENGLISH(기존 지문 전부·영어 경로 무회귀), "KOREAN"=국어.
  /// DB 반영은 surgical ALTER 관례를 따른다 (migrate deploy / db push 금지):
  ///   ALTER TABLE passages ADD COLUMN IF NOT EXISTS subject TEXT;
  subject String?

  // ── Extraction lineage (nullable — manual passages stay untouched) ──
  sourceMaterialId       String?
  sourceExtractionItemId String? @unique
  contentHash            String? // sha1 of content — duplicate detection

  /// Source page(s) the passage was extracted from. Carried through from
  /// ExtractionItem/M1Draft on promote so "where did this come from?" survives.
  /// Empty for manually authored passages. (adaptive-intake P1)
  sourcePageIndex  Int[]   @default([])
  /// "verbatim" | "restored" — whether the stored content is the raw OCR text
  /// or an AI-restored original. Null for manual passages. (adaptive-intake D2)
  extractionOutput String?

  /// 학습지 검수 완료 시각. null = 미검수, 값 있음 = 검수완료. (학습지 카드 검수완료 토글)
  reviewedAt   DateTime?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  academy            Academy                 @relation(fields: [academyId], references: [id])
  school             School?                 @relation(fields: [schoolId], references: [id])
  sourceMaterial     SourceMaterial?         @relation(fields: [sourceMaterialId], references: [id])
  notes              PassageNote[]
  analysis           PassageAnalysis?
  questions          Question[]
  teacherPrompts     TeacherPrompt[]
  seasonLinks        SeasonPassage[]
  lessonProgress     LessonProgress[]
  sessionRecords     SessionRecord[]
  naeshinQuestions   NaeshinQuestion[]
  prebuiltSessions   PrebuiltSession[]
  learningSets       LearningSet[]
  collectionItems    PassageCollectionItem[]
  bundles            PassageBundle[]
  webtoons           Webtoon[]
  tutorLessons       TutorLesson[]
  tutorConversations TutorConversation[]
  tutorAiLogs        TutorAiLog[]
  workbenchAiJobs    WorkbenchAiJob[]
  reports            PassageReport[]
  setBasePassages    QuestionSet[]           @relation("SetBasePassage")

  @@index([academyId])
  @@index([schoolId])
  @@index([academyId, grade, semester])
  @@index([sourceMaterialId])
  @@index([contentHash])
  @@map("passages")
}

/// PassageAnalysis — AI-generated analysis cache
model PassageAnalysis {
  id           String   @id @default(cuid())
  passageId    String   @unique
  analysisData String   @db.Text // JSON: sentences, vocab, grammar, structure
  contentHash  String // MD5 for change detection
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passage Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@map("passage_analyses")
}

/// PassageNote — Teacher annotations on passages (Tiptap marks + memos).
/// noteType: "vocab" | "grammar" | "syntax" | "sentence" | "examPoint"
///   (5 marking types matching PassageAnnotationEditor; legacy values EMPHASIS/TIP still accepted)
/// content: the selected passage text (what the teacher highlighted)
/// memo: the teacher's note about WHY they marked it (fed to AI as intent signal)
/// annotationId: client-side UUID used by the Tiptap mark to round-trip selections
/// highlightStart / highlightEnd: ProseMirror positions (from/to) for mark restoration
model PassageNote {
  id             String   @id @default(cuid())
  passageId      String
  annotationId   String? // matches Tiptap mark attrs.id for client round-trip
  content        String   @db.Text
  memo           String   @default("") @db.Text
  highlightStart Int?
  highlightEnd   Int?
  noteType       String   @default("vocab")
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  passage Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@index([passageId])
  @@index([passageId, annotationId])
  @@map("passage_notes")
}

/// PassageReport — A4 자유 편집 학습자료 (Canva 스타일 보고서)
/// 동일 passage에 N개 보고서 가능 (수업용 / 내신킬러 / 보강용 등 변형)
/// pages: PageNode[] — 페이지/블록 트리 (Zod: src/lib/passage-report/schema.ts)
/// theme: ReportTheme — palette/font scale
/// templateId: "modern" | "classic" | "magazine" | "notebook" | "exam-sheet" (디자인 스킨)
/// status: "DRAFT" | "PUBLISHED" | "ARCHIVED"
/// version: 낙관적 락 (PATCH 시 WHERE id=$1 AND version=$expected)
/// shareToken / sharedAt: v2 외부 공유 링크 대비 (현재는 nullable 컬럼만)
model PassageReport {
  id                    String    @id @default(cuid())
  academyId             String
  passageId             String
  title                 String
  status                String    @default("DRAFT") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  pages                 Json // PageNode[] — single source of truth
  theme                 Json? // ReportTheme — palette / font scale
  templateId            String? // "modern" | "classic" | "magazine" | "notebook" | "exam-sheet"
  generationPlan        String    @default("STANDARD")
  sourcedFromAnalysisId String? // 어떤 PassageAnalysis 스냅샷에서 생성됐는지 (FK 아님 — soft ref)
  contentHash           String? // pages JSON sha1 — PDF 캐시 키
  version               Int       @default(1)
  createdById           String
  lastEditedById        String?
  lastEditedAt          DateTime?
  publishedAt           DateTime?
  shareToken            String?   @unique // v2 외부 공유 토큰
  sharedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime? // soft delete

  // Relations
  academy      Academy                 @relation(fields: [academyId], references: [id], onDelete: Cascade)
  passage      Passage                 @relation(fields: [passageId], references: [id], onDelete: Cascade)
  createdBy    Staff                   @relation("PassageReportCreator", fields: [createdById], references: [id])
  lastEditedBy Staff?                  @relation("PassageReportEditor", fields: [lastEditedById], references: [id])
  revisions    PassageReportRevision[]
  exports      PassageReportExport[]

  @@index([academyId, passageId])
  @@index([academyId, status, updatedAt])
  @@index([passageId])
  @@map("passage_reports")
}

/// CoverPreset — 학원 단위 재사용 표지 프리셋 (분석 보고서 편집기에서 저장/적용)
model CoverPreset {
  id          String   @id @default(cuid())
  academyId   String
  name        String
  cover       Json // ReportCover (logoDataUrl 포함)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([academyId, updatedAt])
  @@map("cover_presets")
}

/// PassageReportRevision — 명시적 스냅샷 (수동 "버전 저장" 또는 자동 N분마다)
model PassageReportRevision {
  id        String   @id @default(cuid())
  reportId  String
  version   Int
  pages     Json
  theme     Json?
  authorId  String
  note      String?  @db.Text
  createdAt DateTime @default(now())

  report PassageReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author Staff         @relation("PassageReportRevisionAuthor", fields: [authorId], references: [id])

  @@unique([reportId, version])
  @@index([reportId, createdAt])
  @@map("passage_report_revisions")
}

/// PassageReportExport — 출력물 캐시 (Supabase Storage)
/// format: "PDF" | "DOCX"
/// contentHash: 같으면 재사용 (캐시 hit)
model PassageReportExport {
  id            String    @id @default(cuid())
  reportId      String
  format        String // "PDF" | "DOCX"
  contentHash   String // pages JSON sha1
  storageKey    String? // supabase storage path (생성 완료 시 채워짐)
  fileSizeBytes Int?
  triggerRunId  String?
  status        String    @default("PENDING") // "PENDING" | "RUNNING" | "DONE" | "FAILED"
  errorMessage  String?   @db.Text
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  expiresAt     DateTime?

  report PassageReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, format, contentHash])
  @@index([reportId])
  @@index([status, createdAt])
  @@map("passage_report_exports")
}

// ============================================================================
// 8-b. EXAM REPORT — 학생 시험 리포트 (학교 시험지 분석 + 학생별 상담 리포트)
// ============================================================================

/// ExamAnalysis — 학교 중간/기말 시험지 1부의 구조화 + AI 문항별 정밀분석
/// status: "DRAFT" | "EXTRACTING" | "STRUCTURED" | "ANALYZING" | "ANALYZED" | "FAILED"
/// sourceType: "IMAGE" | "PDF" | "TEXT" | "MANUAL"
/// structure: ExamPaperStructure — {questions, sharedPassages, totalPoints} (Zod: src/lib/exam-report/schemas.ts)
/// analysis: ExamAnalysisResult — {perQuestion: QuestionAnalysis[], examLevel} (문항별 analysisStatus 포함)
/// version: 낙관적 락 (PATCH 시 WHERE id AND version=$expected)
model ExamAnalysis {
  id          String  @id @default(cuid())
  academyId   String
  createdById String? // Staff soft-ref (FK 아님 — 감사용)
  title       String
  schoolName  String?
  grade       String?
  subject     String  @default("ENGLISH")
  examType    String  @default("MIDTERM") // "MIDTERM" | "FINAL" | "MOCK" | "OTHER"
  examYear    Int?
  semester    String?
  status      String  @default("DRAFT")
  sourceType  String  @default("MANUAL") // "MANUAL" | "INTERNAL"(자체 생성 시험지 합성 분석 — vision 미경유)
  sourceFiles Json? // [{path, page}] — Supabase Storage(extraction-sources) 키

  /// 자체 생성 시험지(Exam) 내부 분석 링크 — sourceType="INTERNAL" 전용 soft-ref(FK 미설정).
  /// structure/analysis 는 Question 뱅크에서 합성(src/lib/exam-scoring/internal-analysis.ts).
  sourceExamId String?
  structure    Json? // ExamPaperStructure
  analysis     Json? // ExamAnalysisResult (배치 체크포인트 증분 저장 대상)
  reviewState  Json? // {structureConfirmed, confirmedNumbers[], staleNumbers[]}
  aiMeta       Json? // {model, calls, promptTokens, completionTokens, durationMs, structureRuns, failedNumbers[]}
  version      Int       @default(1)
  deletedAt    DateTime? // soft delete
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  academy  Academy             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  students ExamReportStudent[]

  @@index([academyId, status, createdAt])
  @@index([academyId, deletedAt, updatedAt])
  @@index([sourceExamId])
  @@map("exam_analyses")
}

/// ExamReportStudent — 시험지 분석 1건에 등록된 학생 1명의 채점 + 상담 리포트
/// responses: StudentResponse[] — status 기본 UNKNOWN, source MANUAL|AUTO, reviewed
/// report: {current: StudentReportDoc, previous?: StudentReportDoc} — 재생성 롤백 1슬롯
/// reportStatus: "NONE" | "GENERATING" | "GENERATED" | "FAILED"
/// shareToken: 공개 리포트 /r/[token] — revoke 시 null, 재발급 시 신규(자동 rotate)
model ExamReportStudent {
  id                String    @id @default(cuid())
  examAnalysisId    String
  academyId         String
  studentName       String
  studentMeta       Json? // {school?, grade?, classroom?, note?}
  sourceFiles       Json? // 학생 본인 시험지 페이지 [{path, page}] (v3 직접분석)
  readState         Json? // {status, readRuns, readAt, model, uncertainties[], aiMeta} (v3 AI 답안 판독)
  responses         Json? // StudentResponse[]
  scoreSummary      Json? // ScoreSummary (서버 결정론 계산 캐시)
  gradingConfirmed  Boolean   @default(false)
  report            Json? // {current, previous?}
  reportStatus      String    @default("NONE")
  shareToken        String?   @unique
  shareEnabled      Boolean   @default(false)
  sharedAt          DateTime?
  answerToken       String?   @unique // 학생 답안입력 링크 /a/[token] — 리포트 공유 shareToken 과 별개
  answerEnabled     Boolean   @default(false)
  answerSubmittedAt DateTime? // 학생이 마지막으로 답안을 제출한 시각

  // ── 26-07-09 로스터 귀속(soft-ref, FK 미설정) — 자체 시험지 응시 이력을 Student 에 축적 ──
  studentId        String? // Student.id — null=기존 자유 이름입력(하위호환)
  examSubmissionId String? // ExamSubmission.id — 자체 시험지 채점 브리지 역링크
  version          Int       @default(1)
  deletedAt        DateTime? // soft delete
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  academy      Academy      @relation(fields: [academyId], references: [id], onDelete: Cascade)
  examAnalysis ExamAnalysis @relation(fields: [examAnalysisId], references: [id], onDelete: Cascade)

  @@index([examAnalysisId, deletedAt])
  @@index([academyId, createdAt])
  @@index([studentId])
  @@map("exam_report_students")
}

// ============================================================================
// 9. AI CONTENT — Questions & Question Bank
// ============================================================================

/// Question — Question bank (AI-generated or manual)
/// type: "MULTIPLE_CHOICE" | "SHORT_ANSWER" | "ESSAY" | "FILL_BLANK" | "ORDERING" | "VOCAB"
/// subType: Specific question pattern (e.g. "BLANK_INFERENCE", "GRAMMAR_ERROR", "SENTENCE_INSERT" etc.)
/// difficulty: "BASIC" | "INTERMEDIATE" | "KILLER"
model Question {
  id               String  @id @default(cuid())
  academyId        String
  passageId        String? // Source passage (if passage-based)
  type             String // "MULTIPLE_CHOICE" | "SHORT_ANSWER" | "ESSAY" | "FILL_BLANK" | "ORDERING" | "VOCAB"
  subType          String? // Specific pattern within type
  questionText     String  @db.Text
  structuredData   Json? // Original structured AI output for type-specific rendering
  questionImage    String? // Image URL
  options          String? @db.Text // JSON: [{ label: "①", text: "..." }, ...] for MC
  correctAnswer    String  @db.Text // Answer text or JSON for complex answers
  points           Int     @default(1)
  difficulty       String  @default("INTERMEDIATE") // "BASIC" | "INTERMEDIATE" | "KILLER"
  tags             String? @db.Text // JSON: ["관계대명사", "시제", ...] for filtering
  learningCategory String? // "VOCAB" | "INTERPRETATION" | "GRAMMAR" | "COMPREHENSION"
  aiGenerated      Boolean @default(false)
  approved         Boolean @default(false) // Teacher review status
  starred          Boolean @default(false) // Important/starred by teacher

  // ── Extraction lineage (nullable — manual questions stay untouched) ──
  sourceMaterialId       String?
  bundleId               String?
  sourceExtractionItemId String? @unique
  questionNumber         Int? // printed number on the original exam (e.g. 33)

  // ── 장문 세트 membership (nullable — solo questions stay null) ──
  setId String? // denormalized — fast set filtering without a join
  inSet Boolean @default(false)

  // ── 동형 문제 생성 잡 귀속 (nullable — 동형 생성분만 채워짐) ──
  // 동시 실행 job 결과를 createdAt 범위가 아니라 jobId 로 정확히 묶기 위한 비정규화 컬럼.
  similarQuestionGenJobId String? // SimilarQuestionGenerationJob.id (FK 미설정, 인덱스만)

  // ── 커스텀 유형 생성 귀속 (nullable — 커스텀 유형 생성분만 채워짐) ──
  // 강사 커스텀 유형으로 생성된 문항을 유형별로 묶기(피드백 루프·텔레메트리·결과 필터)용 비정규화 컬럼.
  customTypeId String? // CustomQuestionType.id (FK 미설정, 인덱스만)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── 휴지통(soft delete) — 삭제는 즉시 물리삭제가 아니라 deletedAt 타임스탬프로
  // 표시되고, 모든 정상 읽기 경로는 deletedAt:null 로 거른다. 복원은 deletedAt 를
  // null 로 되돌리고, "영구 삭제"만 실제 cascade 물리삭제다. (자동 purge 없음) ──
  deletedAt   DateTime?
  deletedById String? // 삭제를 수행한 staff.id (감사/표시용, FK 미설정)

  // Relations
  academy         Academy                  @relation(fields: [academyId], references: [id])
  passage         Passage?                 @relation(fields: [passageId], references: [id])
  sourceMaterial  SourceMaterial?          @relation(fields: [sourceMaterialId], references: [id])
  bundle          PassageBundle?           @relation("BundleQuestions", fields: [bundleId], references: [id])
  setItem         QuestionSetItem?         @relation("SetItemQuestion")
  explanation     QuestionExplanation?
  examLinks       ExamQuestion[]
  wrongLogs       WrongAnswerLog[]
  aiConversations AIConversation[]
  collectionItems QuestionCollectionItem[]

  @@index([academyId])
  @@index([passageId])
  @@index([academyId, type, difficulty])
  @@index([academyId, approved])
  @@index([sourceMaterialId])
  @@index([bundleId])
  @@index([setId])
  @@index([similarQuestionGenJobId])
  @@index([customTypeId])
  @@index([academyId, deletedAt, createdAt])
  @@index([deletedAt])
  @@index([deletedAt, createdAt])
  @@map("questions")
}

/// QuestionExplanation — Detailed explanation for each question
model QuestionExplanation {
  id                      String   @id @default(cuid())
  questionId              String   @unique
  content                 String   @db.Text // Rich HTML explanation
  keyPoints               String?  @db.Text // JSON string array
  wrongOptionExplanations String?  @db.Text // JSON: { "1": "왜 틀렸는지...", "2": "..." }
  relatedGrammar          String?  @db.Text // Related grammar rules
  difficulty              String?
  aiGenerated             Boolean  @default(false)
  approved                Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_explanations")
}

/// WorkbenchAiJob — persistent background jobs for passage analysis and
/// question generation. These are Trigger.dev-owned jobs so refreshes,
/// navigation, and browser restarts do not lose progress.
/// domain: "PASSAGE_ANALYSIS" | "QUESTION_GENERATION"
/// status: "PENDING" | "PROCESSING" | "COMPLETED" | "PARTIAL" | "FAILED" | "CANCELLED"
/// mode: for question generation, "AUTO" | "MANUAL"; for analysis, "FULL"
model WorkbenchAiJob {
  id          String @id @default(cuid())
  academyId   String
  createdById String

  domain String
  status String @default("PENDING")
  title  String

  passageId      String?
  mode           String?
  questionType   String?
  generationPlan String  @default("STANDARD")
  difficulty     String?

  requestedCount Int @default(1)
  successCount   Int @default(0)
  failedCount    Int @default(0)
  resultCount    Int @default(0)

  config       Json?
  result       Json?
  errorMessage String? @db.Text
  triggerRunId String? @db.Text
  creditTxId   String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  academy      Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  createdBy    Staff         @relation("WorkbenchAiJobCreator", fields: [createdById], references: [id], onDelete: Cascade)
  passage      Passage?      @relation(fields: [passageId], references: [id], onDelete: SetNull)
  questionSets QuestionSet[]

  @@index([academyId, domain, status])
  @@index([academyId, createdAt])
  @@index([passageId])
  @@index([status, createdAt])
  @@map("workbench_ai_jobs")
}

/// Durable, per-Workbench-assignment provider-call and worst-case-cost budget.
/// OFF mode never touches this table. Active policies are immutable once the
/// first row is created for a job.
model QuestionGenerationCallBudget {
  jobId String @id @map("job_id")

  policyVersion  String @map("policy_version")
  policyHash     String @map("policy_hash")
  descriptorHash String @map("descriptor_hash")
  mode           String
  state          String @default("ACTIVE")
  policySnapshot Json   @map("policy_snapshot")

  maxPhysicalCalls      Int?    @map("max_physical_calls")
  leasedCalls           Int     @default(0) @map("leased_calls")
  maxReservedCostMicros BigInt? @map("max_reserved_cost_micros")
  reservedCostMicros    BigInt  @default(0) @map("reserved_cost_micros")
  observedCostMicros    BigInt  @default(0) @map("observed_cost_micros")

  priceSnapshotId   String? @map("price_snapshot_id")
  priceSnapshotHash String? @map("price_snapshot_hash")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(3)

  leases QuestionGenerationCallLease[]

  @@index([mode, createdAt])
  @@map("question_generation_call_budgets")
}

/// One committed row per physical fetch admission. A lease is never reclaimed;
/// a crash between commit and send intentionally leaves an ambiguous consumed
/// ordinal and its full reservation.
model QuestionGenerationCallLease {
  id      String @id
  jobId   String @map("job_id")
  ordinal Int

  requestedModel     String  @map("requested_model")
  endpointHash       String  @map("endpoint_hash")
  wireBodyHash       String  @map("wire_body_hash")
  reservedCostMicros BigInt  @map("reserved_cost_micros")
  observedCostMicros BigInt? @map("observed_cost_micros")

  state            String
  httpStatus       Int?    @map("http_status")
  shadowExceeded   Boolean @default(false) @map("shadow_exceeded")
  generationIdHash String? @map("generation_id_hash")
  servedModel      String? @map("served_model")
  networkErrorKind String? @map("network_error_kind")
  networkErrorName String? @map("network_error_name")
  networkErrorCode String? @map("network_error_code")
  admissionWarning String? @map("admission_warning")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt DateTime? @map("settled_at") @db.Timestamptz(3)

  budget QuestionGenerationCallBudget @relation(fields: [jobId], references: [jobId], onDelete: Restrict)

  @@unique([jobId, ordinal])
  @@index([jobId, state])
  @@index([createdAt])
  @@map("question_generation_call_leases")
}

/// SimilarExamGenerationJob — background jobs that analyze an uploaded
/// finished exam pattern and generate a new exam from selected passages.
/// status: "PENDING" | "PROCESSING" | "COMPLETED" | "FAILED" | "CANCELLED"
model SimilarExamGenerationJob {
  id          String @id @default(cuid())
  academyId   String
  createdById String

  status String @default("PENDING")
  stage  String @default("UPLOADING")
  title  String

  sourceType       String // "PDF" | "IMAGES"
  originalFileName String?
  totalPages       Int
  pageImageUrls    Json

  blueprint       Json?
  config          Json?
  result          Json?
  generatedExamId String?
  errorMessage    String? @db.Text
  triggerRunId    String? @db.Text
  creditTxId      String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([academyId, status])
  @@index([academyId, createdAt])
  @@index([generatedExamId])
  @@map("similar_exam_generation_jobs")
}

// 동형 문제 생성(단일 문항 → 자료풀 M×N) 백그라운드 작업.
// 트리거 데브를 쓰지 않고 앱(Node) 인-프로세스 워커가 처리한다(개발 서버 한정).
model SimilarQuestionGenerationJob {
  id          String @id @default(cuid())
  academyId   String
  createdById String

  status String @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED

  // 참조 문항(한 페이지 이미지) — base64. 워커가 분석에 사용. (검증용으로 분석 후에도 보존)
  referenceImage     String  @db.Text
  referenceMediaType String  @default("image/jpeg")
  // docai 모드에서 Document AI 가 추출해 분석(Gemini)에 넘긴 OCR 텍스트 — 검증용(분석이 본 입력).
  referenceOcrText   String? @db.Text
  // 선택 지문 풀(passageId[]) + 학년.
  passageIds         Json
  gradeInfo          String?

  referenceCount Int   @default(0) // M (분석 후 채움)
  passageCount   Int   @default(0) // N
  totalCount     Int   @default(0) // 시도 대상(M×N)
  savedCount     Int   @default(0)
  skippedCount   Int   @default(0)
  skipSummary    Json?

  errorMessage String? @db.Text

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([academyId, status])
  @@index([academyId, createdAt])
  @@map("similar_question_generation_jobs")
}

/// CustomQuestionType — 강사 커스텀 문항 유형(빌트인 22유형에 없는 변종).
/// 원본 문항을 분석해 "유형 정의(CompiledCustomType)"로 컴파일·저장 → 그 유형으로 지속 생성.
/// 기본 문제 생성 엔진/동형 코드는 import만 하고 수정하지 않는 별도 격리 기능(dev 한정).
model CustomQuestionType {
  id          String @id @default(cuid())
  academyId   String
  createdById String

  name   String
  status String @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED

  // 퀄리티 사다리 판정 메타 — 가장 가까운 빌트인 유형과 매칭 신뢰도.
  nearestBuiltin  String? // 빌트인 유형 ID (없으면 null = 순수 신규)
  matchConfidence String? // high | medium | low

  // 현재 활성 버전(CustomQuestionTypeVersion.id). 튜닝/편집으로 새 버전 발급(FK 미설정, 소프트 포인터).
  activeVersionId String?

  // 텔레메트리(피드백 루프) — 승인율 등 집계 기반. 지금은 카운터만.
  usageCount     Int @default(0) // 생성 잡 수
  generatedCount Int @default(0) // 저장된 문항 수
  approvedCount  Int @default(0) // 강사 승인 문항 수

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  versions CustomQuestionTypeVersion[]

  @@index([academyId, status])
  @@index([academyId, createdAt])
  @@map("custom_question_types")
}

/// CustomQuestionTypeVersion — 커스텀 유형의 버전(정의 스냅샷). 자동 튜닝/편집이 새 버전을 만들고,
/// 보류 평가 후 더 나을 때만 활성화하는 안전 래칫의 단위.
model CustomQuestionTypeVersion {
  id      String @id @default(cuid())
  typeId  String
  version Int

  spec     Json // CompiledCustomType (프롬프트/필드/재구성 프리미티브/validator/tier 등 동적 정의)
  examples Json? // few-shot 예시 누적(P3). 초기엔 원본 1개.
  source   Json // 이 버전의 토대가 된 원본 문항 분석(QuestionAnalysis)
  note     String? @db.Text // 이 버전을 만든 편집 지시(자연어). 자동 생성(v1)=null, 강사 편집/튜닝=요청문.

  createdAt DateTime @default(now())

  type CustomQuestionType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([typeId, version])
  @@index([typeId])
  @@map("custom_question_type_versions")
}

/// CustomQuestionGenerationJob — 커스텀 유형으로 문항을 생성하는 백그라운드 잡(인-프로세스 워커, dev 한정).
/// 입력 = 커스텀 유형 1개 + 선택 지문 N개 + 지문당 생성 개수. 동형 잡과 동형(同型) 구조의 별도 테이블.
model CustomQuestionGenerationJob {
  id           String @id @default(cuid())
  academyId    String
  createdById  String
  customTypeId String // 어떤 커스텀 유형으로 생성하는지

  status String @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED

  // 생성에 쓸 지문 풀(passageId[]) + 지문당 생성 개수 + 학년 + 난이도(생성 시 override).
  passageIds      Json
  countPerPassage Int     @default(1)
  gradeInfo       String?
  difficulty      String? // BASIC | INTERMEDIATE | KILLER. null = 유형 정의 난이도 사용.
  overrides       Json? // 생성 시 유형 정의 임시 override(선지/정답 수·답형·복수정답·지문기반). null = 정의 그대로.

  passageCount Int @default(0) // N
  totalCount   Int @default(0) // 시도 대상(N × countPerPassage)
  savedCount   Int @default(0)
  skippedCount Int @default(0)

  errorMessage String? @db.Text

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([academyId, status])
  @@index([academyId, createdAt])
  @@index([customTypeId])
  @@map("custom_question_generation_jobs")
}

/// CustomTypeAnalysisJob — '유형 만들기' 분석을 백그라운드로 처리하는 인-프로세스 잡(dev 한정).
/// 업로드 문항 → 분석 → 유형 정의 컴파일 → ACTIVE 커스텀 유형 자동 생성. 동형 잡과 동형(同型) 구조.
model CustomTypeAnalysisJob {
  id          String @id @default(cuid())
  academyId   String
  createdById String

  status String @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED

  referenceImage     String  @db.Text // 참조 문항(크롭본) base64
  referenceMediaType String  @default("image/jpeg")
  gradeInfo          String?
  manualCrop         Boolean @default(true)

  // 결과(완료 시) — 생성된 유형 + 검토/디버깅용.
  createdTypeId  String? // 자동 생성한 CustomQuestionType.id
  suggestedName  String?
  resultSpec     Json? // CompiledCustomType
  sourceAnalysis Json? // QuestionAnalysis
  analysisModel  String?

  errorMessage String? @db.Text

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([academyId, status])
  @@index([academyId, createdAt])
  @@map("custom_type_analysis_jobs")
}

// ============================================================================
// 10. EXAMS
// ============================================================================

/// Exam — Test papers (online CBT or offline)
/// type: "OFFLINE" | "ONLINE" | "VOCAB" | "MOCK"
/// status: "DRAFT" | "PUBLISHED" | "IN_PROGRESS" | "COMPLETED" | "ARCHIVED"
model Exam {
  id               String    @id @default(cuid())
  academyId        String
  schoolId         String? // Optional school association
  classId          String? // Optional class association
  title            String
  type             String // "OFFLINE" | "ONLINE" | "VOCAB" | "MOCK"
  status           String    @default("DRAFT") // "DRAFT" | "PUBLISHED" | "IN_PROGRESS" | "COMPLETED" | "ARCHIVED"
  grade            Int?
  semester         String? // "FIRST" | "SECOND"
  examType         String? // "MIDTERM" | "FINAL" | "QUIZ" | "MOCK"
  year             Int?
  examDate         DateTime?
  duration         Int? // Time limit in minutes (for online)
  totalPoints      Int       @default(100)
  shuffleQuestions Boolean   @default(false) // Anti-cheat for online
  shuffleOptions   Boolean   @default(false)
  showResults      Boolean   @default(true) // Show results immediately after submission
  settings         String?   @db.Text // JSON: additional exam settings

  /// 시험지 과목 — null=ENGLISH(기존 시험지 전부·영어 경로 무회귀), "KOREAN"=국어 라우트에서 저장.
  /// passages.subject / *_collections.subject 와 동일 규약. DB 반영은 surgical ALTER
  /// 관례를 따른다 (scripts/sql/ko-exam-set-subject.sql — migrate deploy / db push 금지):
  ///   ALTER TABLE exams ADD COLUMN IF NOT EXISTS subject text;
  subject String?

  // ── Activity counters (시험지 관리 카드에 노출) ──
  saveCount  Int @default(0) // 빌더에서 저장된 총 횟수 (최초 생성 포함)
  editCount  Int @default(0) // 기존 시험지를 다시 저장(수정)한 횟수 (생성 제외)
  printCount Int @default(0) // 출력 횟수 (PDF 인쇄 + HWPX/HWPX해설 + DOCX 내보내기)

  // ── 26-07-09 공유 QR 자기등록(OMR/종이 배포) — 시험지 1개당 공유 등록 토큰 1개.
  //    인쇄 시험지에 QR 인쇄 → 학생 스캔 → 이름 선택+코드 확인 → ExamSubmission 자기등록.
  //    개별 링크(assignStudentsToExam) 모델과 공존. DB 반영은 surgical ALTER
  //    (prisma/migrations-manual/20260709_exam_shared_enrollment.sql). ──
  enrollToken   String? @unique // 공유 등록 토큰(QR 인코딩) — share-token.ts 규격
  enrollEnabled Boolean @default(false)
  enrollMode    String? // "OMR" | "TABLET" — 자기등록 학생 기본 응시 모드

  // ── Extraction lineage ──
  sourceMaterialId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  academy         Academy              @relation(fields: [academyId], references: [id])
  school          School?              @relation(fields: [schoolId], references: [id])
  class           Class?               @relation(fields: [classId], references: [id])
  sourceMaterial  SourceMaterial?      @relation(fields: [sourceMaterialId], references: [id])
  questions       ExamQuestion[]
  submissions     ExamSubmission[]
  collectionItems ExamCollectionItem[]

  @@index([academyId])
  @@index([academyId, status])
  @@index([schoolId])
  @@index([sourceMaterialId])
  @@map("exams")
}

/// ExamQuestion — Links questions to exams with ordering and point values
model ExamQuestion {
  id         String @id @default(cuid())
  examId     String
  questionId String
  orderNum   Int
  points     Int    @default(1)

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, orderNum])
  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
  @@map("exam_questions")
}

/// ExamSubmission — Student exam submissions
/// status: "ASSIGNED" | "IN_PROGRESS" | "SUBMITTED" | "GRADED"
///
/// 26-07-09 시험지 배포·OMR 대개편: 할당(ASSIGNED)→응시→제출→채점 전 수명주기를 이 한 행이
/// 담당한다(시험당 학생 1행, 재응시=원장 reset). DB 반영은 surgical ALTER 관례
/// (prisma/migrations-manual/20260709_exam_deployment_omr.sql — migrate deploy / db push 금지).
model ExamSubmission {
  id          String    @id @default(cuid())
  examId      String
  studentId   String
  answers     String    @db.Text // JSON: { "questionId": "answer", ... } (레거시 exam-taking 경로 — 신규 경로는 responses 사용)
  score       Int? // Total score (null until graded)
  maxScore    Int?
  percent     Float?
  status      String    @default("IN_PROGRESS") // "ASSIGNED" | "IN_PROGRESS" | "SUBMITTED" | "GRADED"
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?
  gradedBy    String? // staffId who graded (for manual grading)

  // ── 배포·응시 링크(/t/[token]) ──
  accessToken   String? @unique // 학생 응시 링크 토큰 — share-token.ts 발급 규격
  accessEnabled Boolean @default(false)
  mode          String? // "TABLET"(웹 응시) | "OMR"(답안만 입력)

  // ── 결정론 채점(AI 0콜) ──
  responses     Json? // SubmissionResponse[] — src/lib/exam-scoring/types.ts 계약
  scoreSummary  Json? // exam-report ScoreSummary 동형(서버 결정론 계산 캐시)
  orderSnapshot Json? // [{questionId,orderNum,points}] 할당 시점 고정 — 빌더 재저장/셔플로부터 응시 순서 보호

  // ── 할당 메타 ──
  assignedAt DateTime?
  assignedBy String? // staff.id soft-ref (FK 미설정)

  // ── 리포트 브리지 ──
  examReportStudentId String? // ExamReportStudent.id soft-ref — 채점 완료 시 리포트 학생 upsert

  version Int @default(1) // 낙관적 락(CAS) — 자동저장↔제출↔강사입력 클로버 방지

  exam    Exam    @relation(fields: [examId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
  @@index([studentId])
  @@map("exam_submissions")
}

// ============================================================================
// 11. VOCABULARY
// ============================================================================

/// VocabularyList — Word lists for study and testing
model VocabularyList {
  id        String   @id @default(cuid())
  academyId String
  title     String
  grade     Int?
  semester  String? // "FIRST" | "SECOND"
  unit      String?
  schoolId  String? // Optional school-specific
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy     Academy           @relation(fields: [academyId], references: [id])
  items       VocabularyItem[]
  testResults VocabTestResult[]

  @@index([academyId])
  @@map("vocabulary_lists")
}

/// VocabularyItem — Individual vocabulary words
model VocabularyItem {
  id           String   @id @default(cuid())
  listId       String
  english      String
  korean       String
  partOfSpeech String?
  exampleEn    String?
  exampleKr    String?
  phonetic     String?
  synonyms     String? // Comma-separated
  antonyms     String? // Comma-separated
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  list         VocabularyList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  wrongAnswers WrongVocabAnswer[]

  @@index([listId])
  @@map("vocabulary_items")
}

/// VocabTestResult — Vocabulary test results
/// testType: "EN_TO_KR" | "KR_TO_EN" | "SPELLING"
model VocabTestResult {
  id        String   @id @default(cuid())
  studentId String
  listId    String
  testType  String // "EN_TO_KR" | "KR_TO_EN" | "SPELLING"
  score     Int
  total     Int
  percent   Float
  duration  Int? // seconds
  takenAt   DateTime @default(now())

  student Student        @relation(fields: [studentId], references: [id])
  list    VocabularyList @relation(fields: [listId], references: [id])

  @@index([studentId, takenAt])
  @@index([listId, takenAt])
  @@map("vocab_test_results")
}

/// WrongVocabAnswer — Tracks vocabulary mistakes
model WrongVocabAnswer {
  id           String   @id @default(cuid())
  studentId    String
  itemId       String
  testType     String // "EN_TO_KR" | "KR_TO_EN" | "SPELLING"
  givenAnswer  String
  count        Int      @default(1)
  lastMissedAt DateTime @default(now())

  student Student        @relation(fields: [studentId], references: [id])
  item    VocabularyItem @relation(fields: [itemId], references: [id])

  @@unique([studentId, itemId, testType])
  @@index([studentId])
  @@map("wrong_vocab_answers")
}

// ============================================================================
// 12. ANALYTICS & GAMIFICATION
// ============================================================================

/// StudentAnalytics — Comprehensive student performance data ("영어 인바디")
model StudentAnalytics {
  id             String   @id @default(cuid())
  studentId      String   @unique
  overallScore   Float    @default(0) // 0-100 composite score
  grammarScore   Float    @default(0) // 0-100
  vocabScore     Float    @default(0) // 0-100
  readingScore   Float    @default(0) // 0-100
  writingScore   Float    @default(0) // 0-100
  listeningScore Float    @default(0) // 0-100
  level          String   @default("D") // "S" | "A" | "B" | "C" | "D"
  // Detailed grammar breakdown (JSON)
  grammarDetail  String?  @db.Text // JSON: { "tense": 85, "passive": 60, "relative": 40, ... }
  // Detailed weak points
  weakPoints     String?  @db.Text // JSON: ["관계대명사 who/which 구분", ...]
  updatedAt      DateTime @updatedAt

  // ── 26-07-09 AI 추세변화 분석(프리미엄 1콜, EXAM_TREND_ANALYSIS 5cr) ──
  examTrendReport      Json? // 추세 내러티브 문서(합니다체) + 약점→강점 전환 추적
  examTrendGeneratedAt DateTime?
  examTrendStatus      String? // "GENERATING" | "GENERATED" | "FAILED" — CAS 게이트

  student Student @relation(fields: [studentId], references: [id])

  @@map("student_analytics")
}

/// WrongAnswerLog — Tracks wrong answers for pattern analysis
model WrongAnswerLog {
  id          String   @id @default(cuid())
  studentId   String
  questionId  String
  givenAnswer String
  category    String? // "GRAMMAR" | "VOCAB" | "READING" | "WRITING"
  subCategory String? // "TENSE" | "RELATIVE_PRONOUN" | "SYNONYM" etc.
  count       Int      @default(1)
  lastWrongAt DateTime @default(now())

  student  Student  @relation(fields: [studentId], references: [id])
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([studentId, questionId])
  @@index([studentId, category])
  @@index([questionId])
  @@map("wrong_answer_logs")
}

/// StudyProgress — Daily study tracking
model StudyProgress {
  id                String   @id @default(cuid())
  studentId         String
  date              DateTime
  vocabTests        Int      @default(0)
  vocabScore        Float    @default(0)
  questionsViewed   Int      @default(0)
  questionsAnswered Int      @default(0)
  aiQuestionsAsked  Int      @default(0)
  studyMinutes      Int      @default(0)
  xpEarned          Int      @default(0)

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
  @@index([studentId])
  @@map("study_progress")
}

/// Achievement — Available badges/achievements
/// category: "ATTENDANCE" | "VOCAB" | "GRAMMAR" | "GROWTH" | "ASSIGNMENT" | "STREAK"
model Achievement {
  id          String @id @default(cuid())
  academyId   String
  name        String
  description String
  icon        String // Emoji or icon identifier
  category    String // "ATTENDANCE" | "VOCAB" | "GRAMMAR" | "GROWTH" | "ASSIGNMENT" | "STREAK"
  condition   String @db.Text // JSON: { type: "STREAK", value: 7 } or { type: "SCORE", min: 90, count: 3 }
  xpReward    Int    @default(0)

  academy             Academy              @relation(fields: [academyId], references: [id])
  studentAchievements StudentAchievement[]

  @@index([academyId])
  @@map("achievements")
}

/// StudentAchievement — Earned badges
model StudentAchievement {
  id            String   @id @default(cuid())
  studentId     String
  achievementId String
  earnedAt      DateTime @default(now())

  student     Student     @relation(fields: [studentId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([studentId, achievementId])
  @@map("student_achievements")
}

// ============================================================================
// 13. AI CONVERSATIONS & PROMPTS
// ============================================================================

/// AIConversation — Student ↔ AI chat history per question
model AIConversation {
  id         String   @id @default(cuid())
  studentId  String
  questionId String
  messages   String   @db.Text // JSON: [{ role, content, timestamp }]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student  Student  @relation(fields: [studentId], references: [id])
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([studentId, questionId])
  @@index([studentId])
  @@index([questionId])
  @@map("ai_conversations")
}

/// TeacherPrompt — Custom AI instructions per school/passage
/// promptType: "GENERAL" | "GRAMMAR" | "VOCAB" | "EXAM_FOCUS" | "QUESTION_GENERATION"
model TeacherPrompt {
  id         String   @id @default(cuid())
  academyId  String
  staffId    String?
  passageId  String?
  name       String   @default("")
  content    String   @db.Text
  promptType String   @default("GENERAL")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  academy Academy  @relation(fields: [academyId], references: [id])
  passage Passage? @relation(fields: [passageId], references: [id])

  @@index([academyId])
  @@index([academyId, promptType])
  @@index([academyId, passageId])
  @@map("teacher_prompts")
}

// ============================================================================
// 14. PARENT REPORTS
// ============================================================================

/// ParentReport — Auto-generated reports sent to parents
/// type: "WEEKLY" | "MONTHLY" | "CUSTOM"
/// status: "DRAFT" | "SENT" | "VIEWED"
model ParentReport {
  id         String    @id @default(cuid())
  studentId  String
  parentId   String?
  type       String // "WEEKLY" | "MONTHLY" | "CUSTOM"
  reportData String    @db.Text // JSON: scores, attendance, analysis, teacher comment
  status     String    @default("DRAFT") // "DRAFT" | "SENT" | "VIEWED"
  sentAt     DateTime?
  viewedAt   DateTime?
  createdAt  DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id])
  parent  Parent? @relation(fields: [parentId], references: [id])

  @@index([studentId])
  @@index([parentId])
  @@map("parent_reports")
}

// ============================================================================
// 15. TEXTBOOK / CURRICULUM
// ============================================================================

/// Textbook — Publisher textbook references
model Textbook {
  id        String  @id @default(cuid())
  academyId String
  publisher String // "능률" | "비상" | "YBM" | "천재" | "지학사"
  title     String
  grade     Int?
  year      Int?
  chapters  String? @db.Text // JSON: [{ unit: 1, title: "..." }]

  academy Academy @relation(fields: [academyId], references: [id])

  @@index([academyId])
  @@map("textbooks")
}

// ============================================================================
// QUESTION COLLECTIONS (YouTube-playlist-style grouping)
// ============================================================================

model QuestionCollection {
  id          String   @id @default(cuid())
  academyId   String
  parentId    String? // Self-reference for nested folders (null = root)
  name        String
  description String?  @db.Text
  color       String? // Hex color for visual distinction
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// 폴더 과목 — null=ENGLISH(기존 폴더 전부·영어 경로 무회귀), "KOREAN"=국어.
  /// passages.subject 와 동일 규약. DB 반영은 surgical ALTER 관례
  /// (scripts/sql/ko-collections-subject.sql — migrate deploy / db push 금지):
  ///   ALTER TABLE question_collections ADD COLUMN IF NOT EXISTS subject TEXT;
  subject String?

  academy  Academy                  @relation(fields: [academyId], references: [id])
  parent   QuestionCollection?      @relation("QuestionFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children QuestionCollection[]     @relation("QuestionFolderTree")
  items    QuestionCollectionItem[]

  @@index([academyId])
  @@index([parentId])
  @@map("question_collections")
}

model QuestionCollectionItem {
  id           String @id @default(cuid())
  collectionId String
  questionId   String
  orderNum     Int    @default(0)

  collection QuestionCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  question   Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, questionId])
  @@index([collectionId])
  @@index([questionId])
  @@map("question_collection_items")
}

// ============================================================================
// 16. DUOLINGO-STYLE LEARNING SERVICE
// ============================================================================

/// StudySeason — 학습 시즌 (내신 집중 기간 or 평상시)
/// type: "EXAM_PREP" | "REGULAR"
model StudySeason {
  id          String   @id @default(cuid())
  academyId   String
  name        String // "1학기 중간고사 대비" etc.
  type        String // "EXAM_PREP" | "REGULAR"
  grade       Int? // 대상 학년
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdById String? // staffId (강사)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academy        Academy          @relation(fields: [academyId], references: [id])
  passages       SeasonPassage[]
  sessionRecords SessionRecord[]
  lessonProgress LessonProgress[]

  @@index([academyId])
  @@index([academyId, isActive])
  @@map("study_seasons")
}

/// SeasonPassage — 시즌에 배정된 지문 (순서 포함)
model SeasonPassage {
  id        String @id @default(cuid())
  seasonId  String
  passageId String
  order     Int    @default(0)

  season  StudySeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  passage Passage     @relation(fields: [passageId], references: [id])

  @@unique([seasonId, passageId])
  @@index([seasonId])
  @@map("season_passages")
}

/// LessonProgress — 학생의 레슨(지문)별 진행도
model LessonProgress {
  id        String  @id @default(cuid())
  studentId String
  passageId String
  seasonId  String?

  session1Done Boolean @default(false) // 필수: 종합 믹스 1
  session2Done Boolean @default(false) // 필수: 종합 믹스 2
  storiesDone  Boolean @default(false) // 필수: Stories 통독
  session3Done Boolean @default(false) // 선택: 어휘 집중
  session4Done Boolean @default(false) // 선택: 문법 집중
  session5Done Boolean @default(false) // 선택: 약점 집중

  vocabDone       Int     @default(0)
  interpDone      Int     @default(0)
  grammarDone     Int     @default(0)
  compDone        Int     @default(0)
  masteryPassed   Boolean @default(false)
  masteryAttempts Int     @default(0)

  masteryScore Float    @default(0) // 숙달도 0-100
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student      @relation(fields: [studentId], references: [id])
  passage Passage      @relation(fields: [passageId], references: [id])
  season  StudySeason? @relation(fields: [seasonId], references: [id])

  @@unique([studentId, passageId, seasonId])
  @@index([studentId])
  @@map("lesson_progress")
}

/// SessionRecord — 세션 완료 기록
/// sessionType: "MIX_1" | "MIX_2" | "STORIES" | "VOCAB_FOCUS" | "GRAMMAR_FOCUS" | "WEAKNESS_FOCUS"
model SessionRecord {
  id               String   @id @default(cuid())
  studentId        String
  passageId        String
  seasonId         String?
  sessionType      String // "MIX_1" | "MIX_2" | "STORIES" | "VOCAB_FOCUS" | "GRAMMAR_FOCUS" | "WEAKNESS_FOCUS"
  sessionSeq       Int      @default(1)
  score            Float // 정답률 0-100
  correctCount     Int
  totalCount       Int
  wrongQuestionIds String?  @db.Text // JSON: ["questionId1", ...]
  xpEarned         Int      @default(0)
  isMasteryFail    Boolean  @default(false)
  vocabCorrect     Int      @default(0)
  vocabTotal       Int      @default(0)
  grammarCorrect   Int      @default(0)
  grammarTotal     Int      @default(0)
  interpretCorrect Int      @default(0)
  interpretTotal   Int      @default(0)
  compCorrect      Int      @default(0)
  compTotal        Int      @default(0)
  startedAt        DateTime @default(now())
  completedAt      DateTime @default(now())

  student Student      @relation(fields: [studentId], references: [id])
  passage Passage      @relation(fields: [passageId], references: [id])
  season  StudySeason? @relation(fields: [seasonId], references: [id])

  @@index([studentId])
  @@index([studentId, completedAt]) // 주간 XP 랭킹 계산용
  @@index([passageId])
  @@map("session_records")
}

/// StudentDailyMission — 데일리 미션 추적
model StudentDailyMission {
  id                  String    @id @default(cuid())
  studentId           String
  date                DateTime // 날짜 (시간 제외)
  easyCompleted       Boolean   @default(false)
  hardCompleted       Boolean   @default(false)
  multiplierActive    Float? // 1.2 or 2.0
  multiplierExpiresAt DateTime?
  createdAt           DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
  @@index([studentId])
  @@map("student_daily_missions")
}

// ============================================================================
// 17. 수능링고 — 글로벌 학습 시스템 (academyId 없음)
// ============================================================================

/// SuneungPassage — 수능/모의고사 공용 지문 (플랫폼 전체 공유)
model SuneungPassage {
  id         String   @id @default(cuid())
  title      String
  content    String   @db.Text
  source     String? // "2025 수능", "2024 9월 모의고사" 등
  grade      Int // 7~12
  year       Int? // 출제 연도
  examType   String? // "SUNEUNG" | "MOCK_6" | "MOCK_9" | "EBS" | "OTHER"
  difficulty String? // "BEGINNER" ~ "EXPERT"
  tags       String?  @db.Text
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  analysis  SuneungPassageAnalysis?
  questions SuneungQuestion[]

  @@index([grade])
  @@map("suneung_passages")
}

/// SuneungPassageAnalysis — 수능 지문 AI 분석 캐시
model SuneungPassageAnalysis {
  id           String   @id @default(cuid())
  passageId    String   @unique
  analysisData String   @db.Text // JSON: 5레이어 분석 구조
  contentHash  String
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passage SuneungPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@map("suneung_passage_analyses")
}

// ============================================================================
// 18. 내신링고 — 학원별 학습 문제 시스템
// ============================================================================

/// LearningSet — 학습 문제 세트 (출판사/교재/단원 기준 그룹핑)
model LearningSet {
  id            String   @id @default(cuid())
  academyId     String
  passageId     String // 원본 지문 참조 (분석 데이터 활용)
  publisher     String // 출판사 (능률(양), 비상(홍) 등)
  textbook      String? // 교재명
  grade         Int? // 학년
  unit          String? // 단원/과
  title         String // 세트 제목
  questionCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  academy   Academy           @relation(fields: [academyId], references: [id])
  passage   Passage           @relation(fields: [passageId], references: [id])
  questions NaeshinQuestion[]

  @@index([academyId])
  @@index([academyId, publisher])
  @@map("learning_sets")
}

/// NaeshinQuestion — 내신링고 학습 전용 문제
model NaeshinQuestion {
  id               String   @id @default(cuid())
  academyId        String
  passageId        String
  learningSetId    String? // 학습 세트 소속
  learningCategory String // "VOCAB" | "INTERPRETATION" | "GRAMMAR" | "COMPREHENSION"
  type             String // interaction type
  subType          String? // 23종 subType
  questionText     String   @db.Text
  options          String?  @db.Text // JSON: [{ label, text }]
  correctAnswer    String   @db.Text
  sentenceIndex    Int?
  difficulty       String   @default("INTERMEDIATE")
  tags             String?  @db.Text // JSON array
  aiGenerated      Boolean  @default(true)
  approved         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academy     Academy                     @relation(fields: [academyId], references: [id])
  passage     Passage                     @relation(fields: [passageId], references: [id])
  learningSet LearningSet?                @relation(fields: [learningSetId], references: [id])
  school      School?                     @relation(fields: [schoolId], references: [id])
  schoolId    String?
  explanation NaeshinQuestionExplanation?
  wrongLogs   NaeshinWrongAnswerLog[]

  @@index([passageId, learningCategory])
  @@index([academyId])
  @@index([learningSetId])
  @@map("naeshin_questions")
}

/// PrebuiltSession — cached question ids for each learning session.
model PrebuiltSession {
  id            String   @id @default(cuid())
  passageId     String
  category      String
  sessionSeq    Int
  questionIds   String   @db.Text
  questionCount Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  passage Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@unique([passageId, category, sessionSeq])
  @@index([passageId])
  @@map("prebuilt_sessions")
}

/// ClassMaterial — uploaded teaching materials for classes or the whole academy.
model ClassMaterial {
  id          String   @id @default(cuid())
  academyId   String
  classId     String?
  title       String
  description String?  @db.Text
  fileUrl     String   @db.Text
  fileName    String
  fileType    String
  fileSize    Int
  uploadedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academy  Academy @relation(fields: [academyId], references: [id])
  class    Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  uploader Staff   @relation("ClassMaterialUploader", fields: [uploadedBy], references: [id])

  @@index([academyId])
  @@index([classId])
  @@index([uploadedBy])
  @@map("class_materials")
}

/// NaeshinQuestionExplanation — 내신 학습 문제 해설
model NaeshinQuestionExplanation {
  id                      String   @id @default(cuid())
  questionId              String   @unique
  content                 String   @db.Text
  keyPoints               String?  @db.Text
  wrongOptionExplanations String?  @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  question NaeshinQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("naeshin_question_explanations")
}

/// NaeshinWrongAnswerLog — 내신링고 오답 기록
model NaeshinWrongAnswerLog {
  id          String   @id @default(cuid())
  studentId   String
  questionId  String
  givenAnswer String
  category    String?
  subCategory String?
  count       Int      @default(1)
  lastWrongAt DateTime @default(now())

  student  Student         @relation(fields: [studentId], references: [id])
  question NaeshinQuestion @relation(fields: [questionId], references: [id])

  @@unique([studentId, questionId])
  @@index([studentId, category])
  @@map("naeshin_wrong_answer_logs")
}


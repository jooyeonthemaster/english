  academy Academy?         @relation(fields: [academyId], references: [id], onDelete: Cascade)
  pricing ProviderPricing? @relation(fields: [pricingId], references: [id], onDelete: SetNull)

  @@index([usageAt])
  @@index([academyId, usageAt])
  @@index([provider, unitType, usageAt])
  @@index([sourceType, sourceId])
  @@index([pricingSource, usageAt])
  @@map("platform_api_usage_costs")
}

model DailyFxRate {

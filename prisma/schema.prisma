// ============================================================================
// 20. PLATFORM ADMINISTRATION
// ============================================================================

/// SuperAdmin — Platform-level administrator (developer/operator)
/// role: "SUPER_ADMIN" | "SUPPORT"
model SuperAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("SUPER_ADMIN") // "SUPER_ADMIN" | "SUPPORT"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewedRegistrations AcademyRegistration[] @relation("ReviewedBy")
  creditAdjustments     CreditTransaction[]   @relation("AdjustedBy")
  auditLogs             AdminAuditLog[]       @relation("AuditedBy")

  @@map("super_admins")
}

/// AdminAuditLog — Append-only audit trail for non-credit admin actions
/// (member toggle, plan change, etc.). Credit changes are already captured
/// in CreditTransaction with adminId. This table covers everything else.
/// targetType: "MEMBER" | "ACADEMY" | "SUBSCRIPTION" | ...
/// action: "TOGGLE_ACTIVE" | "CHANGE_PLAN" | ...
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  action     String
  reason     String?  @db.Text
  beforeJson String?  @map("before_json") @db.Text // JSON snapshot
  afterJson  String?  @map("after_json") @db.Text // JSON snapshot
  metadata   String?  @db.Text // JSON: extra context
  createdAt  DateTime @default(now()) @map("created_at")

  admin SuperAdmin @relation("AuditedBy", fields: [adminId], references: [id])

  @@index([targetType, targetId, createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

/// SiteBanner — 최고 관리자가 관리하는, 로그인 사용자에게 뜨는 진입 배너.
/// 템플릿(내용 편집형) 또는 이미지 배너. 여러 개를 우선순위로 큐잉해서
/// 하나를 닫으면 다음이 열린다.
/// type: "TEMPLATE" | "IMAGE"
/// dismissMode: "DAILY"(오늘 하루 보지 않기) | "SESSION" | "ONCE"(다시 안 봄) | "ALWAYS"(매번)
/// audiences: "DIRECTOR,TEACHER,STUDENT" 중 콤마 조인(앱에서 뷰어 역할로 필터).
model SiteBanner {
  id                  String    @id @default(cuid())
  title               String // 운영자용 내부 라벨
  type                String    @default("TEMPLATE") // "TEMPLATE" | "IMAGE"
  templateKey         String?   @map("template_key") // type=TEMPLATE 일 때 템플릿 종류
  content             Json      @default("{}") // 템플릿 필드 값(JSON)
  imageUrl            String?   @map("image_url") @db.Text // type=IMAGE 공개 URL
  imageAlt            String?   @map("image_alt")
  linkUrl             String?   @map("link_url") @db.Text // 클릭 시 이동 대상(이미지/선택)
  audiences           String    @default("DIRECTOR") // 콤마 조인 역할 목록
  priority            Int       @default(0) // 낮을수록 먼저 노출
  isActive            Boolean   @default(false) @map("is_active")
  dismissMode         String    @default("DAILY") @map("dismiss_mode")
  showDismissButton   Boolean   @default(true) @map("show_dismiss_button")
  // 노출 범위: "ALL"(대상 역할 전체) | "SPECIFIC"(target_academy_ids 학원만)
  targetMode          String    @default("ALL") @map("target_mode")
  targetAcademyIds    Json      @default("[]") @map("target_academy_ids") // string[] academyId
  startsAt            DateTime? @map("starts_at")
  endsAt              DateTime? @map("ends_at")
  autoOpenOnLowCredit Boolean   @default(false) @map("auto_open_on_low_credit")
  createdByAdminId    String?   @map("created_by_admin_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([isActive, priority])
  @@map("site_banners")
}

/// OfflineMarketingCampaign — 오프라인 홍보(캠페인) 단위. 전단지·세미나 등 홍보 하나를
/// 나타내며 그 아래 여러 PDF 파일(OfflineMarketingAsset)을 담는다. 관리자는 홍보별로
/// 파일을 모아 관리하고, 관리자 페이지에서 파일별로 바로 인쇄한다.
/// category: 자유 분류 라벨(전단지/세미나/학습지 샘플/포스터/기타 등).
model OfflineMarketingCampaign {
  id               String                  @id @default(cuid())
  title            String // 홍보 이름(운영자 표시)
  description      String?                 @db.Text // 설명/메모(선택)
  category         String                  @default("기타") // 분류 라벨
  sortOrder        Int                     @default(0) @map("sort_order") // 낮을수록 먼저
  isActive         Boolean                 @default(true) @map("is_active")
  createdByAdminId String?                 @map("created_by_admin_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  assets           OfflineMarketingAsset[]

  @@index([isActive, sortOrder])
  @@map("offline_marketing_campaigns")
}

/// OfflineMarketingAsset — 홍보(캠페인)에 속한 개별 PDF·이미지 파일. 파일은 공개 Supabase
/// 버킷(offline-marketing)에 저장하고 공개 URL을 보관한다.
model OfflineMarketingAsset {
  id               String                   @id @default(cuid())
  campaignId       String                   @map("campaign_id")
  campaign         OfflineMarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title            String // 파일 표시 이름
  description      String?                  @db.Text // 파일 메모(선택)
  fileUrl          String                   @map("file_url") @db.Text // 공개 파일 URL
  storagePath      String                   @map("storage_path") // 버킷 내 경로(삭제용)
  fileName         String                   @map("file_name") // 원본 파일명
  fileSize         Int                      @default(0) @map("file_size") // 바이트
  pageCount        Int?                     @map("page_count") // 페이지 수(선택)
  sortOrder        Int                      @default(0) @map("sort_order") // 홍보 내 순서
  createdByAdminId String?                  @map("created_by_admin_id")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@index([campaignId, sortOrder])
  @@map("offline_marketing_assets")
}

/// PlatformSetting — 전역 운영 설정 key-value 저장소(예: 기본 가입 크레딧).
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

/// PlatformAnnouncement — 스모트 운영진 → 전체 이용자 플랫폼 공지("스모트 소식").
/// 기존 학원 내부 Notice 를 대체한다. 원장/강사/학생/학부모가 각 앱에서 읽고,
/// 읽음 추적은 공지별 레코드 대신 프로필(Staff/Student/Parent)의
/// lastAnnouncementReadAt 타임스탬프 1개로 한다.
/// category: "UPDATE"(업데이트) | "MAINTENANCE"(점검) | "EVENT"(이벤트) | "GENERAL"(일반)
/// status: "DRAFT"(초안) | "PUBLISHED"(발행) | "ARCHIVED"(보관)
/// audiences: "ALL" 또는 "DIRECTOR,TEACHER,STUDENT,PARENT" 콤마 조인(SiteBanner 규약).
/// sourceType: "MANUAL"(직접 작성) | "RELEASE"(배포 시 release-notes 에서 자동 발행)
/// releaseSlug: 자동 발행 멱등성 키(파일 slug). 같은 slug 는 두 번 발행되지 않는다.
model PlatformAnnouncement {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text // 마크다운 본문
  category    String    @default("GENERAL")
  status      String    @default("DRAFT")
  publishedAt DateTime? @map("published_at") // 소급 게시용 과거 날짜 허용
  isPinned    Boolean   @default(false) @map("is_pinned")
  audiences   String    @default("ALL")
  sourceType  String    @default("MANUAL") @map("source_type")
  releaseSlug String?   @unique @map("release_slug")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, isPinned, publishedAt])
  @@map("platform_announcements")
}

// ============================================================================
// 21. SUBSCRIPTION & BILLING
// ============================================================================

/// SubscriptionPlan — Catalog of available plans
/// tier: "STARTER" | "STANDARD" | "PREMIUM" | "ENTERPRISE"
/// rolloverPolicy: "RESET" | "ROLLOVER" | "PARTIAL_ROLLOVER"
model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String // "스타터", "스탠다드", "프리미엄", "엔터프라이즈"
  tier            String   @unique // "STARTER" | "STANDARD" | "PREMIUM" | "ENTERPRISE"
  monthlyPrice    Int // KRW (matches credit top-up catalog defaults)
  monthlyCredits  Int // monthly credits (matches credit top-up catalog defaults)
  maxStudents     Int // 50, 150, 500, 99999
  maxStaff        Int // 3, 8, 20, 99999
  features        String   @db.Text // JSON: feature flags object
  rolloverPolicy  String   @default("RESET") // "RESET" | "ROLLOVER" | "PARTIAL_ROLLOVER"
  rolloverMaxRate Float    @default(0) // For PARTIAL_ROLLOVER: 0.2 = carry over up to 20%
  description     String?  @db.Text
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions AcademySubscription[]

  @@map("subscription_plans")
}

/// AcademySubscription — Active subscription per academy
/// status: "TRIAL" | "ACTIVE" | "PAST_DUE" | "CANCELLED" | "SUSPENDED"
model AcademySubscription {
  id                    String    @id @default(cuid())
  academyId             String
  planId                String
  billingKeyId          String?
  status                String    @default("TRIAL") // "TRIAL" | "ACTIVE" | "PAST_DUE" | "CANCELLED" | "SUSPENDED"
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  trialEndsAt           DateTime?
  cancelledAt           DateTime?
  graceEndsAt           DateTime? // Read-only access after expiry, before suspension
  paymentMethod         String? // "CARD" | "TRANSFER" | "KAKAO_PAY"
  paymentReference      String? // External payment system reference
  autoRenew             Boolean   @default(false)
  nextBillingPaymentId  String?
  nextBillingScheduleId String?
  nextBillingAt         DateTime?
  billingActivatedAt    DateTime?
  billingFailureMessage String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  academy              Academy               @relation(fields: [academyId], references: [id])
  plan                 SubscriptionPlan      @relation(fields: [planId], references: [id])
  billingKey           PortOneBillingKey?    @relation(fields: [billingKeyId], references: [id], onDelete: SetNull)
  subscriptionPayments SubscriptionPayment[]

  @@index([academyId])
  @@index([billingKeyId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([autoRenew, nextBillingAt])
  @@map("academy_subscriptions")
}

/// PortOneBillingKey — Card billing keys issued for subscription renewals
/// status: "ISSUED" | "DELETED" | "FAILED"
model PortOneBillingKey {
  id             String    @id @default(cuid())
  academyId      String
  billingKey     String    @unique
  issueId        String?   @unique
  issueName      String?
  status         String    @default("ISSUED")
  storeId        String
  channelKey     String?
  method         String    @default("CARD")
  customerId     String?
  issuedById     String?
  billingKeyInfo Json?
  customData     Json?
  issuedAt       DateTime?
  deletedAt      DateTime?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  academy              Academy               @relation(fields: [academyId], references: [id])
  subscriptions        AcademySubscription[]
  subscriptionPayments SubscriptionPayment[]
  webhookEvents        PortOneWebhookEvent[]

  @@index([academyId])
  @@index([status])
  @@index([customerId])
  @@map("portone_billing_keys")
}

/// SubscriptionPayment — 30-day subscription charges created from a billing key
/// status: "PENDING" | "SCHEDULED" | "PAID" | "FAILED" | "CANCELLED" | "REFUNDED"
model SubscriptionPayment {
  id                   String    @id @default(cuid())
  academyId            String
  subscriptionId       String
  billingKeyId         String?
  paymentId            String    @unique
  scheduleId           String?   @unique
  orderName            String
  amount               Int
  currency             String    @default("KRW")
  status               String    @default("PENDING")
  portoneStatus        String?
  portoneTransactionId String?
  paidAmount           Int?
  receiptUrl           String?
  failureCode          String?
  failureMessage       String?   @db.Text
  customData           Json?
  paymentPayload       Json?
  scheduledAt          DateTime?
  paidAt               DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  periodStart          DateTime
  periodEnd            DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  academy       Academy               @relation(fields: [academyId], references: [id])
  subscription  AcademySubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  billingKey    PortOneBillingKey?    @relation(fields: [billingKeyId], references: [id], onDelete: SetNull)
  webhookEvents PortOneWebhookEvent[]

  @@index([academyId])
  @@index([subscriptionId, createdAt])
  @@index([billingKeyId])
  @@index([status])
  @@index([status, paidAt])
  @@index([scheduledAt])
  @@index([periodEnd])
  @@map("subscription_payments")
}

// ============================================================================
// 22. CREDIT SYSTEM
// ============================================================================

/// CreditBalance — Current credit state per academy (one row per academy)
model CreditBalance {
  id                 String    @id @default(cuid())
  academyId          String    @unique
  balance            Int       @default(0) // Current available credits
  monthlyAllocation  Int       @default(0) // Credits from subscription plan
  bonusCredits       Int       @default(0) // Remaining top-up credits
  totalConsumed      Int       @default(0) // Lifetime consumption
  totalAllocated     Int       @default(0) // Lifetime allocation
  lowCreditThreshold Int       @default(50) // Warning threshold
  lastResetAt        DateTime?
  // Single expiry timestamp shared by the whole balance. Each purchase / admin
  // grant with an expiry extends it by (remaining + granted days); promo/event
  // grants ride the existing value unchanged. null = no expiry (무기한).
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  academy Academy @relation(fields: [academyId], references: [id])

  @@map("credit_balances")
}

/// CreditTransaction — Immutable audit log of every credit movement
/// type: "ALLOCATION" | "CONSUMPTION" | "TOP_UP" | "ADJUSTMENT" | "REFUND" | "RESET" | "ROLLOVER"
model CreditTransaction {
  id            String   @id @default(cuid())
  academyId     String
  type          String // "ALLOCATION" | "CONSUMPTION" | "TOP_UP" | "ADJUSTMENT" | "REFUND" | "RESET" | "ROLLOVER"
  amount        Int // Positive = add, Negative = consume
  balanceAfter  Int // Snapshot of balance after this transaction
  operationType String? // "QUESTION_GEN_SINGLE" | "PASSAGE_ANALYSIS" | etc
  description   String?
  referenceId   String? // Related entity ID (questionId, passageId, etc.)
  referenceType String? // "QUESTION" | "PASSAGE" | "EXAM" | "CREDIT_TRANSACTION"
  staffId       String? // Staff member who triggered the operation
  adminId       String? // SuperAdmin who made manual adjustment
  metadata      String?  @db.Text // JSON: { model, inputTokens, outputTokens, costUsd, durationMs, promptHash }
  createdAt     DateTime @default(now())

  academy     Academy      @relation(fields: [academyId], references: [id])
  admin       SuperAdmin?  @relation("AdjustedBy", fields: [adminId], references: [id])
  creditTopUp CreditTopUp?

  @@index([academyId, createdAt])
  @@index([academyId, type])
  @@index([academyId, operationType])
  @@index([referenceId, referenceType])
  @@index([staffId])
  @@index([createdAt])
  @@map("credit_transactions")
}

/// CreditTopUp — Additional credit purchase records
/// status: "PENDING" | "WAITING_FOR_DEPOSIT" | "COMPLETED" | "FAILED" | "CANCELLED" | "REFUNDED"
model CreditTopUpProduct {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  creditAmount Int      @unique
  basePrice    Int
  description  String?  @db.Text
  // Credit validity in days from grant. On purchase the buyer's balance expiry
  // is extended by (remaining days + expiryDays). null/0 = no expiry (무기한).
  expiryDays   Int?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A product can run MANY promotions at once (different audience/link/window).
  // The old single-promotion columns (discountRate/bonusRate/promotion*) were
  // migrated into CreditPromotion rows and are no longer mapped here.
  promotions CreditPromotion[]

  @@index([isActive, sortOrder])
  @@map("credit_top_up_products")
}

/// CreditPromotion — one promotion on a product. Multiple may run concurrently
/// with different audience/link/window. Effective one is resolved per viewer by
/// precedence (link match → priority → best buyer value → soonest end).
model CreditPromotion {
  id            String   @id @default(cuid())
  productId     String
  name          String?
  // 할인: PERCENT면 value=할인율%(0-99), AMOUNT면 value=할인 금액(원).
  discountType  String   @default("PERCENT")
  discountValue Int      @default(0)
  // 크레딧 추가지급: PERCENT면 value=추가 지급률%(예 50=총150%), AMOUNT면 value=추가 크레딧 수.
  bonusType     String   @default("PERCENT")
  bonusValue    Int      @default(0)
  startsAt      DateTime
  endsAt        DateTime
  // "ALL" = everyone, "TARGETED" = only targets OR anyone with the link.
  audience      String   @default("ALL")
  // Shareable link token (/credits/promo/{token}) — one per promotion.
  linkToken     String?  @unique
  // Higher wins when several eligible promotions overlap for the same viewer.
  priority      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product     CreditTopUpProduct          @relation(fields: [productId], references: [id], onDelete: Cascade)
  targets     CreditPromotionTarget[]
  bundleItems CreditPromotionBundleItem[]

  @@index([productId])
  @@index([linkToken])
  @@map("credit_promotions")
}

/// CreditPromotionBundle — several promotions exposed through ONE shareable
/// link (/credits/promo/b/{slug}) and landing page. Claiming the bundle seeds
/// every member promotion's linkToken into the promo cookie, so the existing
/// per-viewer pricing engine applies each one to its own product unchanged.
model CreditPromotionBundle {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?  @db.Text
  isActive         Boolean  @default(true)
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items CreditPromotionBundleItem[]

  @@map("credit_promotion_bundles")
}

/// CreditPromotionBundleItem — ordered membership of a promotion in a bundle.
/// Members must carry a linkToken (auto-issued on save) since the cookie and
/// pricing engine key off linkToken.
model CreditPromotionBundleItem {
  id          String @id @default(cuid())
  bundleId    String
  promotionId String
  sortOrder   Int    @default(0)

  bundle    CreditPromotionBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  promotion CreditPromotion       @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([bundleId, promotionId])
  @@index([promotionId])
  @@map("credit_promotion_bundle_items")
}

/// CreditPromotionTarget — academies explicitly targeted by a promotion (only
/// when audience = "TARGETED"). academyId is a plain indexed string (no FK) to
/// avoid coupling the large Academy model; targeting is equality on academyId.
model CreditPromotionTarget {
  id          String   @id @default(cuid())
  promotionId String
  academyId   String
  createdAt   DateTime @default(now())

  promotion CreditPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, academyId])
  @@index([academyId])
  @@map("credit_promotion_targets")
}

/// CreditPromotionLinkEvent — 프로모션/번들 공유 링크에 대한 사용자 활동 로그.
/// "VIEW"=랜딩(/credits/promo/...) 방문, "CLAIM"="혜택 받기" 버튼 클릭.
/// 로그인한 원장이면 staffId/academyId 를 스냅샷하고, 비로그인(익명)이면 그
/// 값이 null 이며 visitorKey(IP+UA 해시)로만 순 방문자를 근사한다. 링크가
/// 재발급돼도 집계가 끊기지 않도록 token 이 아니라 promotionId/bundleId 로 묶는다.
model CreditPromotionLinkEvent {
  id          String   @id @default(cuid())
  kind        String   @default("VIEW") // "VIEW" | "CLAIM"
  targetType  String   @default("PROMO") // "PROMO" | "BUNDLE"
  promotionId String? // targetType=PROMO 일 때
  bundleId    String? // targetType=BUNDLE 일 때
  linkRef     String // 클릭된 식별자: 프로모션=linkToken, 번들=slug (감사용 원본)
  staffId     String? // 로그인한 원장 (익명이면 null)
  academyId   String?
  academyName String? // 표시용 스냅샷
  visitorName String? // staff 이름 스냅샷
  visitorKey  String? // 순 방문자 근사(로그인=staff:{id}, 익명=ip+ua+날짜 해시)
  createdAt   DateTime @default(now())

  @@index([promotionId])
  @@index([bundleId])
  @@index([academyId])
  @@index([staffId])
  @@index([createdAt])
  @@map("credit_promotion_link_events")
}

model CreditTopUp {
  id                   String    @id @default(cuid())
  academyId            String
  creditAmount         Int // Credits purchased
  price                Int // KRW paid
  paymentMethod        String? // "CARD" | "TRANSFER" | "VIRTUAL_ACCOUNT" | "EASY_PAY" | "MOBILE"
  paymentReference     String? // External transaction ID
  paymentId            String?   @unique // PortOne paymentId generated by us
  orderName            String?
  storeId              String?
  channelKey           String?
  currency             String    @default("KRW")
  portoneStatus        String?
  portoneTransactionId String?
  paidAmount           Int?
  receiptUrl           String?
  failureCode          String?
  failureMessage       String?   @db.Text
  customData           Json?
  paymentPayload       Json?
  status               String    @default("PENDING") // "PENDING" | "WAITING_FOR_DEPOSIT" | "COMPLETED" | "FAILED" | "CANCELLED" | "REFUNDED"
  completedAt          DateTime?
  verifiedAt           DateTime?
  paidAt               DateTime?
  cancelledAt          DateTime?
  requestedBy          String? // staffId
  creditTransactionId  String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  academy           Academy                   @relation(fields: [academyId], references: [id])
  creditTransaction CreditTransaction?        @relation(fields: [creditTransactionId], references: [id])
  webhookEvents     PortOneWebhookEvent[]
  bankDeposits      BankDepositNotification[]

  @@index([academyId])
  @@index([academyId, status, createdAt])
  @@index([status])
  @@index([status, completedAt])
  @@index([portoneStatus])
  @@map("credit_top_ups")
}

/// PortOneWebhookEvent — idempotent audit log for PortOne V2 webhooks
/// status: "RECEIVED" | "PROCESSED" | "IGNORED" | "FAILED"
model PortOneWebhookEvent {
  id                    String    @id @default(cuid())
  webhookId             String    @unique
  paymentId             String?
  billingKey            String?
  topUpId               String?
  billingKeyId          String?
  subscriptionPaymentId String?
  eventType             String
  status                String    @default("RECEIVED")
  headers               Json?
  payload               Json?
  errorMessage          String?   @db.Text
  receivedAt            DateTime  @default(now())
  processedAt           DateTime?

  topUp               CreditTopUp?         @relation(fields: [topUpId], references: [id], onDelete: SetNull)
  billingKeyRecord    PortOneBillingKey?   @relation(fields: [billingKeyId], references: [id], onDelete: SetNull)
  subscriptionPayment SubscriptionPayment? @relation(fields: [subscriptionPaymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([billingKey])
  @@index([topUpId])
  @@index([billingKeyId])
  @@index([subscriptionPaymentId])
  @@index([status, receivedAt])
  @@map("portone_webhook_events")
}

/// BankDepositNotification — inbound bank deposit alerts (무통장입금 자동확인)
/// Relayed from a bank SMS/push forwarder. Idempotent on externalId.
/// status: "MATCHED" | "UNMATCHED" | "AMBIGUOUS" | "IGNORED" | "FAILED"
model BankDepositNotification {
  id             String    @id @default(cuid())
  externalId     String    @unique // dedup key from relay (SMS hash / provider id)
  source         String    @default("sms") // relay channel
  rawText        String    @db.Text
  amount         Int // 입금 금액 (원)
  depositorName  String? // 입금자명 (정규화 전 원본)
  bankName       String?
  status         String    @default("UNMATCHED") // "UNMATCHED" | "MATCHED" | "MANUAL_GRANT" | "AMBIGUOUS" | "IGNORED" | "FAILED"
  matchedTopUpId String? // CreditTopUp matched & credited
  note           String?   @db.Text
  occurredAt     DateTime? // 은행이 알려준 입금 시각
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  matchedTopUp CreditTopUp? @relation(fields: [matchedTopUpId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@index([amount])
  @@index([matchedTopUpId])
  @@map("bank_deposit_notifications")
}

// ============================================================================
// 22-b. GROWTH — REFERRAL, CREDIT MISSIONS, NOTIFICATIONS
// ============================================================================

/// ReferralCode — one stable, shareable referral code per academy.
/// Credits are on-platform-only (자기적립 마일리지 → VAT-excluded, no 기타소득 withholding).
model ReferralCode {
  id               String   @id @default(cuid())
  academyId        String   @unique
  code             String   @unique
  createdByStaffId String?
  totalClicks      Int      @default(0)
  totalSignups     Int      @default(0)
  totalRewarded    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academy   Academy    @relation(fields: [academyId], references: [id])
  referrals Referral[]

  @@index([code])
  @@map("referral_codes")
}

/// Referral — one referred-academy conversion + reward state machine.
/// Single-hop give-get only (no multi-tier → outside 다단계판매법).
/// status: "GRANTED" | "HELD" | "APPROVED" | "REJECTED" | "CLAWED_BACK"
model Referral {
  id                String    @id @default(cuid())
  referralCodeId    String
  referrerAcademyId String
  referredAcademyId String    @unique // idempotency: each new academy can be referred at most once
  referredStaffId   String?
  referrerReward    Int       @default(0)
  referredReward    Int       @default(0)
  status            String    @default("GRANTED")
  fraudScore        Int       @default(0)
  fraudSignals      Json?
  referrerTxId      String? // CreditTransaction id of the referrer grant
  referredTxId      String? // CreditTransaction id of the new academy welcome grant
  signupIp          String?
  signupUserAgent   String?   @db.Text
  grantedAt         DateTime?
  reviewedByAdminId String?
  reviewNote        String?   @db.Text
  reviewedAt        DateTime?
  clawedBackAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  referralCode    ReferralCode @relation(fields: [referralCodeId], references: [id])
  referrerAcademy Academy      @relation("ReferralsMade", fields: [referrerAcademyId], references: [id])
  referredAcademy Academy      @relation("ReferralReceived", fields: [referredAcademyId], references: [id])

  @@index([referrerAcademyId, createdAt])
  @@index([status, createdAt])
  @@index([referralCodeId])
  @@map("referrals")
}

/// CreditMission — admin-managed catalog of credit-earning missions.
/// cadence: "ONCE" | "DAILY" | "EVENT"   category: "ONBOARDING" | "DAILY" | "REFERRAL" | "EXPLORE"
model CreditMission {
  id                String   @id @default(cuid())
  key               String   @unique
  title             String
  description       String?  @db.Text
  category          String
  cadence           String
  rewardCredits     Int
  iconKey           String?
  actionUrl         String?
  ctaLabel          String?
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  maxRewardPerMonth Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("credit_missions")
}

/// AcademyMissionClaim — idempotent per-academy mission completion.
/// periodKey = "ONCE" for one-time missions, or KST date "2026-06-18" for DAILY.
model AcademyMissionClaim {
  id               String   @id @default(cuid())
  academyId        String
  missionKey       String
  periodKey        String
  rewardCredits    Int
  creditTxId       String?
  claimedByStaffId String?
  createdAt        DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id])

  @@unique([academyId, missionKey, periodKey])
  @@index([academyId, createdAt])
  @@map("academy_mission_claims")
}

/// Notification — per-staff inbox (fan-out-on-write).
/// category: "MISSION" | "REFERRAL" | "SYSTEM" | "BILLING"
model Notification {
  id               String    @id @default(cuid())
  academyId        String
  recipientStaffId String
  category         String
  type             String
  title            String
  body             String?   @db.Text
  iconKey          String?
  actionUrl        String?
  data             Json?
  groupKey         String?
  readAt           DateTime?
  archivedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  academy        Academy @relation(fields: [academyId], references: [id])
  recipientStaff Staff   @relation(fields: [recipientStaffId], references: [id])

  @@index([recipientStaffId, createdAt])
  @@index([recipientStaffId, readAt])
  @@index([academyId, createdAt])
  @@map("notifications")
}

/// NotificationState — per-staff badge state. Bell "unseen" count = notifications created after lastSeenAt.
model NotificationState {
  staffId    String    @id
  lastSeenAt DateTime?
  updatedAt  DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id])

  @@map("notification_states")
}

/// PrintableCouponBatch — 실물(인쇄형) 쿠폰 발급 건. 한 배치 = 한 발급, 발급 후 조건 불변(freeze).
/// effectType: "CREDIT_GRANT"(등록 즉시 크레딧 지급) | "DISCOUNT_AMOUNT"(N원 할인) | "DISCOUNT_PERCENT"(N% 할인)
model PrintableCouponBatch {
  id          String  @id @default(cuid())
  batchName   String // 관리자용 라벨 "신규가입 쿠폰 2026.07.07"
  title       String // 인쇄 카드 쿠폰명
  description String? @db.Text

  effectType      String    @default("CREDIT_GRANT") // "CREDIT_GRANT" | "DISCOUNT_AMOUNT" | "DISCOUNT_PERCENT"
  // CREDIT_GRANT 전용
  grantCredits    Int? // 지급 크레딧 수
  grantExpiryDays Int? // (레거시) 지급 크레딧 유효기간(일). null/0=RIDE, >0=EXTEND
  grantExpiryAt   DateTime? // 지급 크레딧 절대 만료일(캘린더 선택). null=무기한(RIDE)
  // DISCOUNT 전용 (효과에 맞는 하나만 채움)
  discountAmount  Int? // 원 (DISCOUNT_AMOUNT)
  discountPercent Int? // 1~100 (DISCOUNT_PERCENT)

  validUntil          DateTime? // 쿠폰 "등록" 마감일 (nullable)
  quantity            Int // 발급 장수 (1~500)
  perAcademyLimit     Int       @default(1) // 한 학원이 이 배치에서 등록 가능한 최대 장수
  isActive            Boolean   @default(true) // 킬스위치
  createdByAdminId    String?
  createdByAdminEmail String?
  createdAt           DateTime  @default(now())

  codes PrintableCouponCode[]

  @@index([createdAt])
  @@map("printable_coupon_batches")
}

/// PrintableCouponCode — 인쇄 코드 + 학원 보유 쿠폰(핵심). 한 행이 "인쇄 코드 + 보유 쿠폰"을 겸함.
/// status: "ACTIVE" | "CLAIMED" | "USED" | "VOID"
model PrintableCouponCode {
  id           String @id @default(cuid())
  batchId      String
  serialNumber String @unique @db.VarChar(16) // 종이 인쇄 8자리(사람 입력)
  tokenHash    String @unique // QR 토큰 SHA-256 (원본 미저장)
  status       String @default("ACTIVE") // "ACTIVE" | "CLAIMED" | "USED" | "VOID"

  claimedByAcademyId String? // 등록한 학원
  claimedByStaffId   String? // 등록 실행 원장
  claimedAt          DateTime?

  // CREDIT_GRANT: 지급 시 채움 / DISCOUNT: 충전 결제 사용 시 채움
  creditTxId  String?   @unique // 지급 원장 링크(CREDIT_GRANT 멱등 증빙)
  usedTopUpId String?   @unique // 사용된 충전(CreditTopUp) 링크(DISCOUNT)
  usedAt      DateTime?

  expiresAt DateTime? // 개별 등록마감 오버라이드(옵션)
  printedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  batch PrintableCouponBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
  @@index([claimedByAcademyId, status])
  @@map("printable_coupon_codes")
}

/// PrintableCouponClaimRateLimit — 쿠폰 등록 시도 rate-limit(코드 추측 방지).
/// scope="ip"|"academy", key=IP 또는 academyId, fixed window 카운터(tutorLoginRateLimit 패턴).
model PrintableCouponClaimRateLimit {
  id          String   @id @default(cuid())
  scope       String   @db.VarChar(16) // "ip" | "academy"
  key         String   @db.VarChar(128)
  windowStart DateTime
  count       Int      @default(0)

  @@unique([scope, key, windowStart])
  @@map("printable_coupon_claim_rate_limits")
}


// ============================================================================
// 어법 드릴 — 모바일 어법 학습 툴 (/g)
//
// 콘텐츠(유닛·개념·문항)는 코드 번들(src/data/grammar-drill)이 정본이므로
// DB에는 학생 학습 데이터만 축적한다. Student 와의 관계는 의도적으로
// relation-free(컬럼만) — 공유 Student 모델 블록을 건드리지 않기 위함이며,
// 조회는 액션 레이어에서 명시 조인한다. 적용은 surgical SQL
// (scripts/sql/grammar-drill-tables.sql, prisma db execute) — migrate 금지.
// ============================================================================

/// 문항 시도 로그 — 축적의 원장. 모든 분석은 이 테이블에서 파생된다.
model GrammarDrillAttempt {
  id            String   @id @default(cuid())
  academyId     String
  studentId     String
  itemId        String // 번들 문항 ID (예: u02-c1-ch-009)
  unitId        String
  conceptId     String
  itemType      String // CHOICE | OX | MULTI_UNDERLINE | PASSAGE | WRITE_FORM | WRITE_CORRECT
  difficulty    Int
  correct       Boolean
  answer        String   @db.Text // 학생 응답(인덱스·번호·서술 텍스트)
  timeMs        Int      @default(0)
  hintUsed      Int      @default(0) // 0~2 (본 힌트 단계 수)
  conceptPeeked Boolean  @default(false) // 풀이 중 개념 시트 열람 여부
  source        String   @default("DRILL") // DRILL | CONCEPT_CHECK | READING | WRITTEN | UNIT_TEST | MIXED | REVIEW | ASSIGNMENT
  assignmentId  String?
  createdAt     DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([studentId, conceptId])
  @@index([studentId, itemId])
  @@index([academyId, createdAt])
  @@map("grammar_drill_attempts")
}

/// 개념 숙달도 — 시도 로그의 실시간 집계(서빙 엔진·취약점 분석의 축).
model GrammarDrillMastery {
  id            String    @id @default(cuid())
  academyId     String
  studentId     String
  conceptId     String
  unitId        String
  attempts      Int       @default(0)
  correct       Int       @default(0)
  streak        Int       @default(0) // 현재 연속 정답
  masteryScore  Float     @default(0) // 0~100 지수가중이동평균
  box           Int       @default(0) // 0~5 (간격 반복 라이트너 박스)
  lastAttemptAt DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([studentId, conceptId])
  @@index([studentId, unitId])
  @@index([academyId, updatedAt])
  @@map("grammar_drill_mastery")
}

/// 인터랙티브 레슨 진행 — 개념 1개 = 행 1개. (학습 OS, docs/study-os-spec.md §6.1)
/// note 는 학생이 자기 말로 쓴 필기이며 교사가 열람한다.
/// 적용 SQL: scripts/sql/grammar-drill-lesson-progress.sql (surgical, migrate 금지)
model GrammarDrillLessonProgress {
  id             String    @id @default(cuid())
  academyId      String
  studentId      String
  unitId         String
  conceptId      String
  blocksSeen     Int       @default(0)
  blocksTotal    Int       @default(0)
  lastBlockIndex Int       @default(0)
  checkTotal     Int       @default(0)
  checkCorrect   Int       @default(0)
  confidence     Int? // 1 자신 없음 ~ 3 설명할 수 있음
  note           String?   @db.Text
  secondsSpent   Int       @default(0)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([studentId, conceptId])
  @@index([studentId, unitId])
  @@index([academyId, updatedAt])
  @@map("grammar_drill_lesson_progress")
}

/// 어법 스텟 — 학생당 1행. XP·게임 전적·칭호 이력·게임 XP 중복지급 방지 원장.
/// 칭호의 정본은 titles.ts(순수 함수) — titles JSONB 는 획득 시각 이력일 뿐이다.
/// 적용 SQL: scripts/sql/grammar-drill-stats.sql (surgical, migrate 금지)
model GrammarDrillStat {
  id               String    @id @default(cuid())
  academyId        String
  studentId        String    @unique
  xp               Int       @default(0)
  lessonsCompleted Int       @default(0)
  replays          Int       @default(0)
  gamesPlayed      Int       @default(0)
  gamePerfects     Int       @default(0)
  bossWins         Int       @default(0)
  bossLosses       Int       @default(0)
  memoryGatePasses Int       @default(0)
  bestCombo        Int       @default(0)
  lensXp           Json      @default("{}") // {"L1":0,...,"L5":0}
  partXp           Json      @default("{}") // {"p0":0,...,"p3":0}
  titles           Json      @default("[]") // [{"key","earnedAt"}]
  gameLog          Json      @default("{}") // {"conceptId:blockId":{"plays","best"}}
  lastStudyDate    DateTime?
  streakDays       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([academyId, updatedAt])
  @@map("grammar_drill_stats")
}

/// 유닛 단계 진행 — CONCEPT → DRILL → READING → WRITTEN → TEST → MASTERED.
model GrammarDrillUnitProgress {
  id            String    @id @default(cuid())
  academyId     String
  studentId     String
  unitId        String
  stage         String    @default("CONCEPT")
  conceptDoneAt DateTime?
  drillDoneAt   DateTime?
  readingDoneAt DateTime?
  writtenDoneAt DateTime?
  masteredAt    DateTime?
  bestTestScore Int? // 유닛 테스트 최고점(0~100)
  updatedAt     DateTime  @updatedAt

  @@unique([studentId, unitId])
  @@index([academyId, updatedAt])
  @@map("grammar_drill_unit_progress")
}

/// 선생님 → 학생 추가 학습 할당.
model GrammarDrillAssignment {
  id            String    @id @default(cuid())
  academyId     String
  studentId     String
  staffId       String?
  title         String
  note          String?   @db.Text // 학생에게 보이는 선생님 메모(합니다체)
  spec          Json // { conceptIds?, unitIds?, itemTypes?, difficulties?, count }
  status        String    @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | DONE
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  resultSummary Json? // { total, correct, timeMs }

  @@index([studentId, status])
  @@index([academyId, createdAt])
  @@map("grammar_drill_assignments")
}

/// 질문 탭 챗 로그 — 행 단위(선생님 열람·감사 대상). 무과금이지만 원가는 별도 원장 기록.
model GrammarDrillChatMessage {
  id               String   @id @default(cuid())
  academyId        String
  studentId        String
  contextItemId    String? // 질문 시점에 보고 있던 문항
  contextConceptId String?
  role             String // user | assistant
  content          String   @db.Text
  createdAt        DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([academyId, createdAt])
  @@map("grammar_drill_chat_messages")
}

// ============================================================================
// 단어 훈련(VocabDrill) — 기출 단어 코퍼스 기반 어휘 학습 툴 (/g/track/vocab)
//
// 어법 드릴과 결정적으로 다른 점: 콘텐츠 7테이블(bundles~sense_aliases)은
// **DB 가 정본**이다(코드 번들 아님 — 표제어 27,011·sense 35,341·예문 97,524 규모,
// 근거는 prisma/sql/vocab-drill-init.sql §1 결정 1). 콘텐츠 테이블은 읽기 전용 —
// 쓰기는 scripts/vocab-db-load.ts 만 한다. 학습 6테이블(attempts~stats)은 어법
// 형상 복제. 전부 relation-free(FK 없는 soft-ref) — 공유 Student/Academy 모델
// 블록을 건드리지 않는다. 부분 유니크·부분 인덱스는 Prisma 가 표현하지 못하므로
// **@@unique 로 적지 않고 주석으로만 남긴다**(introspect drift 방지 — SQL 이 정본).
// 적용 SQL: prisma/sql/vocab-drill-init.sql (surgical, migrate 금지)
// ============================================================================

/// 번들 원장 — 어떤 코퍼스 스냅샷이 테이블에 들어있는지의 정본. id 는 적재기가 주조.
/// 부분 유니크(SQL 정본): UNIQUE(status) WHERE status='ACTIVE' — 활성 번들은 항상 1개.
/// 적용 SQL: prisma/sql/vocab-drill-init.sql (surgical, migrate 금지)
model VocabDrillBundle {
  id           String    @id
  version      String    @unique // 예: v4537-761b9699
  sourcePath   String
  checksum     String // sha256(lemmas.json)
  docs         Int       @default(0) // 추출 완료 지문 수
  corpusDocs   Int       @default(0) // 전체 지문 수
  lemmaCount   Int       @default(0)
  senseCount   Int       @default(0)
  exampleCount Int       @default(0)
  trapCount    Int       @default(0)
  status       String    @default("STAGED") // STAGED | ACTIVE | RETIRED
  meta         Json      @default("{}")
  builtAt      DateTime?
  loadedAt     DateTime  @default(now())
  activatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, loadedAt])
  @@map("vocab_drill_bundles")
}

/// 표제어 마스터 — id = sha1(lower(lemma)|pos)[0..15] 내용 주소(번들 무관, 적재기 주조).
/// quant 계열이 NULL 인 것은 정상(신규 표제어). 은퇴는 retiredAt — DELETE 하지 않는다.
/// 부분 인덱스(SQL 정본): trendLabel+per10k / per10k / lemma text_pattern_ops(접두 검색).
/// 적용 SQL: prisma/sql/vocab-drill-init.sql (surgical, migrate 금지)
model VocabDrillLemma {
  id                 String    @id
  bundleVersion      String
  lemma              String
  pos                String // noun|verb|adjective|adverb|preposition|conjunction|idiom|phrasal_verb|collocation
  isPhrase           Boolean   @default(false)
  senseCount         Int       @default(0)
  totalEntries       Int       @default(0)
  needsMergeJudgment Boolean   @default(false)
  confusable         Json      @default("[]") // string[]
  collocations       Json      @default("[]") // string[]
  surfaces           Json      @default("[]") // 표면형 목록
  totalOccurrences   Int?
  passageCount       Int?
  per10k             Float? // 코퍼스 정규화 빈도
  per10kGo1          Float?
  per10kGo2          Float?
  per10kGo3          Float?
  gradeTop           String? // 고1|고2|고3
  gradeSkew          Float?
  typeSkew           Float?
  topTypes           Json      @default("[]") // [{typeGroup, per10k}] 상위 3
  trendLabel         String? // 급증|증가|안정|감소|급감|신규 등장|중간기만 등장|미등장
  trendRatio         Float?
  trendSlope         Float?
  earlyPer10k        Float?
  latePer10k         Float?
  yearsPresent       Int?
  longestGap         Int?
  trendBasis         String?
  zeroKind           String? // null | none | absent
  retiredAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([lemma, pos]) // 해시 충돌 감지기를 겸한다
  @@index([bundleVersion])
  @@map("vocab_drill_lemmas")
}

/// 표제어 연도/유형 시계열 — 표제어당 1행, PK 조회로만 읽힌다(목록 질의에 싣지 않는다).
/// 값은 표제어가 실현한 **전 표면형 합산**(basis 1개 아님 — init.sql 2-3 정정 참조).
/// 적용 SQL: prisma/sql/vocab-drill-init.sql (surgical, migrate 금지)
model VocabDrillLemmaYearStat {
  lemmaId          String   @id
  bundleVersion    String
  statsSource      String   @default("stats") // stats | phrase-stats | mixed
  basis            String? // 추세 라벨의 대표 표면형(집계 기준 아님)
  basisSurfaces    Json     @default("[]") // 실제 합산한 통계 행 키 전량
  totalOccurrences Int      @default(0) // vocab_drill_lemmas.totalOccurrences 와 같아야 한다
  byYear           Json     @default("{}") // {"2003":130,…} 25키(0 포함)
  per10kByYear     Json     @default("{}")
  byGrade          Json     @default("{}") // {"고1":…,"고2":…,"고3":…}
  per10kByGrade    Json     @default("{}")
  byType           Json     @default("{}") // 15종 typeGroup 원시 빈도
  byBoard          Json     @default("{}") // 출제기관 원시 빈도
  yearMin          Int? // 출현이 있는 첫 해(0 인 해는 등장이 아니다)
  yearMax          Int?
  yearsPresent     Int?
  longestGap       Int?
  gapFrom          Int?
  gapTo            Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([bundleVersion])
  @@map("vocab_drill_lemma_year_stats")
}

/// 뜻(sense) 마스터 — 이 도메인의 핵심 단위이자 숙달도의 축.
/// id = lemmaId ':' sha1(senseKeyNorm)[0..7] — 정본은 sense-registry.json(적재기 주조).
/// lemma/pos/per10k/gradeTop/isPhrase/trendLabel 은 표제어에서 역정규화(서빙 단일 테이블화).
/// 부분 인덱스(SQL 정본): tier+gradeTop+per10k / difficulty+per10k / needsMerge (전부 미은퇴 한정).
/// 적용 SQL: prisma/sql/vocab-drill-init.sql (surgical, migrate 금지)
model VocabDrillSense {
  id                 String    @id
  bundleVersion      String
  lemmaId            String
  lemma              String
  pos                String
  senseKey           String    @db.Text // 영어 정의 원문(표제어 내 유니크)
  senseKeyNorm       String // 해시 입력(정규화형) — 재빌드 매칭 기준
  senseEn            String    @db.Text
  senseEnVariants    Json      @default("[]")
  senseKo            String
  senseKoCandidates  Json      @default("[]") // [{ko, n}] 빈도순
  tier               String    @default("core") // basic|core|academic|advanced
  tiers              Json      @default("[]")
  difficulty         Int       @default(3) // 1~5
  difficultyAvg      Float     @default(3)
  occurrences        Int       @default(0)
  exampleCount       Int       @default(0)
  trapCount          Int       @default(0)
  trapRate           Float     @default(0) // 0~1
  trapKinds          Json      @default("{}") // {kind: count}
  senseOrder         Int       @default(0)
  needsMergeJudgment Boolean   @default(false)
  isPhrase           Boolean   @default(false)
  per10k             Float?
  gradeTop           String?
  trendLabel         String?
  retiredAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([lemmaId, senseKeyNorm])
  @@index([lemmaId, senseOrder])
  @@index([bundleVersion])
  @@map("vocab_drill_senses")
}

/// 예문 — 어느 지문 어느 문장에서 왔는지가 존재 이유. id = 정체성 필드 해시(적재기 주조).
/// 적용 SQL: prisma/sql/vocab-drill-init.sql (surgical, migrate 금지)
model VocabDrillExample {
  id            String    @id
  bundleVersion String
  senseId       String
  lemmaId       String
  passageId     String // exam-passages soft-ref
  sentenceIndex Int
  grade         String? // 고1|고2|고3
  year          Int?
  typeGroup     String?
  surface       String // 실제 굴절형(made, making)
  en            String    @db.Text
  ko            String    @db.Text
  ord           Int       @default(0) // sense 내 표시 순서(0~4)
  retiredAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([senseId, grade, ord])
  @@index([passageId])
  @@index([bundleVersion])
  @@map("vocab_drill_examples")
}

/// 지문↔뜻 전수 매핑 — 행의 단위는 **(지문 × 뜻) 유일쌍**이다.
/// examples 와 목적이 다르다: examples 는 학생 카드용 예문이라 후보당 5개 상한
/// (vocab-corpus-build.ts EXAMPLE_CAP)에 걸려 지문 어휘의 52.5% 만 남는다.
/// 이 테이블은 상한 없이 raw 추출 전량(183,616쌍)을 들어 "이 기출에 나온 단어"
/// 질문에 답한다. 지문 메타는 역정규화(지문 정본은 앱 번들 JSON 에만 있다).
/// 장문(41-42)은 qFrom/qTo 구간으로 들고 범위 필터는 겹침 판정으로 쓴다.
/// 적용 SQL: prisma/sql/vocab-drill-passage-words.sql (surgical, migrate 금지)
model VocabDrillPassageWord {
  id            String   @id // sha1(passageId|senseId)[0..15]
  bundleVersion String
  passageId     String // exam-passages soft-ref
  senseId       String
  lemmaId       String
  surface       String // 그 지문에서의 실제 굴절형
  sentenceIndex Int // 최초 출현 문장(0-base)
  occurrences   Int      @default(1) // 이 지문 안에서의 출현 횟수
  year          Int // 학년도 2003~2027
  board         String // 대학수학능력시험|수능모의평가|학력평가
  exam          String // 수능|6월|9월|3월|…|예비 (12종)
  grade         String? // 고1|고2|고3
  qFrom         Int // 문항번호 구간(실측 18~55)
  qTo           Int
  typeGroup     String? // 15종
  examId        String // 시험지 식별자(283종)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([passageId, senseId])
  @@index([year, board, senseId])
  @@index([passageId])
  @@index([senseId])
  @@index([examId])
  @@index([bundleVersion])
  @@map("vocab_drill_passage_words")
}

/// 함정(trap) — sense 단위. note 는 **제출 후에만** 학생에게 노출한다.
/// 적용 SQL: prisma/sql/vocab-drill-init.sql (surgical, migrate 금지)
model VocabDrillTrap {
  id            String    @id
  bundleVersion String
  senseId       String
  lemmaId       String
  kind          String // polysemy|collocation|syntax|form-confusion|false-friend|negation|register
  note          String    @db.Text
  ord           Int       @default(0)
  retiredAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([senseId, ord])
  @@index([kind])
  @@index([bundleVersion])
  @@map("vocab_drill_traps")
}

/// sense 이관 원장 — 명시적 판정(4단계 LLM 병합 산출 또는 사람)만 담는다.
/// 자동 유사도 매핑 금지(init.sql 2-7 정정). 비어 있는 것이 정상이다.
/// 적용 SQL: prisma/sql/vocab-drill-init.sql (surgical, migrate 금지)
model VocabDrillSenseAlias {
  id            String   @id
  fromSenseId   String   @unique // 은퇴한 senseId — 목적지는 하나(체인 가능, 분기 불가)
  toSenseId     String
  lemmaId       String
  reason        String   @default("MERGE") // MERGE | RENAME | SPLIT_PICK | MANUAL
  confidence    Float    @default(1) // 명시 판정은 1. 추정치 금지
  fromSenseKey  String?  @db.Text
  toSenseKey    String?  @db.Text
  bundleVersion String
  createdAt     DateTime @default(now())

  @@index([toSenseId])
  @@index([lemmaId])
  @@map("vocab_drill_sense_aliases")
}

/// 문항 시도 로그 — 축적의 원장(append-only). 모든 분석이 여기서 파생된다.
/// lemmaId 를 함께 든다 — sense 매핑이 끊겨도 표제어 단위 집계는 살아남는다.
/// 부분 유니크(SQL 정본): UNIQUE(studentId, clientKey) WHERE clientKey IS NOT NULL — 멱등 제출.
/// 적용 SQL: prisma/sql/vocab-drill-init.sql (surgical, migrate 금지)
model VocabDrillAttempt {
  id            String   @id @default(cuid())
  academyId     String
  studentId     String
  senseId       String
  lemmaId       String
  deckId        String?
  exampleId     String? // 문맥 문항이면 사용한 예문
  itemType      String // MEANING_CHOICE | WORD_CHOICE | CONTEXT_FILL | SPELL | EXAMPLE_MATCH | TRAP_JUDGE | FLASH
  difficulty    Int      @default(3)
  correct       Boolean
  answer        String   @db.Text // 학생 응답(500자 slice — 어법 관례)
  timeMs        Int      @default(0) // 0~30분 clamp
  hintUsed      Int      @default(0) // 0~2
  meaningPeeked Boolean  @default(false) // 풀이 중 뜻 시트 열람
  source        String   @default("DRILL") // DRILL | FLASH | CONTEXT | REVIEW | DECK_TEST | MIXED | ASSIGNMENT | WORKSHEET
  assignmentId  String?
  clientKey     String? // 클라 생성 UUID — 재시도/네트워크 중복 제출 멱등
  createdAt     DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([studentId, senseId])
  @@index([studentId, lemmaId])
  @@index([academyId, createdAt])
  // 덱·과제 서빙 축(init.sql §0 Q8 ★). studentId 선두 3종으로는 deckId/assignmentId
  // 필터가 인덱스를 못 타 학생 시도 전량을 훑는다 — 시도는 학생당 수천~수만 행이다.
  @@index([studentId, deckId])
  @@index([studentId, assignmentId])
  @@map("vocab_drill_attempts")
}

/// 숙달도 — 학생×sense 1행. 계산식은 어법 engine.ts 와 동일(EWMA α=0.25 · Leitner ±).
/// 어법에 없는 3컬럼: dueAt(복습 큐를 인덱스 range scan 으로) · lapses(box 하락 누적) ·
/// remappedFrom(alias 이관 흔적). 학생×sense 는 수천~수만 행 — 전량 로드 금지, LIMIT 강제.
/// 적용 SQL: prisma/sql/vocab-drill-init.sql (surgical, migrate 금지)
model VocabDrillMastery {
  id            String    @id @default(cuid())
  academyId     String
  studentId     String
  senseId       String
  lemmaId       String
  attempts      Int       @default(0)
  correct       Int       @default(0)
  streak        Int       @default(0)
  masteryScore  Float     @default(0) // 0~100 EWMA(소수 1자리)
  box           Int       @default(0) // 0~5 라이트너
  lapses        Int       @default(0)
  firstSeenAt   DateTime?
  lastAttemptAt DateTime?
  dueAt         DateTime? // box → 간격 → 다음 복습 예정 시각
  remappedFrom  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([studentId, senseId])
  @@index([studentId, dueAt])
  @@index([studentId, masteryScore])
  @@index([studentId, lemmaId])
  @@index([senseId])
  @@index([academyId, updatedAt])
  @@map("vocab_drill_mastery")
}

/// 단어장(덱) — "저장된 질의". 멤버십 테이블 없음 — 소속 sense 는 spec 에서 매번 파생.
/// 부분 유니크(SQL 정본): UNIQUE(academyId, slug) WHERE slug IS NOT NULL.
/// 적용 SQL: prisma/sql/vocab-drill-init.sql (surgical, migrate 금지)
model VocabDrillDeck {
  id              String   @id @default(cuid())
  academyId       String // GLOBAL 덱은 시스템 학원 id
  scope           String   @default("ACADEMY") // GLOBAL | ACADEMY
  slug            String? // go2-core-500
  title           String
  subtitle        String?
  spec            Json     @default("{}") // {grades?,tiers?,difficulties?,posList?,trendLabels?,minPer10k?,excludePhrase?,senseIds?,limit}
  senseCountCache Int      @default(0) // 표시용 캐시(정본은 spec 파생)
  orderIndex      Int      @default(0)
  status          String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdById     String? // staff soft-ref
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([academyId, status, orderIndex])
  @@map("vocab_drill_decks")
}

/// 덱 진행 — 학생×덱 1행. 단계: LEARN → DRILL → CONTEXT → TEST → MASTERED.
/// 적용 SQL: prisma/sql/vocab-drill-init.sql (surgical, migrate 금지)
model VocabDrillDeckProgress {
  id            String    @id @default(cuid())
  academyId     String
  studentId     String
  deckId        String
  stage         String    @default("LEARN")
  learnDoneAt   DateTime?
  drillDoneAt   DateTime?
  contextDoneAt DateTime?
  masteredAt    DateTime?
  totalCount    Int       @default(0) // 덱 파생 시점 스냅샷
  seenCount     Int       @default(0)
  masteredCount Int       @default(0)
  bestTestScore Int? // 0~100
  lastStudiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([studentId, deckId])
  @@index([deckId, updatedAt])
  @@index([academyId, updatedAt])
  @@map("vocab_drill_deck_progress")
}

/// 단어 과제 — 배포 접합 방향이 어법과 반대: 여기의 taskId 가 study_assignment_tasks 를
/// 아래→위로 가리킨다(공유 테이블 컬럼 추가 금지 규약 — init.sql 3-5 참조).
/// 부분 유니크(SQL 정본): UNIQUE(taskId) WHERE taskId IS NOT NULL — 태스크당 브리지 1건.
/// 적용 SQL: prisma/sql/vocab-drill-init.sql (surgical, migrate 금지)
model VocabDrillAssignment {
  id            String    @id @default(cuid())
  academyId     String
  studentId     String
  staffId       String?
  taskId        String? // study_assignment_tasks soft-ref (역방향)
  assignmentId  String? // study_assignments soft-ref
  title         String
  note          String?   @db.Text // 학생에게 보이는 선생님 메모(합니다체)
  spec          Json      @default("{}") // {deckIds?,senseIds?,lemmaIds?,tiers?,difficulties?,count}
  status        String    @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | DONE
  resultSummary Json? // {total, correct, timeMs}
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  @@index([studentId, status])
  @@index([academyId, createdAt])
  @@map("vocab_drill_assignments")
}

/// 단어 스텟 — 학생당 1행. 칭호의 정본은 코드(순수 함수), titles 는 획득 시각 이력.
/// XP 이중지급 방지는 attempts.clientKey 멱등이 담당한다(별도 원장 없음).
/// 적용 SQL: prisma/sql/vocab-drill-init.sql (surgical, migrate 금지)
model VocabDrillStat {
  id             String    @id @default(cuid())
  academyId      String
  studentId      String    @unique
  xp             Int       @default(0)
  sensesSeen     Int       @default(0)
  sensesMastered Int       @default(0) // masteryScore >= 80 도달 누적
  decksCompleted Int       @default(0)
  reviewsDone    Int       @default(0)
  bestCombo      Int       @default(0)
  tierXp         Json      @default("{}") // {"basic":0,"core":0,"academic":0,"advanced":0}
  posXp          Json      @default("{}") // {"noun":0,…,"collocation":0}
  titles         Json      @default("[]") // [{key, earnedAt}]
  lastStudyDate  DateTime?
  streakDays     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([academyId, updatedAt])
  @@map("vocab_drill_stats")
}

// ============================================================================
// 통합 학습 과제(StudyAssignment) — 시험지/학습지/문제세트/어법훈련 배포·과제
//
// 시험지(Exam)·학습지(PassageReport)·문제세트(Question[])·어법훈련(GrammarDrill
// spec)을 학생/반 단위로 배포하고 마감일·진행을 추적하는 통합 레이어.
// GrammarDrill* 과 동일하게 relation-free(FK 없는 soft-ref) — 공유 모델
// (Student/Exam/PassageReport) 블록을 건드리지 않는다. 조회는 액션 레이어에서
// 명시 조인. 적용은 surgical SQL
// (prisma/migrations-manual/20260711_study_assignments.sql) — migrate 금지.
//
// kind 별 브리지: EXAM→ExamSubmission(응시·채점 수명주기 전부 위임),
// GRAMMAR→GrammarDrillAssignment(드릴 엔진 위임). WORKSHEET/QUESTIONS 는
// 태스크 행 자체가 상태 정본. 라이브 상태 계산은
// src/lib/study-assignments/status.ts 가 정본.
// ============================================================================

/// 과제 1건 — 대상(targets)은 생성 시점 스냅샷으로 확장되어 tasks 가 만들어진다.
model StudyAssignment {
  id            String    @id @default(cuid())
  academyId     String
  createdById   String? // staff soft-ref (FK 미설정)
  kind          String // "EXAM" | "WORKSHEET" | "QUESTIONS" | "GRAMMAR"
  refId         String? // EXAM→Exam.id, WORKSHEET→PassageReport.id (soft-ref)
  payload       Json      @default("{}") // kind별 스펙 — src/lib/study-assignments/types.ts 계약
  title         String
  instructions  String?   @db.Text // 학생에게 보이는 안내문(합니다체)
  availableFrom DateTime  @default(now())
  dueAt         DateTime?
  status        String    @default("ACTIVE") // "ACTIVE" | "CLOSED" | "ARCHIVED"
  targets       Json      @default("[]") // [{type:"CLASS"|"STUDENT", id, name}] 배포 시점 스냅샷
  targetSummary String? // "고1 정예반 외 2명" 표시 캐시
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([academyId, createdAt])
  @@index([academyId, dueAt])
  @@map("study_assignments")
}

/// 과제의 학생 1명 태스크 — EXAM/GRAMMAR 는 브리지 soft-ref 로 실행을 위임한다.
model StudyAssignmentTask {
  id                  String    @id @default(cuid())
  academyId           String
  assignmentId        String
  studentId           String
  status              String    @default("ASSIGNED") // "ASSIGNED" | "IN_PROGRESS" | "DONE"
  examSubmissionId    String? // EXAM 브리지 — 라이브 상태는 exam_submissions 조인으로 계산
  grammarAssignmentId String? // GRAMMAR 브리지 — grammar_drill_assignments 조인
  responses           Json? // QUESTIONS: SubmissionResponse[] 동형(학생 응답)
  result              Json? // {score,maxScore,percent,correct,total,...} 표시 캐시
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId, status, createdAt])
  @@index([academyId, createdAt])
  @@map("study_assignment_tasks")
}

/// 클래스 스튜디오 — 클래스 ↔ 지문 등록부 (docs/class-studio-spec.md §6).
/// 지문은 학원 공용 자산이고 "등록"만 클래스 스코프다. relation-free soft-ref —
/// 적용은 수동 SQL(prisma/migrations-manual/20260809_class_studio.sql),
/// migrate deploy / db push 금지.
model StudioClassPassage {
  id        String   @id @default(cuid())
  academyId String
  classId   String // Class soft-ref
  passageId String // Passage soft-ref
  addedById String? // Staff soft-ref
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([classId, passageId])
  @@index([academyId, classId, sortOrder])
  @@index([passageId])
  @@map("studio_class_passages")
}

/// 학습지 스터디 모드 — 학생×태스크 상태 (태스크당 1행). plan 은 저장하지 않고
/// 매 로드 시 (report, mode, taskId) 에서 결정론 재컴파일한다.
/// relation-free soft-ref 설계 — 적용은 수동 SQL(prisma/migrations-manual/20260720_worksheet_study.sql),
/// migrate deploy / db push 금지. 계약: docs/worksheet-study-spec.md §6.
model WorksheetStudyState {
  id           String    @id @default(cuid())
  academyId    String
  taskId       String    @unique // StudyAssignmentTask soft-ref
  assignmentId String
  studentId    String
  reportId     String // PassageReport soft-ref
  planHash     String? // 마지막 플러시 시점 plan 해시(드리프트 감지)
  stageStates  Json      @default("{}") // Record<StudyStageId, StudyStageState>
  weakness     Json? // StudyWeakness 캐시(플러시마다 증분 재계산)
  masteryPct   Int?
  totalTimeMs  Int       @default(0)
  startedAt    DateTime?
  completedAt  DateTime? // 필수 스테이지 전부 done 된 시각
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([academyId, assignmentId])
  @@index([studentId, updatedAt])
  @@map("worksheet_study_states")
}

/// 학습지 스터디 — 문항 단위 응답 로그 (append-only, GrammarDrillAttempt 선례).
/// (stateId, stageId, itemKey, attempt) 유니크로 중복 플러시 멱등(createMany skipDuplicates).
model WorksheetStudyItemLog {
  id          String   @id @default(cuid())
  academyId   String
  stateId     String // WorksheetStudyState soft-ref
  studentId   String
  stageId     String
  itemKey     String
  skill       String // "vocab"|"chunk"|"grammar"|"cloze"|"order"|"production"|"comprehension"
  sentenceNo  Int?
  wordKey     String?
  grammarCode String?
  attempt     Int      @default(1)
  correct     Boolean?
  selfGrade   String? // "O" | "D" | "X"
  response    String?  @db.Text
  timeMs      Int?
  hintUsed    Boolean  @default(false)
  /// 표제어 뜻 스냅샷 — 누적 취약 단어장이 원본 학습지 재파싱 없이 자립하도록
  /// 기록 시점에 plan.vocabMeanings 에서 동봉(wordKey 있는 로그만).
  wordMeaning String?
  createdAt   DateTime @default(now())

  @@unique([stateId, stageId, itemKey, attempt])
  @@index([stateId, createdAt])
  @@index([academyId, studentId, createdAt])
  @@index([academyId, studentId, wordKey])
  @@map("worksheet_study_item_logs")
}

// ─── 단체 세미나 ──────────────────────────────────────────────────────────────
// 1:1 세미나(SeminarRequest)와 달리 운영자가 "세미나 클래스"를 개설(GroupSeminar)해
// 두면 여러 원장이 정보를 보고 신청(GroupSeminarRegistration)하는 1-대-다 구조.
// 개설=SuperAdmin, 신청=Staff(원장). 정원(capacity)까지 REGISTERED 인원으로 마감.

model GroupSeminar {
  id                String    @id @default(cuid())
  title             String
  summary           String? // 목록 카드용 한 줄 소개
  description       String?   @db.Text // 상세 안내(커리큘럼 등)
  benefit           String?   @db.Text // 혜택 배너 문구(선물 아이콘 옆). 비면 배너 숨김
  host              String? // 강사/진행자
  target            String? // 대상(예: 신규 원장)
  location          String? // 오프라인 장소 또는 "온라인(줌)"
  mapUrl            String? // 지도 링크(네이버/카카오 등) — "지도에서 위치 확인하기" 버튼
  meetingUrl        String? // 온라인 접속 링크 — 신청 확정자에게 노출
  scheduledAt       DateTime? // 대표 일시(세션 목록의 가장 이른 날짜로 자동 설정)
  sessionDates      Json? // string[] ISO — 여러 날짜 중 사용자가 하루를 선택. 비면 단일 일정.
  durationMin       Int? // 진행 시간(분)
  capacity          Int? // 정원(null=제한 없음)
  registerCloseDays Int? // 신청 마감: 각 세션 실행 N일 전까지 접수(null/0=당일까지)
  depositAmount     Int? // 참가 보증금(원). null/0=없음. 계좌이체로 받고 세미나 당일 환급.
  coverImageUrl     String?
  publicEnabled     Boolean   @default(false) // 비회원(랜딩) 공개 신청 허용 여부
  status            String    @default("DRAFT") // DRAFT→OPEN→CLOSED→ENDED / CANCELED
  createdByAdminId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  registrations GroupSeminarRegistration[]

  @@index([status, scheduledAt])
  @@map("group_seminars")
}

model GroupSeminarRegistration {
  id            String    @id @default(cuid())
  seminarId     String
  academyId     String?
  staffId       String?
  applicantName String
  phone         String
  email         String?
  academyName   String?
  headCount     Int       @default(1) // 참석 인원수
  isGuest       Boolean   @default(false) // 비회원(랜딩) 신청 여부. staffId 없음.
  selectedDate  DateTime? // 여러 날짜 중 신청자가 선택한 세션 일시(단일 일정이면 null)
  message       String?   @db.Text
  status        String    @default("REGISTERED") // REGISTERED→ATTENDED / CANCELED

  // ── 참가 보증금(계좌이체) ──────────────────────────────────────────────
  depositAmount       Int? // 신청 시점 보증금 스냅샷(원). null=보증금 없는 세미나
  depositStatus       String    @default("NONE") // NONE | WAITING(입금대기) | PAID(입금확인) | REFUNDED(환급완료) | FORFEITED(몰수)
  depositorName       String? // 입금자명 — 자동 매칭 키(금액+입금자명+시간창)
  refundBankName      String? // 환급받을 은행
  refundAccountNumber String? // 환급받을 계좌번호
  refundAccountHolder String? // 환급받을 예금주
  depositPaidAt       DateTime?
  depositRefundedAt   DateTime?
  depositRef          String? // 매칭된 입금 알림 externalId(감사용)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seminar GroupSeminar @relation(fields: [seminarId], references: [id], onDelete: Cascade)

  @@unique([seminarId, staffId]) // 원장 1인당 세미나당 1건(중복 신청 방지)
  @@index([seminarId, status])
  @@index([depositStatus, depositAmount, createdAt]) // 보증금 자동매칭 쿼리
  @@map("group_seminar_registrations")
}

/// 학교별 SEO 페이지(공개). 「XX고 영어 내신 출제 경향」 롱테일 유입용.
///
/// ⚠️ 테넌트 격리 — 이 모델은 `School`(academyId 스코프 고객 데이터)과 **무관**하다.
///    공개 학교 명단은 NEIS 오픈API 로 별도 수집하며, 학원 고객 데이터를 여기 넣지 않는다.
/// ⚠️ 저작권 — 기출 지문·문항 원문은 어떤 필드에도 저장하지 않는다(대법원 2021다272001).
///    샘플 문항은 전량 창작만 허용(articles-content 의 ArticleSample 규약 승계).
model SchoolSeoPage {
  id     String @id @default(cuid())
  /// URL 1단: 시·도 한글(서울/경기/충남…). 로마자 금지 — NEIS 영문표기 붕괴.
  sido   String
  /// URL 2단: 학교 축약 한글(평택고). 강사 검색 토큰과 일치시킨다.
  slug   String

  officialName String
  region       String
  schoolType   String?
  homepage     String?
  /// NEIS 표준학교코드. URL 에 넣지 않고 내부 식별·중복방지에만 쓴다.
  neisCode     String?

  metaTitle       String
  metaDescription String @db.Text
  h1              String
  /// 대표 교과서 출판사 — /textbooks 아티클과 상호링크하는 조인 키.
  publisher       String?
  /// 이 페이지가 노리는 검색어. 배열 검색으로 갭 분석에 쓴다.
  keywords        String[]

  /// 본문 블록(JSON) — 조회 경로가 아니므로 스칼라로 승격하지 않는다.
  intro           Json
  sections        Json
  charts          Json
  comparisonTable Json?
  timeline        Json
  checklist       Json
  faq             Json
  textbooks       String[]
  related         Json?

  ctaTitle String?
  ctaBody  String? @db.Text

  /// 자료 충실도 — 발행 우선순위 정렬 키. 풍부 | 보통 | 희박
  richness    String  @default("보통")
  /// 학교 공시를 근거로 한 차트 비율(0~100). 품질 게이트 지표.
  citedRatio  Int     @default(0)
  /// DRAFT | PUBLISHED | RETIRED. sitemap·RSS 는 PUBLISHED 만 읽는다.
  status      String  @default("DRAFT")

  sourcesUsed String[]
  notes       String[]
  /// 생성 배치 식별자(워크플로 runId). 문제 발생 시 배치 단위 회수용.
  sourceRunId String?

  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  /// URL 유일성 — 동명이교는 sido 로 갈린다(광문고 서울·경기, 세화고 서울·경북·제주).
  @@unique([sido, slug])
  @@unique([neisCode])
  /// sitemap·허브 목록: 발행분을 최신순으로.
  @@index([status, publishedAt])
  /// 시도 인덱스 페이지: /schools/[sido]
  @@index([sido, status])
  /// /textbooks 상호링크: 같은 출판사 학교 모으기.
  @@index([publisher, status])
  /// 발행 우선순위 큐: 자료 풍부한 것부터.
  @@index([status, richness])
  @@map("school_seo_pages")
}

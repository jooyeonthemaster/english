// ============================================================================
// PASSAGE COLLECTIONS — Folder-like organization for passages
// ============================================================================

model PassageCollection {
  id          String   @id @default(cuid())
  academyId   String
  parentId    String? // Self-reference for nested folders (null = root)
  name        String
  description String?  @db.Text
  color       String? // Hex color for visual distinction
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// 폴더 과목 — null=ENGLISH(기존 폴더 전부·영어 경로 무회귀), "KOREAN"=국어.
  /// passages.subject 와 동일 규약. DB 반영은 surgical ALTER 관례
  /// (scripts/sql/ko-collections-subject.sql — migrate deploy / db push 금지):
  ///   ALTER TABLE passage_collections ADD COLUMN IF NOT EXISTS subject TEXT;
  subject String?

  academy  Academy                 @relation(fields: [academyId], references: [id])
  parent   PassageCollection?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children PassageCollection[]     @relation("FolderTree")
  items    PassageCollectionItem[]

  @@index([academyId])
  @@index([parentId])
  @@map("passage_collections")
}

model PassageCollectionItem {
  id           String @id @default(cuid())
  collectionId String
  passageId    String
  orderNum     Int    @default(0)

  collection PassageCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  passage    Passage           @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@unique([collectionId, passageId])
  @@index([collectionId])
  @@map("passage_collection_items")
}

// ============================================================================
// EXAM COLLECTIONS — Folder-like organization for exams
// ============================================================================

model ExamCollection {
  id          String   @id @default(cuid())
  academyId   String
  parentId    String? // Self-reference for nested folders (null = root)
  name        String
  description String?  @db.Text
  color       String? // Hex color for visual distinction

  /// 시험지 폴더 과목 — null=ENGLISH(기존 폴더 전부·영어 무회귀), "KOREAN"=국어 라우트 생성.
  /// passages.subject / *_collections.subject 규약. surgical ALTER (migrate deploy / db push 금지):
  ///   ALTER TABLE exam_collections ADD COLUMN IF NOT EXISTS subject text;  (ko-exam-set-subject.sql)
  subject     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academy  Academy              @relation(fields: [academyId], references: [id])
  parent   ExamCollection?      @relation("ExamFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ExamCollection[]     @relation("ExamFolderTree")
  items    ExamCollectionItem[]

  @@index([academyId])
  @@index([parentId])
  @@map("exam_collections")
}

model ExamCollectionItem {
  id           String @id @default(cuid())
  collectionId String
  examId       String
  orderNum     Int    @default(0)

  collection ExamCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  exam       Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([collectionId, examId])
  @@index([collectionId])
  @@map("exam_collection_items")
}

// ============================================================================
// M1 PASSAGE DRAFT COLLECTIONS — Folder organization for extraction drafts
// ============================================================================

model M1PassageDraftCollection {
  id          String   @id @default(cuid())
  academyId   String
  parentId    String? // Self-reference for nested folders (null = root)
  name        String
  description String?  @db.Text
  color       String? // Hex color for visual distinction
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academy  Academy                        @relation(fields: [academyId], references: [id])
  parent   M1PassageDraftCollection?      @relation("M1DraftFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children M1PassageDraftCollection[]     @relation("M1DraftFolderTree")
  items    M1PassageDraftCollectionItem[]

  @@index([academyId])
  @@index([parentId])
  @@map("extraction_m1_passage_draft_collections")
}

model M1PassageDraftCollectionItem {
  id           String @id @default(cuid())
  collectionId String
  draftId      String
  orderNum     Int    @default(0)

  collection M1PassageDraftCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  draft      ExtractionM1PassageDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([collectionId, draftId])
  @@index([collectionId])
  @@map("extraction_m1_passage_draft_collection_items")
}

// ============================================================================
// 20. PLATFORM ADMINISTRATION
// ============================================================================

/// SuperAdmin — Platform-level administrator (developer/operator)
/// role: "SUPER_ADMIN" | "SUPPORT"
model SuperAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("SUPER_ADMIN") // "SUPER_ADMIN" | "SUPPORT"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewedRegistrations AcademyRegistration[] @relation("ReviewedBy")
  creditAdjustments     CreditTransaction[]   @relation("AdjustedBy")
  auditLogs             AdminAuditLog[]       @relation("AuditedBy")

  @@map("super_admins")
}

/// AdminAuditLog — Append-only audit trail for non-credit admin actions
/// (member toggle, plan change, etc.). Credit changes are already captured
/// in CreditTransaction with adminId. This table covers everything else.
/// targetType: "MEMBER" | "ACADEMY" | "SUBSCRIPTION" | ...
/// action: "TOGGLE_ACTIVE" | "CHANGE_PLAN" | ...
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  action     String
  reason     String?  @db.Text
  beforeJson String?  @map("before_json") @db.Text // JSON snapshot
  afterJson  String?  @map("after_json") @db.Text // JSON snapshot
  metadata   String?  @db.Text // JSON: extra context
  createdAt  DateTime @default(now()) @map("created_at")

  admin SuperAdmin @relation("AuditedBy", fields: [adminId], references: [id])

  @@index([targetType, targetId, createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

/// SiteBanner — 최고 관리자가 관리하는, 로그인 사용자에게 뜨는 진입 배너.
/// 템플릿(내용 편집형) 또는 이미지 배너. 여러 개를 우선순위로 큐잉해서
/// 하나를 닫으면 다음이 열린다.
/// type: "TEMPLATE" | "IMAGE"
/// dismissMode: "DAILY"(오늘 하루 보지 않기) | "SESSION" | "ONCE"(다시 안 봄) | "ALWAYS"(매번)
/// audiences: "DIRECTOR,TEACHER,STUDENT" 중 콤마 조인(앱에서 뷰어 역할로 필터).
model SiteBanner {
  id          String  @id @default(cuid())
  title       String // 운영자용 내부 라벨
  type        String  @default("TEMPLATE") // "TEMPLATE" | "IMAGE"
  templateKey String? @map("template_key") // type=TEMPLATE 일 때 템플릿 종류
  content     Json    @default("{}") // 템플릿 필드 값(JSON)
  imageUrl    String? @map("image_url") @db.Text // type=IMAGE 공개 URL
  imageAlt    String? @map("image_alt")
  linkUrl     String? @map("link_url") @db.Text // 클릭 시 이동 대상(이미지/선택)
  audiences   String  @default("DIRECTOR") // 콤마 조인 역할 목록
  priority    Int     @default(0) // 낮을수록 먼저 노출
  isActive    Boolean @default(false) @map("is_active")
  dismissMode String  @default("DAILY") @map("dismiss_mode")
  showDismissButton Boolean @default(true) @map("show_dismiss_button")
  // 노출 범위: "ALL"(대상 역할 전체) | "SPECIFIC"(target_academy_ids 학원만)
  targetMode       String @default("ALL") @map("target_mode")
  targetAcademyIds Json   @default("[]") @map("target_academy_ids") // string[] academyId
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  autoOpenOnLowCredit Boolean @default(false) @map("auto_open_on_low_credit")
  createdByAdminId    String? @map("created_by_admin_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, priority])
  @@map("site_banners")
}

/// PlatformSetting — 전역 운영 설정 key-value 저장소(예: 기본 가입 크레딧).
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

/// PlatformAnnouncement — 스모트 운영진 → 전체 이용자 플랫폼 공지("스모트 소식").
/// 기존 학원 내부 Notice 를 대체한다. 원장/강사/학생/학부모가 각 앱에서 읽고,
/// 읽음 추적은 공지별 레코드 대신 프로필(Staff/Student/Parent)의
/// lastAnnouncementReadAt 타임스탬프 1개로 한다.
/// category: "UPDATE"(업데이트) | "MAINTENANCE"(점검) | "EVENT"(이벤트) | "GENERAL"(일반)
/// status: "DRAFT"(초안) | "PUBLISHED"(발행) | "ARCHIVED"(보관)
/// audiences: "ALL" 또는 "DIRECTOR,TEACHER,STUDENT,PARENT" 콤마 조인(SiteBanner 규약).
/// sourceType: "MANUAL"(직접 작성) | "RELEASE"(배포 시 release-notes 에서 자동 발행)
/// releaseSlug: 자동 발행 멱등성 키(파일 slug). 같은 slug 는 두 번 발행되지 않는다.
model PlatformAnnouncement {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text // 마크다운 본문
  category    String    @default("GENERAL")
  status      String    @default("DRAFT")
  publishedAt DateTime? @map("published_at") // 소급 게시용 과거 날짜 허용
  isPinned    Boolean   @default(false) @map("is_pinned")
  audiences   String    @default("ALL")
  sourceType  String    @default("MANUAL") @map("source_type")
  releaseSlug String?   @unique @map("release_slug")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, isPinned, publishedAt])
  @@map("platform_announcements")
}

// ============================================================================
// 21. SUBSCRIPTION & BILLING
// ============================================================================

/// SubscriptionPlan — Catalog of available plans
/// tier: "STARTER" | "STANDARD" | "PREMIUM" | "ENTERPRISE"
/// rolloverPolicy: "RESET" | "ROLLOVER" | "PARTIAL_ROLLOVER"
model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String // "스타터", "스탠다드", "프리미엄", "엔터프라이즈"
  tier            String   @unique // "STARTER" | "STANDARD" | "PREMIUM" | "ENTERPRISE"
  monthlyPrice    Int // KRW (matches credit top-up catalog defaults)
  monthlyCredits  Int // monthly credits (matches credit top-up catalog defaults)
  maxStudents     Int // 50, 150, 500, 99999
  maxStaff        Int // 3, 8, 20, 99999
  features        String   @db.Text // JSON: feature flags object
  rolloverPolicy  String   @default("RESET") // "RESET" | "ROLLOVER" | "PARTIAL_ROLLOVER"
  rolloverMaxRate Float    @default(0) // For PARTIAL_ROLLOVER: 0.2 = carry over up to 20%
  description     String?  @db.Text
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions AcademySubscription[]

  @@map("subscription_plans")
}

/// AcademySubscription — Active subscription per academy
/// status: "TRIAL" | "ACTIVE" | "PAST_DUE" | "CANCELLED" | "SUSPENDED"
model AcademySubscription {
  id                    String    @id @default(cuid())
  academyId             String
  planId                String
  billingKeyId          String?
  status                String    @default("TRIAL") // "TRIAL" | "ACTIVE" | "PAST_DUE" | "CANCELLED" | "SUSPENDED"
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  trialEndsAt           DateTime?
  cancelledAt           DateTime?
  graceEndsAt           DateTime? // Read-only access after expiry, before suspension
  paymentMethod         String? // "CARD" | "TRANSFER" | "KAKAO_PAY"
  paymentReference      String? // External payment system reference
  autoRenew             Boolean   @default(false)
  nextBillingPaymentId  String?
  nextBillingScheduleId String?
  nextBillingAt         DateTime?
  billingActivatedAt    DateTime?
  billingFailureMessage String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  academy              Academy               @relation(fields: [academyId], references: [id])
  plan                 SubscriptionPlan      @relation(fields: [planId], references: [id])
  billingKey           PortOneBillingKey?    @relation(fields: [billingKeyId], references: [id], onDelete: SetNull)
  subscriptionPayments SubscriptionPayment[]

  @@index([academyId])
  @@index([billingKeyId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([autoRenew, nextBillingAt])
  @@map("academy_subscriptions")
}

/// PortOneBillingKey — Card billing keys issued for subscription renewals
/// status: "ISSUED" | "DELETED" | "FAILED"
model PortOneBillingKey {
  id             String    @id @default(cuid())
  academyId      String
  billingKey     String    @unique
  issueId        String?   @unique
  issueName      String?
  status         String    @default("ISSUED")
  storeId        String
  channelKey     String?
  method         String    @default("CARD")
  customerId     String?
  issuedById     String?
  billingKeyInfo Json?
  customData     Json?
  issuedAt       DateTime?
  deletedAt      DateTime?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  academy              Academy               @relation(fields: [academyId], references: [id])
  subscriptions        AcademySubscription[]
  subscriptionPayments SubscriptionPayment[]
  webhookEvents        PortOneWebhookEvent[]

  @@index([academyId])
  @@index([status])
  @@index([customerId])
  @@map("portone_billing_keys")
}

/// SubscriptionPayment — 30-day subscription charges created from a billing key
/// status: "PENDING" | "SCHEDULED" | "PAID" | "FAILED" | "CANCELLED" | "REFUNDED"
model SubscriptionPayment {
  id                   String    @id @default(cuid())
  academyId            String
  subscriptionId       String
  billingKeyId         String?
  paymentId            String    @unique
  scheduleId           String?   @unique
  orderName            String
  amount               Int
  currency             String    @default("KRW")
  status               String    @default("PENDING")
  portoneStatus        String?
  portoneTransactionId String?
  paidAmount           Int?
  receiptUrl           String?
  failureCode          String?
  failureMessage       String?   @db.Text
  customData           Json?
  paymentPayload       Json?
  scheduledAt          DateTime?
  paidAt               DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  periodStart          DateTime
  periodEnd            DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  academy       Academy               @relation(fields: [academyId], references: [id])
  subscription  AcademySubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  billingKey    PortOneBillingKey?    @relation(fields: [billingKeyId], references: [id], onDelete: SetNull)
  webhookEvents PortOneWebhookEvent[]

  @@index([academyId])
  @@index([subscriptionId, createdAt])
  @@index([billingKeyId])
  @@index([status])
  @@index([scheduledAt])
  @@index([periodEnd])
  @@map("subscription_payments")
}

// ============================================================================
// 22. CREDIT SYSTEM
// ============================================================================

/// CreditBalance — Current credit state per academy (one row per academy)
model CreditBalance {
  id                 String    @id @default(cuid())
  academyId          String    @unique
  balance            Int       @default(0) // Current available credits
  monthlyAllocation  Int       @default(0) // Credits from subscription plan
  bonusCredits       Int       @default(0) // Remaining top-up credits
  totalConsumed      Int       @default(0) // Lifetime consumption
  totalAllocated     Int       @default(0) // Lifetime allocation
  lowCreditThreshold Int       @default(50) // Warning threshold
  lastResetAt        DateTime?
  // Single expiry timestamp shared by the whole balance. Each purchase / admin
  // grant with an expiry extends it by (remaining + granted days); promo/event
  // grants ride the existing value unchanged. null = no expiry (무기한).
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  academy Academy @relation(fields: [academyId], references: [id])

  @@map("credit_balances")
}

/// CreditTransaction — Immutable audit log of every credit movement
/// type: "ALLOCATION" | "CONSUMPTION" | "TOP_UP" | "ADJUSTMENT" | "REFUND" | "RESET" | "ROLLOVER"
model CreditTransaction {
  id            String   @id @default(cuid())
  academyId     String
  type          String // "ALLOCATION" | "CONSUMPTION" | "TOP_UP" | "ADJUSTMENT" | "REFUND" | "RESET" | "ROLLOVER"
  amount        Int // Positive = add, Negative = consume
  balanceAfter  Int // Snapshot of balance after this transaction
  operationType String? // "QUESTION_GEN_SINGLE" | "PASSAGE_ANALYSIS" | etc
  description   String?
  referenceId   String? // Related entity ID (questionId, passageId, etc.)
  referenceType String? // "QUESTION" | "PASSAGE" | "EXAM" | "CREDIT_TRANSACTION"
  staffId       String? // Staff member who triggered the operation
  adminId       String? // SuperAdmin who made manual adjustment
  metadata      String?  @db.Text // JSON: { model, inputTokens, outputTokens, costUsd, durationMs, promptHash }
  createdAt     DateTime @default(now())

  academy     Academy      @relation(fields: [academyId], references: [id])
  admin       SuperAdmin?  @relation("AdjustedBy", fields: [adminId], references: [id])
  creditTopUp CreditTopUp?

  @@index([academyId, createdAt])
  @@index([academyId, type])
  @@index([academyId, operationType])
  @@index([referenceId, referenceType])
  @@index([staffId])
  @@index([createdAt])
  @@map("credit_transactions")
}

/// CreditTopUp — Additional credit purchase records
/// status: "PENDING" | "WAITING_FOR_DEPOSIT" | "COMPLETED" | "FAILED" | "CANCELLED" | "REFUNDED"
model CreditTopUpProduct {
  id                String    @id @default(cuid())
  code              String    @unique
  name              String
  creditAmount      Int       @unique
  basePrice         Int
  description       String?   @db.Text
  // Credit validity in days from grant. On purchase the buyer's balance expiry
  // is extended by (remaining days + expiryDays). null/0 = no expiry (무기한).
  expiryDays        Int?
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // A product can run MANY promotions at once (different audience/link/window).
  // The old single-promotion columns (discountRate/bonusRate/promotion*) were
  // migrated into CreditPromotion rows and are no longer mapped here.
  promotions        CreditPromotion[]

  @@index([isActive, sortOrder])
  @@map("credit_top_up_products")
}

/// CreditPromotion — one promotion on a product. Multiple may run concurrently
/// with different audience/link/window. Effective one is resolved per viewer by
/// precedence (link match → priority → best buyer value → soonest end).
model CreditPromotion {
  id           String   @id @default(cuid())
  productId    String
  name         String?
  // 할인: PERCENT면 value=할인율%(0-99), AMOUNT면 value=할인 금액(원).
  discountType String   @default("PERCENT")
  discountValue Int     @default(0)
  // 크레딧 추가지급: PERCENT면 value=추가 지급률%(예 50=총150%), AMOUNT면 value=추가 크레딧 수.
  bonusType    String   @default("PERCENT")
  bonusValue   Int      @default(0)
  startsAt     DateTime
  endsAt       DateTime
  // "ALL" = everyone, "TARGETED" = only targets OR anyone with the link.
  audience     String   @default("ALL")
  // Shareable link token (/credits/promo/{token}) — one per promotion.
  linkToken    String?  @unique
  // Higher wins when several eligible promotions overlap for the same viewer.
  priority     Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product     CreditTopUpProduct          @relation(fields: [productId], references: [id], onDelete: Cascade)
  targets     CreditPromotionTarget[]
  bundleItems CreditPromotionBundleItem[]

  @@index([productId])
  @@index([linkToken])
  @@map("credit_promotions")
}

/// CreditPromotionBundle — several promotions exposed through ONE shareable
/// link (/credits/promo/b/{slug}) and landing page. Claiming the bundle seeds
/// every member promotion's linkToken into the promo cookie, so the existing
/// per-viewer pricing engine applies each one to its own product unchanged.
model CreditPromotionBundle {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?  @db.Text
  isActive         Boolean  @default(true)
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items CreditPromotionBundleItem[]

  @@map("credit_promotion_bundles")
}

/// CreditPromotionBundleItem — ordered membership of a promotion in a bundle.
/// Members must carry a linkToken (auto-issued on save) since the cookie and
/// pricing engine key off linkToken.
model CreditPromotionBundleItem {
  id          String @id @default(cuid())
  bundleId    String
  promotionId String
  sortOrder   Int    @default(0)

  bundle    CreditPromotionBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  promotion CreditPromotion       @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([bundleId, promotionId])
  @@index([promotionId])
  @@map("credit_promotion_bundle_items")
}

/// CreditPromotionTarget — academies explicitly targeted by a promotion (only
/// when audience = "TARGETED"). academyId is a plain indexed string (no FK) to
/// avoid coupling the large Academy model; targeting is equality on academyId.
model CreditPromotionTarget {
  id          String   @id @default(cuid())
  promotionId String
  academyId   String
  createdAt   DateTime @default(now())

  promotion CreditPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, academyId])
  @@index([academyId])
  @@map("credit_promotion_targets")
}

/// CreditPromotionLinkEvent — 프로모션/번들 공유 링크에 대한 사용자 활동 로그.
/// "VIEW"=랜딩(/credits/promo/...) 방문, "CLAIM"="혜택 받기" 버튼 클릭.
/// 로그인한 원장이면 staffId/academyId 를 스냅샷하고, 비로그인(익명)이면 그
/// 값이 null 이며 visitorKey(IP+UA 해시)로만 순 방문자를 근사한다. 링크가
/// 재발급돼도 집계가 끊기지 않도록 token 이 아니라 promotionId/bundleId 로 묶는다.
model CreditPromotionLinkEvent {
  id          String   @id @default(cuid())
  kind        String   @default("VIEW") // "VIEW" | "CLAIM"
  targetType  String   @default("PROMO") // "PROMO" | "BUNDLE"
  promotionId String? // targetType=PROMO 일 때
  bundleId    String? // targetType=BUNDLE 일 때
  linkRef     String // 클릭된 식별자: 프로모션=linkToken, 번들=slug (감사용 원본)
  staffId     String? // 로그인한 원장 (익명이면 null)
  academyId   String?
  academyName String? // 표시용 스냅샷
  visitorName String? // staff 이름 스냅샷
  visitorKey  String? // 순 방문자 근사(로그인=staff:{id}, 익명=ip+ua+날짜 해시)
  createdAt   DateTime @default(now())

  @@index([promotionId])
  @@index([bundleId])
  @@index([academyId])
  @@index([staffId])
  @@index([createdAt])
  @@map("credit_promotion_link_events")
}

model CreditTopUp {
  id                   String    @id @default(cuid())
  academyId            String
  creditAmount         Int // Credits purchased
  price                Int // KRW paid
  paymentMethod        String? // "CARD" | "TRANSFER" | "VIRTUAL_ACCOUNT" | "EASY_PAY" | "MOBILE"
  paymentReference     String? // External transaction ID
  paymentId            String?   @unique // PortOne paymentId generated by us
  orderName            String?
  storeId              String?
  channelKey           String?
  currency             String    @default("KRW")
  portoneStatus        String?
  portoneTransactionId String?
  paidAmount           Int?
  receiptUrl           String?
  failureCode          String?
  failureMessage       String?   @db.Text
  customData           Json?
  paymentPayload       Json?
  status               String    @default("PENDING") // "PENDING" | "WAITING_FOR_DEPOSIT" | "COMPLETED" | "FAILED" | "CANCELLED" | "REFUNDED"
  completedAt          DateTime?
  verifiedAt           DateTime?
  paidAt               DateTime?
  cancelledAt          DateTime?
  requestedBy          String? // staffId
  creditTransactionId  String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  academy           Academy               @relation(fields: [academyId], references: [id])
  creditTransaction CreditTransaction?    @relation(fields: [creditTransactionId], references: [id])
  webhookEvents     PortOneWebhookEvent[]
  bankDeposits      BankDepositNotification[]

  @@index([academyId])
  @@index([academyId, status, createdAt])
  @@index([status])
  @@index([portoneStatus])
  @@map("credit_top_ups")
}

/// PortOneWebhookEvent — idempotent audit log for PortOne V2 webhooks
/// status: "RECEIVED" | "PROCESSED" | "IGNORED" | "FAILED"
model PortOneWebhookEvent {
  id                    String    @id @default(cuid())
  webhookId             String    @unique
  paymentId             String?
  billingKey            String?
  topUpId               String?
  billingKeyId          String?
  subscriptionPaymentId String?
  eventType             String
  status                String    @default("RECEIVED")
  headers               Json?
  payload               Json?
  errorMessage          String?   @db.Text
  receivedAt            DateTime  @default(now())
  processedAt           DateTime?

  topUp               CreditTopUp?         @relation(fields: [topUpId], references: [id], onDelete: SetNull)
  billingKeyRecord    PortOneBillingKey?   @relation(fields: [billingKeyId], references: [id], onDelete: SetNull)
  subscriptionPayment SubscriptionPayment? @relation(fields: [subscriptionPaymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([billingKey])
  @@index([topUpId])
  @@index([billingKeyId])
  @@index([subscriptionPaymentId])
  @@index([status, receivedAt])
  @@map("portone_webhook_events")
}

/// BankDepositNotification — inbound bank deposit alerts (무통장입금 자동확인)
/// Relayed from a bank SMS/push forwarder. Idempotent on externalId.
/// status: "MATCHED" | "UNMATCHED" | "AMBIGUOUS" | "IGNORED" | "FAILED"
model BankDepositNotification {
  id             String    @id @default(cuid())
  externalId     String    @unique // dedup key from relay (SMS hash / provider id)
  source         String    @default("sms") // relay channel
  rawText        String    @db.Text
  amount         Int // 입금 금액 (원)
  depositorName  String? // 입금자명 (정규화 전 원본)
  bankName       String?
  status         String    @default("UNMATCHED") // "UNMATCHED" | "MATCHED" | "MANUAL_GRANT" | "AMBIGUOUS" | "IGNORED" | "FAILED"
  matchedTopUpId String? // CreditTopUp matched & credited
  note           String?   @db.Text
  occurredAt     DateTime? // 은행이 알려준 입금 시각
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  matchedTopUp CreditTopUp? @relation(fields: [matchedTopUpId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@index([amount])
  @@index([matchedTopUpId])
  @@map("bank_deposit_notifications")
}

// ============================================================================
// 22-b. GROWTH — REFERRAL, CREDIT MISSIONS, NOTIFICATIONS
// ============================================================================

/// ReferralCode — one stable, shareable referral code per academy.
/// Credits are on-platform-only (자기적립 마일리지 → VAT-excluded, no 기타소득 withholding).
model ReferralCode {
  id               String   @id @default(cuid())
  academyId        String   @unique
  code             String   @unique
  createdByStaffId String?
  totalClicks      Int      @default(0)
  totalSignups     Int      @default(0)
  totalRewarded    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academy   Academy    @relation(fields: [academyId], references: [id])
  referrals Referral[]

  @@index([code])
  @@map("referral_codes")
}

/// Referral — one referred-academy conversion + reward state machine.
/// Single-hop give-get only (no multi-tier → outside 다단계판매법).
/// status: "GRANTED" | "HELD" | "APPROVED" | "REJECTED" | "CLAWED_BACK"
model Referral {
  id                String    @id @default(cuid())
  referralCodeId    String
  referrerAcademyId String
  referredAcademyId String    @unique // idempotency: each new academy can be referred at most once
  referredStaffId   String?
  referrerReward    Int       @default(0)
  referredReward    Int       @default(0)
  status            String    @default("GRANTED")
  fraudScore        Int       @default(0)
  fraudSignals      Json?
  referrerTxId      String? // CreditTransaction id of the referrer grant
  referredTxId      String? // CreditTransaction id of the new academy welcome grant
  signupIp          String?
  signupUserAgent   String?   @db.Text
  grantedAt         DateTime?
  reviewedByAdminId String?
  reviewNote        String?   @db.Text
  reviewedAt        DateTime?
  clawedBackAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  referralCode    ReferralCode @relation(fields: [referralCodeId], references: [id])
  referrerAcademy Academy      @relation("ReferralsMade", fields: [referrerAcademyId], references: [id])
  referredAcademy Academy      @relation("ReferralReceived", fields: [referredAcademyId], references: [id])

  @@index([referrerAcademyId, createdAt])
  @@index([status, createdAt])
  @@index([referralCodeId])
  @@map("referrals")
}

/// CreditMission — admin-managed catalog of credit-earning missions.
/// cadence: "ONCE" | "DAILY" | "EVENT"   category: "ONBOARDING" | "DAILY" | "REFERRAL" | "EXPLORE"
model CreditMission {
  id                String   @id @default(cuid())
  key               String   @unique
  title             String
  description       String?  @db.Text
  category          String
  cadence           String
  rewardCredits     Int
  iconKey           String?
  actionUrl         String?
  ctaLabel          String?
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  maxRewardPerMonth Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("credit_missions")
}

/// AcademyMissionClaim — idempotent per-academy mission completion.
/// periodKey = "ONCE" for one-time missions, or KST date "2026-06-18" for DAILY.
model AcademyMissionClaim {
  id               String   @id @default(cuid())
  academyId        String
  missionKey       String
  periodKey        String
  rewardCredits    Int
  creditTxId       String?
  claimedByStaffId String?
  createdAt        DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id])

  @@unique([academyId, missionKey, periodKey])
  @@index([academyId, createdAt])
  @@map("academy_mission_claims")
}

/// Notification — per-staff inbox (fan-out-on-write).
/// category: "MISSION" | "REFERRAL" | "SYSTEM" | "BILLING"
model Notification {
  id               String    @id @default(cuid())
  academyId        String
  recipientStaffId String
  category         String
  type             String
  title            String
  body             String?   @db.Text
  iconKey          String?
  actionUrl        String?
  data             Json?
  groupKey         String?
  readAt           DateTime?
  archivedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  academy        Academy @relation(fields: [academyId], references: [id])
  recipientStaff Staff   @relation(fields: [recipientStaffId], references: [id])

  @@index([recipientStaffId, createdAt])
  @@index([recipientStaffId, readAt])
  @@index([academyId, createdAt])
  @@map("notifications")
}

/// NotificationState — per-staff badge state. Bell "unseen" count = notifications created after lastSeenAt.
model NotificationState {
  staffId    String    @id
  lastSeenAt DateTime?
  updatedAt  DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id])

  @@map("notification_states")
}

// ============================================================================
// 23. ACADEMY REGISTRATION
// ============================================================================

/// AcademyRegistration — Pending registration requests from new academies
/// status: "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED"
model AcademyRegistration {
  id                String    @id @default(cuid())
  // Academy info
  academyName       String
  businessNumber    String? // 사업자등록번호
  phone             String
  address           String?
  district          String? // Extracted Seoul district (e.g. "강남구") for campaign tracking
  estimatedStudents Int?
  // Director info
  directorName      String
  directorEmail     String
  directorPhone     String
  // Request
  message           String?   @db.Text
  desiredPlan       String? // Requested tier
  // Review
  status            String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED"
  reviewedById      String?
  reviewNote        String?   @db.Text
  reviewedAt        DateTime?
  // Result (set on approval)
  academyId         String? // Created Academy ID
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reviewedBy SuperAdmin? @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([district])
  @@index([desiredPlan])
  @@map("academy_registrations")
}

// ============================================================================
// 24. BULK PASSAGE EXTRACTION — PDF/image → passages pipeline
// ============================================================================

/// ExtractionJob — 하나의 "대량 추출" 요청 단위
/// status: "PENDING" | "PROCESSING" | "COMPLETED" | "PARTIAL" | "FAILED" | "CANCELLED"
/// sourceType: "PDF" | "IMAGES"
/// mode: "PASSAGE_ONLY" | "QUESTION_SET" | "EXPLANATION" | "FULL_EXAM"
///   - PASSAGE_ONLY (M1): 본문만 뽑아 지문 라이브러리에 적재
///   - QUESTION_SET  (M2): 지문+문제+선지(+정답) → 문제 은행
///   - EXPLANATION   (M3): 해설지 → 기존 Question에 매핑
///   - FULL_EXAM     (M4): 지문+문제+시험지(Exam) 통째
model ExtractionJob {
  id          String @id @default(cuid())
  academyId   String
  createdById String // staff.id

  sourceType       String // "PDF" | "IMAGES"
  mode             String  @default("PASSAGE_ONLY") // M1 ~ M4 (see header)
  originalFileUrl  String? @db.Text // Supabase Storage path for source PDF
  originalFileName String?

  /// Teacher-editable label for the job ("5월 모의고사" 등). Null = fall back
  /// to `originalFileName` in the UI. Original file name is preserved for
  /// audit / debugging.
  displayName String?

  // Upstream "a single exam / worksheet" it materialises into.
  // Populated by extraction-finalize when the job reaches a terminal state.
  sourceMaterialId String?

  // ── Adaptive intake (additive, read only when EXTRACTION_ADAPTIVE_INTAKE on) ──
  /// Routing/audit hint. "IMAGE_SINGLE" | "IMAGES" | "PDF" | "TEXT".
  inputType String?
  /// Frozen IntakePlan snapshot (passage count, boundaries, layout, segments)
  /// confirmed by the user before extraction — for re-commit/audit/replay.
  intakePlan Json?
  /// AI triage confidence (0~1) used to pick the surface / fallback.
  triageConfidence Float?
  /// Triage-estimated passage count — progress denominator before real count.
  estimatedPassageCount Int?
  /// (P7-D2) 추출 산출물 모드(잡 단위 "기본 의도"). "verbatim"(원문 그대로) | "restored"(AI 복원).
  /// 진실의 소스는 지문별(Passage.extractionOutput / Draft.restorationStatus).
  /// null = 미전달(비적응 흐름) → finalize는 기존 자동복원 휴리스틱 유지.
  outputMode String?
  /// 문제생성 페이지 발(發) 잡: finalize가 drafts를 서버에서 곧바로 Passage로 승격한다.
  /// 클라이언트 폴링 승격(useGenerateExtraction)은 표시/폴백용 — 페이지 이탈로 폴링이
  /// 죽어도 결과가 고아가 되지 않게 하는 게 목적. 자료추출(import) 잡은 false(수동 검수).
  autoPromote Boolean @default(false)

  status       String @default("PENDING")
  totalPages   Int
  successPages Int    @default(0)
  failedPages  Int    @default(0)
  pendingPages Int // init = totalPages

  creditsReserved Int @default(0) // pre-flight projected cost (not actually charged)
  creditsConsumed Int @default(0) // sum of restoration charges
  creditsRefunded Int @default(0) // sum of restoration refunds

  concurrencyLimit Int     @default(5)
  triggerRunId     String? @db.Text // Trigger.dev orchestrator run handle (cancel/cleanup)

  errorSummary String? @db.Text // JSON summary of errors

  /// Free-form metadata for job-scoped extras. Currently stores the list
  /// preview thumbnail info written by create-job
  /// (`{ previewImageUrl, previewMimeType, previewImageBytes }`) and read
  /// by list-jobs for the 자료 목록 card thumbnails.
  metadata Json?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  academy         Academy                    @relation(fields: [academyId], references: [id])
  createdBy       Staff                      @relation("ExtractionJobCreator", fields: [createdById], references: [id])
  sourceMaterial  SourceMaterial?            @relation(fields: [sourceMaterialId], references: [id])
  pages           ExtractionPage[]
  results         ExtractionResult[]
  items           ExtractionItem[]
  m1PassageDrafts ExtractionM1PassageDraft[]
  passageDrafts   ExtractionPassageDraft[]
  questionDrafts  ExtractionQuestionDraft[]

  @@index([academyId, status])
  @@index([academyId, createdAt])
  @@index([academyId, deletedAt, createdAt])
  @@index([deletedAt])
  @@index([status, createdAt])
  @@index([sourceMaterialId])
  @@map("extraction_jobs")
}

/// ExtractionPage — 페이지 1장 = Gemini 호출 1회 단위 (원자 단위)
/// status: "PENDING" | "PROCESSING" | "SUCCESS" | "FAILED" | "DEAD" | "SKIPPED"
/// idempotencyKey = `${jobId}:${pageIndex}` — UNIQUE로 3중 방어선의 2차 방벽 역할
model ExtractionPage {
  id             String  @id @default(cuid())
  jobId          String
  pageIndex      Int // 0-based 순서
  imageUrl       String  @db.Text // Supabase Storage key (not public URL)
  imageBytes     Int?
  sourceFileName String?

  status       String @default("PENDING")
  attemptCount Int    @default(0)
  maxAttempts  Int    @default(3)

  // ─── 멱등성 핵심 ──────────────────────────────
  idempotencyKey String // `${jobId}:${pageIndex}` — UNIQUE
  leaseOwner     String? // Trigger.dev run id
  leaseExpiresAt DateTime? // stuck lease 복구용

  // ─── 결과 ─────────────────────────────────────
  extractedText String? @db.Text
  confidence    Float?
  modelUsed     String?
  inputTokens   Int?
  outputTokens  Int?
  /// 이 페이지 OCR 호출들의 실측 청구액 합(USD) — OpenRouter usage.cost.
  /// platform-api-costs sync 가 recordedCostUsd(RECORDED 단가)로 흡수한다.
  aiCostUsd     Decimal? @db.Decimal(12, 8)
  latencyMs     Int?

  /// Per-page metadata captured by the structured OCR call (pageNumber /
  /// pageTotal / examCode / subject / etc.). Used by finalize to reorder
  /// mixed-up uploads and to cluster pages by exam fingerprint.
  pageMeta Json?

  // ── Adaptive intake — D4 多페이지 묶음(bundle) 입력 표식 (additive) ──
  /// Non-null marks this page row as a bundle member dispatched in one OCR call.
  /// Members of one bundle share the same key. Null = legacy single-page path.
  bundleKey String?
  /// Real source pageIndexes a bundle row sends together (e.g. [4,5]). Empty for
  /// single-page rows. The bundle row itself may use a reserved virtual pageIndex.
  spanPageIndices Int[] @default([])

  /// Raw OCR text returned by Document AI BEFORE Gemini classification.
  /// Stored for debugging: lets us tell whether a missing marker / word
  /// was lost in Document AI (vision limit) or stripped by Gemini classify
  /// (LLM tendency overriding prompt). Null when Document AI was not used.
  documentAiRawText String? @db.Text

  // ─── 크레딧 연결(legacy) ──────────────────────
  creditTxId String? // Legacy OCR charge link. New pure OCR jobs leave this null.

  // ─── 에러 ─────────────────────────────────────
  errorCode    String?
  errorMessage String? @db.Text

  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  job   ExtractionJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  items ExtractionItem[]

  @@unique([idempotencyKey])
  @@unique([jobId, pageIndex])
  @@index([jobId, status])
  @@index([status, leaseExpiresAt])
  @@map("extraction_pages")
}

/// ExtractionResult — 지문 단위 결과 (세그멘테이션 후 산출물)
/// status: "DRAFT" | "REVIEWED" | "SAVED" | "SKIPPED"
model ExtractionResult {
  id           String @id @default(cuid())
  jobId        String
  passageOrder Int // job 내 정렬

  sourcePageIndex Int[] // 예: [3,4,5] — 여러 페이지 걸친 지문 지원

  title   String?
  content String  @db.Text
  meta    Json? // { markerDetected, mergedFromPages, confidenceNote }

  confidence     Float?
  status         String  @default("DRAFT")
  savedPassageId String? // Passage.id after commit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job           ExtractionJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  passageDrafts ExtractionPassageDraft[]

  @@index([jobId, passageOrder])
  @@index([jobId, status])
  @@map("extraction_results")
}

// ============================================================================
// 25. EXTRACTION ITEMS — granular block-level representation
// ============================================================================
// Replaces the legacy ExtractionResult for new jobs. Each extracted document
// is represented as a tree of typed blocks (passage body, question stem,
// choice, explanation, exam meta, etc.) with parent/child relationships so
// the review UI can classify, regroup, and promote them into proper Passage /
// Question / QuestionExplanation / SourceMaterial records.
// ============================================================================

/// ExtractionItem — a typed block emitted by segmentation
/// blockType: "PASSAGE_BODY" | "QUESTION_STEM" | "CHOICE" | "EXPLANATION" | "EXAM_META" | "HEADER" | "FOOTER" | "DIAGRAM" | "NOISE"
/// status:    "DRAFT" | "REVIEWED" | "PROMOTED" | "SKIPPED" | "MERGED"
model ExtractionItem {
  id              String  @id @default(cuid())
  jobId           String
  pageId          String? // ExtractionPage.id (null when item spans multiple pages)
  sourcePageIndex Int[] // supports multi-page items

  // ─── Identity ────────────────────────────────
  blockType    String
  groupId      String? // passage↔question↔choice clustering key (job-scoped)
  parentItemId String? // CHOICE → QUESTION_STEM / EXPLANATION → QUESTION_STEM

  order      Int // global order within job
  localOrder Int? // position within parent group (1st choice, 2nd choice, ...)

  // ─── Content ─────────────────────────────────
  title   String?
  content String  @db.Text // editable final text (what review UI shows)
  rawText String? @db.Text // original OCR text — preserved verbatim

  // ─── Type-specific metadata (Json, validated per blockType in app layer) ──
  questionMeta Json? // { number, points, pattern, answerChoice, ... }
  choiceMeta   Json? // { index, label, isAnswer }
  passageMeta  Json? // { wordCount, paragraphCount, markerDetected }
  examMeta     Json? // { subject, grade, year, round, publisher, school }

  boundingBox Json? // { page, x, y, w, h } — click-to-highlight in viewer

  // ── Adaptive intake (additive) ──
  /// Normalized crop rectangle {x,y,w,h} in 0~1 (EXIF-corrected). The region a
  /// user marqueed on a page; the OCR input for crop segments. Distinct from
  /// boundingBox (viewer highlight only) to avoid overloading. (D-G2)
  cropBox Json?
  /// "page" | "span" | "crop" | "text-block" | "manual" — how this segment was
  /// produced, so the review UI and bench can reason about provenance.
  segmentKind String?
  /// Why a block was flagged incomplete: "LENGTH" | "CROP_SIGNAL" | "LOW_OCR"
  /// | "SKEW" | "NON_TERMINAL". Replaces the old silent length-only discard. (G4)
  incompleteReason String?

  // ─── Quality ────────────────────────────────
  confidence  Float?
  needsReview Boolean @default(false)
  status      String  @default("DRAFT")

  // ─── Promotion tracking ─────────────────────
  // URN string — e.g. "Passage:clxxxxx" / "Question:clxxxxx" / "QuestionExplanation:clxxxxx"
  promotedTo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job      ExtractionJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  page     ExtractionPage?  @relation(fields: [pageId], references: [id], onDelete: SetNull)
  parent   ExtractionItem?  @relation("ItemTree", fields: [parentItemId], references: [id], onDelete: SetNull)
  children ExtractionItem[] @relation("ItemTree")

  @@index([jobId, order])
  @@index([jobId, blockType])
  @@index([jobId, groupId])
  @@index([parentItemId])
  @@map("extraction_items")
}

// ============================================================================
// 26. SOURCE MATERIAL — "a single exam / textbook / worksheet" as first-class citizen
// ============================================================================
// Every Passage / Question / Exam that originated from a physical document
// points back to one SourceMaterial. This is the hub that lets us answer
// "where did this passage come from?" and "show me everything from that exam"
// without denormalising metadata into every child row.
// ============================================================================

/// SourceMaterial — one physical source document (exam paper, textbook chapter, handout)
/// type: "EXAM" | "TEXTBOOK" | "WORKBOOK" | "HANDOUT" | "MOCK" | "SUNEUNG" | "OTHER"
/// subject: "ENGLISH" | "KOREAN" | "MATH" | "OTHER"
/// examType: "MIDTERM" | "FINAL" | "MOCK" | "SUNEUNG" | "DIAGNOSTIC" | "EBS" | "PRIVATE"
model SourceMaterial {
  id        String  @id @default(cuid())
  academyId String
  schoolId  String?

  type        String
  title       String
  /// Teacher-set override displayed in the 자료 관리 (extraction-manage) page.
  /// Auto-set `title` (extraction AI guess) is unreliable, so the manage UI
  /// reads `customLabel` first and falls back to a derived "{job name} 시험지 N"
  /// label. Other pages keep using `title`.
  customLabel String?
  subtitle    String?

  // Common metadata (first-class columns for fast filtering)
  subject   String? @default("ENGLISH")
  grade     Int?
  semester  String? // "FIRST" | "SECOND"
  year      Int?
  round     String? // "6월", "9월", "11월" or "1회", "2회"
  examType  String?
  publisher String?
  sourceRef String? // free-form reference (URL, ISBN, distributor)

  // Extraction linkage
  originalFileUrl String? @db.Text // archived PDF in Supabase Storage
  contentHash     String? // sha1 of concatenated extracted texts — duplicate detection

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy   Academy @relation(fields: [academyId], references: [id])
  school    School? @relation(fields: [schoolId], references: [id])
  createdBy Staff?  @relation("SourceMaterialCreator", fields: [createdById], references: [id])

  bundles         PassageBundle[]
  passages        Passage[]
  questions       Question[]
  exams           Exam[]
  extractionJobs  ExtractionJob[]
  m1PassageDrafts ExtractionM1PassageDraft[]
  passageDrafts   ExtractionPassageDraft[]

  @@unique([academyId, contentHash], name: "academy_content_hash_unique")
  @@index([academyId, type])
  @@index([academyId, grade, year])
  @@index([academyId, createdAt])
  @@index([schoolId])
  @@index([contentHash])
  @@map("source_materials")
}

// ============================================================================
// 27. PASSAGE BUNDLE — a passage + its shared questions (e.g. CSAT [2~4])
// ============================================================================

/// PassageBundle — groups one passage with its sharing questions, scoped per source
/// A single Passage can appear in multiple bundles (reused across exams).
model PassageBundle {
  id               String  @id @default(cuid())
  sourceMaterialId String
  passageId        String
  orderInMaterial  Int // order within the source (e.g. passage #2 on the exam)
  sharedLabel      String? // "[32~34]" label as printed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceMaterial SourceMaterial @relation(fields: [sourceMaterialId], references: [id], onDelete: Cascade)
  passage        Passage        @relation(fields: [passageId], references: [id], onDelete: Cascade)
  questions      Question[]     @relation("BundleQuestions")

  @@unique([sourceMaterialId, passageId])
  @@index([sourceMaterialId])
  @@index([passageId])
  @@map("passage_bundles")
}

/// QuestionSet — one shared passage carrying N ordered questions (장문 세트; generalizes CSAT 43~45).
/// canonicalPassage is the ordered source and is NEVER shown to students (would leak SENTENCE_ORDER).
/// displayedPassageLayout (JSON LayoutDescriptor) is the visible base every member anchors into.
/// status: "OK" | "DEGRADED" (anchor resolution failed → manual review required).
model QuestionSet {
  id                     String   @id @default(cuid())
  jobId                  String? // generation lineage → WorkbenchAiJob (nullable: hand-assembled sets)
  academyId              String
  structuralMode         String   @default("NONE") // "NONE" | "SENTENCE_ORDER" | "SENTENCE_INSERT"
  canonicalPassage       String   @db.Text // ordered; never rendered to students
  displayedPassageLayout String   @db.Text // JSON LayoutDescriptor; the visible base
  layoutFingerprint      String // sha256(displayedPassageLayout) — anchor-resolution gate
  itemCount              Int      @default(0)
  setLabel               String? // "[43~45]" — printed group header
  basePassageId          String? // optional: structural member promoted to a stored Passage (Phase 7+)
  status                 String   @default("OK")

  /// 문제 세트 과목 — null=ENGLISH(기존 세트 전부·영어 무회귀), "KOREAN"=국어 세트.
  /// passages.subject 규약. surgical ALTER (migrate deploy / db push 금지):
  ///   ALTER TABLE question_sets ADD COLUMN IF NOT EXISTS subject text;  (ko-exam-set-subject.sql)
  subject                String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  job         WorkbenchAiJob?   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  academy     Academy           @relation(fields: [academyId], references: [id])
  basePassage Passage?          @relation("SetBasePassage", fields: [basePassageId], references: [id], onDelete: SetNull)
  items       QuestionSetItem[]

  @@index([jobId])
  @@index([academyId])
  @@map("question_sets")
}

/// QuestionSetItem — one member of a set. spans are RE-DERIVABLE ANCHORS (never absolute offsets).
/// isStructural=true => this member DEFINES displayedPassageLayout (글의 순서 / 문장 삽입).
model QuestionSetItem {
  id           String   @id @default(cuid())
  setId        String
  questionId   String   @unique // one Question ⇄ one set membership
  orderInSet   Int // 0-indexed; SPARSE allowed after deletes (0,1,3)
  isStructural Boolean  @default(false)
  spans        Json? // Array<Anchor>; authoritative anchor store
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  set      QuestionSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  question Question    @relation("SetItemQuestion", fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([setId, orderInSet])
  @@index([setId])
  @@map("question_set_items")
}

// ============================================================================
// 28. M1 PASSAGE EXTRACTION DRAFTS — raw + restored passage pairs
// ============================================================================

/// ExtractionM1PassageDraft — one passage result from M1 extraction.
/// Stores both the raw extracted text and the restored text used for review.
model ExtractionM1PassageDraft {
  id               String  @id @default(cuid())
  jobId            String
  sourceMaterialId String?

  passageOrder    Int
  sourcePageIndex Int[]

  title        String?
  rawText      String  @db.Text
  restoredText String  @db.Text
  teacherText  String  @db.Text

  restorationStatus String @default("RESTORED")
  reviewStatus      String @default("DRAFT")
  confidence        Float?
  warnings          Json?
  metadata          Json?

  confirmedAt    DateTime?
  savedPassageId String?
  /// (P7-D2) AI 복원 차감 CreditTransaction.id. null=미과금. 환불 후 null 복원.
  /// Pure OCR/Document AI does not set a credit transaction.
  restorationCreditTxId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  deletedById    String?

  job             ExtractionJob                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceMaterial  SourceMaterial?                  @relation(fields: [sourceMaterialId], references: [id], onDelete: SetNull)
  changes         ExtractionM1PassageDraftChange[]
  sourceMatches   ExtractionM1PassageSourceMatch[]
  collectionItems M1PassageDraftCollectionItem[]

  @@unique([jobId, passageOrder])
  @@index([jobId])
  @@index([jobId, deletedAt])
  @@index([sourceMaterialId])
  @@index([reviewStatus])
  @@index([deletedAt])
  @@map("extraction_m1_passage_drafts")
}

/// ExtractionM1PassageDraftChange — restorable before/after spans for UI highlights.
model ExtractionM1PassageDraftChange {
  id             String @id @default(cuid())
  passageDraftId String

  sentenceOrder Int?
  before        String  @db.Text
  after         String  @db.Text
  changeType    String?
  reason        String? @db.Text
  confidence    Float?

  sourcePageIndex Int[]
  createdAt       DateTime @default(now())

  passageDraft ExtractionM1PassageDraft @relation(fields: [passageDraftId], references: [id], onDelete: Cascade)

  @@index([passageDraftId])
  @@map("extraction_m1_passage_draft_changes")
}

/// ExtractionAuditLog — Append-only audit trail for destructive or
/// membership-changing extraction review actions.
/// action: "M1_DRAFT_DELETE" | "M1_DRAFT_BULK_DELETE" |
///         "M1_DRAFT_REMOVE_FROM_COLLECTION" | "EXTRACTION_JOB_DELETE"
model ExtractionAuditLog {
  id           String  @id @default(cuid())
  academyId    String
  actorStaffId String?

  action      String
  targetType  String
  targetId    String
  targetLabel String?
  metadata    Json?

  createdAt DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  actor   Staff?  @relation("ExtractionAuditActor", fields: [actorStaffId], references: [id], onDelete: SetNull)

  @@index([academyId, createdAt])
  @@index([actorStaffId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("extraction_audit_logs")
}

model ExtractionM1PassageSourceMatch {
  id             String @id @default(cuid())
  passageDraftId String

  sourceType String
  sourceId   String?
  sourceRef  String? @db.Text
  title      String?
  publisher  String?
  unit       String?
  year       Int?
  confidence Float?
  method     String
  reason     String? @db.Text
  selected   Boolean @default(false)
  metadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passageDraft ExtractionM1PassageDraft @relation(fields: [passageDraftId], references: [id], onDelete: Cascade)

  @@index([passageDraftId])
  @@index([sourceId])
  @@map("extraction_m1_passage_source_matches")
}

// ============================================================================
// 29. M2 EXTRACTION DRAFTS — review-first passage + question registration
// ============================================================================

/// ExtractionPassageDraft — restored passage candidate created from M2.
/// The final Passage row is created later, after teacher review/registration.
model ExtractionPassageDraft {
  id                 String  @id @default(cuid())
  jobId              String
  extractionResultId String?
  sourceMaterialId   String?

  passageOrder    Int
  sourcePageIndex Int[]

  problemText        String  @db.Text
  restoredText       String? @db.Text
  teacherText        String? @db.Text
  restorationStatus  String  @default("PENDING")
  verificationStatus String  @default("PENDING")
  reviewStatus       String  @default("DRAFT")

  confidence Float?
  warnings   Json?
  metadata   Json?

  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  job              ExtractionJob                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  extractionResult ExtractionResult?              @relation(fields: [extractionResultId], references: [id], onDelete: SetNull)
  sourceMaterial   SourceMaterial?                @relation(fields: [sourceMaterialId], references: [id], onDelete: SetNull)
  sentences        ExtractionPassageSentence[]
  questions        ExtractionQuestionDraft[]
  restoration      ExtractionPassageRestoration?
  sourceMatches    ExtractionPassageSourceMatch[]

  @@unique([jobId, passageOrder])
  @@index([jobId])
  @@index([sourceMaterialId])
  @@index([reviewStatus])
  @@map("extraction_passage_drafts")
}

/// ExtractionQuestionDraft — question candidate linked to an M2 passage draft.
/// The final Question row is created later, after teacher review/registration.
model ExtractionQuestionDraft {
  id             String  @id @default(cuid())
  jobId          String
  passageDraftId String?

  questionOrder   Int
  questionNumber  Int?
  sourcePageIndex Int[]

  stem         String  @db.Text
  choices      Json?
  answer       String? @db.Text
  explanation  String? @db.Text
  questionType String?

  confidence   Float?
  warnings     Json?
  reviewStatus String @default("DRAFT")
  metadata     Json?

  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  job          ExtractionJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  passageDraft ExtractionPassageDraft? @relation(fields: [passageDraftId], references: [id], onDelete: SetNull)

  @@unique([jobId, questionOrder])
  @@index([jobId])
  @@index([passageDraftId])
  @@index([reviewStatus])
  @@map("extraction_question_drafts")
}

/// ExtractionPassageSentence — sentence-numbered review view for a passage draft.
model ExtractionPassageSentence {
  id             String @id @default(cuid())
  passageDraftId String
  order          Int

  problemText  String? @db.Text
  restoredText String  @db.Text
  status       String  @default("OK")
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passageDraft ExtractionPassageDraft @relation(fields: [passageDraftId], references: [id], onDelete: Cascade)

  @@unique([passageDraftId, order])
  @@index([passageDraftId])
  @@map("extraction_passage_sentences")
}

/// ExtractionPassageRestoration — one restoration attempt/result per passage draft.
model ExtractionPassageRestoration {
  id             String @id @default(cuid())
  passageDraftId String @unique

  method     String
  status     String
  confidence Float?

  originalText      String  @db.Text
  restoredText      String  @db.Text
  modelUsed         String?
  unresolvedMarkers Json?
  warnings          Json?
  rawResponse       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passageDraft ExtractionPassageDraft               @relation(fields: [passageDraftId], references: [id], onDelete: Cascade)
  changes      ExtractionPassageRestorationChange[]

  @@index([status])
  @@map("extraction_passage_restorations")
}

/// ExtractionPassageRestorationChange — auditable before/after restoration diff.
model ExtractionPassageRestorationChange {
  id            String @id @default(cuid())
  restorationId String

  sentenceOrder          Int?
  before                 String  @db.Text
  after                  String  @db.Text
  reason                 String? @db.Text
  evidenceQuestionNumber Int?
  evidenceType           String?
  confidence             Float?

  createdAt DateTime @default(now())

  restoration ExtractionPassageRestoration @relation(fields: [restorationId], references: [id], onDelete: Cascade)

  @@index([restorationId])
  @@map("extraction_passage_restoration_changes")
}

/// ExtractionPassageSourceMatch — candidate source/original match for a draft.
model ExtractionPassageSourceMatch {
  id             String @id @default(cuid())
  passageDraftId String

  sourceType String
  sourceId   String?
  sourceRef  String? @db.Text
  title      String?
  publisher  String?
  unit       String?
  year       Int?
  confidence Float?
  method     String
  reason     String? @db.Text
  selected   Boolean @default(false)
  metadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passageDraft ExtractionPassageDraft @relation(fields: [passageDraftId], references: [id], onDelete: Cascade)

  @@index([passageDraftId])
  @@index([sourceId])
  @@map("extraction_passage_source_matches")
}

// ============================================================================
// 25. WEBTOON — AI-generated multi-panel webtoon images per passage
// ============================================================================

/// Webtoon — One generated 9:16 multi-panel webtoon image per passage.
/// Generation is async via Trigger.dev: status PENDING → GENERATING → COMPLETED|FAILED.
/// imageUrl is the permanent Supabase public URL once COMPLETED.
/// status: "PENDING" | "GENERATING" | "COMPLETED" | "FAILED"
model Webtoon {
  id          String @id @default(cuid())
  academyId   String
  passageId   String
  createdById String // staff.id

  style        String // "KOREAN_WEBTOON" | "PIXAR_3D" | "GHIBLI" | "MANHWA_ROMANCE" | "REALISTIC"
  language     String  @default("KO") // "KO" | "KO_EN" | "EN" | "EN_KO_GLOSS" — 대사/나레이션 언어
  customPrompt String? @db.Text

  status      String  @default("PENDING")
  approved    Boolean @default(false) // Teacher review status (검수완료)
  imageUrl    String? @db.Text // Supabase public URL (final, permanent)
  storagePath String? // Supabase storage path for cleanup
  rawAtlasUrl String? @db.Text // Original AtlasCloud URL (kept for debug)

  promptSnapshot    String? @db.Text // Exact prompt sent to the image model
  promptHash        String?
  imageModel        String?
  imageSize         String?
  imageQuality      String?
  imageOutputFormat String?
  atlasPredictionId String?

  errorMessage        String? @db.Text
  triggerRunId        String? // Trigger.dev run id for tracking
  creditTransactionId String? @unique // For refunds

  // Editable text layer ("자막 편집"). Layered doc: detected text regions (geometry +
  // text + style) over the baked image, so users can fix typos/mistranslations in-browser.
  // Shape = WebtoonTextDoc (src/lib/webtoon-text/types.ts). Added via surgical ALTER.
  textDoc      Json?   @map("text_doc")
  editedImageUrl String? @db.Text @map("edited_image_url") // Supabase URL of the re-typeset export
  editedStoragePath String? @map("edited_storage_path")

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  academy   Academy @relation(fields: [academyId], references: [id])
  passage   Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  createdBy Staff   @relation("WebtoonCreator", fields: [createdById], references: [id])

  collectionItems WebtoonCollectionItem[]

  @@index([academyId])
  @@index([passageId])
  @@index([status])
  @@index([academyId, status])
  @@index([createdAt])
  @@map("webtoons")
}

// ============================================================================
// WEBTOON COLLECTIONS — Folder-like organization for webtoons
// ============================================================================

model WebtoonCollection {
  id          String   @id @default(cuid())
  academyId   String
  parentId    String? // Self-reference for nested folders (null = root)
  name        String
  description String?  @db.Text
  color       String? // Hex color for visual distinction
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// 폴더 과목 — null=ENGLISH(기존 폴더 전부·영어 경로 무회귀), "KOREAN"=국어.
  /// passages.subject·passage_collections.subject 와 동일 규약. DB 반영은 surgical
  /// ALTER 관례(scripts/sql/ko-collections-subject.sql — migrate deploy / db push 금지):
  ///   ALTER TABLE webtoon_collections ADD COLUMN IF NOT EXISTS subject TEXT;
  subject String?


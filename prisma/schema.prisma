// ============================================================================
// 28. PLATFORM COST ACCOUNTING
// ============================================================================

/// ProviderPricing — versioned provider/model pricing snapshots used to
/// calculate per-call platform cost. Keep historical rows instead of editing
/// old effective periods so prior API usage keeps the rate that was valid then.
/// unitType: "TOKENS" | "PAGE" | "IMAGE" | "CALL"
model ProviderPricing {
  id             String    @id @default(cuid())
  provider       String
  modelPattern   String?   @db.Text
  unitType       String    @default("TOKENS")
  inputUsdPer1M  Decimal?  @db.Decimal(12, 6)
  outputUsdPer1M Decimal?  @db.Decimal(12, 6)
  unitUsd        Decimal?  @db.Decimal(12, 6)
  usdToKrwRate   Decimal   @default(1350) @db.Decimal(12, 4)
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  isActive       Boolean   @default(true)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  usageCosts PlatformApiUsageCost[]

  @@index([provider, unitType, isActive, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
  @@map("provider_pricings")
}

/// ProviderBillingReconciliation — actual provider billing snapshots imported
/// from invoices, billing exports, or console cost reports. These rows correct
/// the estimated per-call ledger for a closed billing period.
model ProviderBillingReconciliation {
  id            String   @id @default(cuid())
  provider      String
  unitType      String?
  modelPattern  String?  @db.Text
  periodStart   DateTime
  periodEnd     DateTime
  actualCostUsd Decimal  @default(0) @db.Decimal(12, 6)
  actualCostKrw Int      @default(0)
  usdToKrwRate  Decimal  @default(1350) @db.Decimal(12, 4)
  source        String   @default("MANUAL")
  referenceId   String?  @db.Text
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([periodStart, periodEnd])
  @@index([provider, periodStart])
  @@map("provider_billing_reconciliations")
}

/// PlatformApiUsageCost — immutable-ish cost ledger for individual provider
/// calls. Existing non-missing rows are treated as snapshots; missing rows can
/// be recalculated after pricing is configured.
model PlatformApiUsageCost {
  id             String   @id @default(cuid())
  academyId      String?
  sourceKey      String   @unique
  sourceType     String
  sourceId       String
  sourceDetail   String?
  provider       String
  model          String?  @db.Text
  operationType  String?
  unitType       String   @default("TOKENS")
  unitCount      Int      @default(1)
  calls          Int      @default(1)
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  inputUsdPer1M  Decimal? @db.Decimal(12, 6)
  outputUsdPer1M Decimal? @db.Decimal(12, 6)
  unitUsd        Decimal? @db.Decimal(12, 6)
  usdToKrwRate   Decimal  @default(1350) @db.Decimal(12, 4)
  costUsd        Decimal  @default(0) @db.Decimal(12, 6)
  costKrw        Int      @default(0)
  pricingSource  String   @default("MISSING")
  pricingId      String?
  metadata       Json?
  usageAt        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academy Academy?         @relation(fields: [academyId], references: [id], onDelete: Cascade)
  pricing ProviderPricing? @relation(fields: [pricingId], references: [id], onDelete: SetNull)

  @@index([usageAt])
  @@index([academyId, usageAt])
  @@index([provider, unitType, usageAt])
  @@index([sourceType, sourceId])
  @@index([pricingSource, usageAt])
  @@map("platform_api_usage_costs")
}

model DailyFxRate {
  id        String   @id @default(cuid())
  date      String   @unique // KST date "YYYY-MM-DD" the rate applies to
  base      String   @default("USD")
  quote     String   @default("KRW")
  rate      Decimal  @db.Decimal(12, 4)
  source    String   @default("FRANKFURTER") // "FRANKFURTER" | "MANUAL"
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_fx_rates")
}

model AcademyTheme {
  id           String   @id @default(cuid())
  academyId    String   @unique
  presetKey    String   @default("NEUTRAL")
  tokens       Json?
  fontStack    String?
  logoUrl      String?
  brandStrings Json?
  updatedById  String?
  updatedAt    DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@map("academy_themes")
}

model AcademyFeatureFlag {
  id          String   @id @default(cuid())
  academyId   String
  key         String
  enabled     Boolean  @default(false)
  rolloutPct  Int      @default(100)
  metadata    Json?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  @@unique([academyId, key])
  @@index([academyId, enabled])
  @@map("academy_feature_flags")
}

// ============================================================================
// HELP CENTER — 헬프센터
// 피드백/고객지원 통합 게시판(HelpPost) + 1:1 세미나 신청(SeminarRequest).
// 글로벌(비테넌트): academyId로 목록을 필터링하지 않고 전체 학원 글을 노출한다.
// 작성=Staff(원장), 답변/상태관리=SuperAdmin. 비밀글은 작성자 본인+운영자만 열람.
// ============================================================================

model HelpPost {
  id            String   @id @default(cuid())
  board         String // "FEEDBACK" | "SUPPORT"
  academyId     String? // 작성 학원(맥락·감사용, 목록 필터에는 사용 안 함)
  authorStaffId String?
  authorName    String // 표시명(학원명/작성자)
  category      String   @default("ETC")
  title         String
  content       String   @db.Text
  status        String   @default("OPEN")
  isPrivate     Boolean  @default(false) // 비밀글(본인+운영자만 열람)
  passwordHash  String? // bcrypt
  isPinned      Boolean  @default(false) // 운영자 상단 고정(피드백 로드맵/공지)
  viewCount     Int      @default(0)
  upvoteCount   Int      @default(0) // 피드백 공감(비정규화 카운터)
  attachments   Json? // [{name,url,size,type}] 고객지원 첨부
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  replies HelpPostReply[]
  upvotes HelpPostUpvote[]

  @@index([board, status, createdAt])
  @@index([board, isPinned, createdAt])
  @@map("help_posts")
}

model HelpPostReply {
  id            String   @id @default(cuid())
  postId        String
  authorRole    String // "ADMIN" | "STAFF"
  authorStaffId String?
  authorAdminId String?
  authorName    String
  content       String   @db.Text
  isOfficial    Boolean  @default(false) // 운영자 공식답변
  attachments   Json? // [{name,url,size,type}] 답변·댓글 이미지 첨부
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  post HelpPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("help_post_replies")
}

model HelpPostUpvote {
  id        String   @id @default(cuid())
  postId    String
  staffId   String
  createdAt DateTime @default(now())

  post HelpPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, staffId])
  @@map("help_post_upvotes")
}

model SeminarRequest {
  id               String    @id @default(cuid())
  academyId        String?
  staffId          String?
  applicantName    String
  phone            String
  email            String?
  academyName      String?
  preferredChannel String    @default("PHONE") // "PHONE" | "KAKAO" | "EITHER"
  preferredTimes   String? // 선호 시간대 칩 + 메모
  topic            String? // 관심 주제 칩
  message          String?   @db.Text
  status           String    @default("RECEIVED") // RECEIVED→CONTACTED→SCHEDULED→DONE / CANCELED
  adminMemo        String?   @db.Text
  scheduledAt      DateTime?
  meetingUrl       String? // 운영자가 입력하는 줌(Zoom) 등 화상 접속 링크 — 신청자에게 노출
  handledByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("seminar_requests")
}

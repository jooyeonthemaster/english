/// AcademyRegistration — Pending registration requests from new academies
/// status: "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED"
model AcademyRegistration {
  id                String    @id @default(cuid())
  // Academy info
  academyName       String
  businessNumber    String? // 사업자등록번호
  phone             String
  address           String?
  district          String? // Extracted Seoul district (e.g. "강남구") for campaign tracking
  estimatedStudents Int?
  // Director info
  directorName      String
  directorEmail     String
  directorPhone     String
  // Request
  message           String?   @db.Text
  desiredPlan       String? // Requested tier
  // Review
  status            String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED"
  reviewedById      String?
  reviewNote        String?   @db.Text
  reviewedAt        DateTime?
  // Result (set on approval)
  academyId         String? // Created Academy ID
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reviewedBy SuperAdmin? @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([district])
  @@index([desiredPlan])
  @@map("academy_registrations")
}

// ============================================================================
// 24. BULK PASSAGE EXTRACTION — PDF/image → passages pipeline
// ============================================================================

/// ExtractionJob — 하나의 "대량 추출" 요청 단위
/// status: "PENDING" | "PROCESSING" | "COMPLETED" | "PARTIAL" | "FAILED" | "CANCELLED"
/// sourceType: "PDF" | "IMAGES"
/// mode: "PASSAGE_ONLY" | "QUESTION_SET" | "EXPLANATION" | "FULL_EXAM"
///   - PASSAGE_ONLY (M1): 본문만 뽑아 지문 라이브러리에 적재
///   - QUESTION_SET  (M2): 지문+문제+선지(+정답) → 문제 은행
///   - EXPLANATION   (M3): 해설지 → 기존 Question에 매핑
///   - FULL_EXAM     (M4): 지문+문제+시험지(Exam) 통째
model ExtractionJob {
  id          String @id @default(cuid())
  academyId   String
  createdById String // staff.id

  sourceType       String // "PDF" | "IMAGES"
  mode             String  @default("PASSAGE_ONLY") // M1 ~ M4 (see header)
  originalFileUrl  String? @db.Text // Supabase Storage path for source PDF
  originalFileName String?

  /// Teacher-editable label for the job ("5월 모의고사" 등). Null = fall back
  /// to `originalFileName` in the UI. Original file name is preserved for
  /// audit / debugging.
  displayName String?

  // Upstream "a single exam / worksheet" it materialises into.
  // Populated by extraction-finalize when the job reaches a terminal state.
  sourceMaterialId String?

  // ── Adaptive intake (additive, read only when EXTRACTION_ADAPTIVE_INTAKE on) ──
  /// Routing/audit hint. "IMAGE_SINGLE" | "IMAGES" | "PDF" | "TEXT".
  inputType             String?
  /// Frozen IntakePlan snapshot (passage count, boundaries, layout, segments)
  /// confirmed by the user before extraction — for re-commit/audit/replay.
  intakePlan            Json?
  /// AI triage confidence (0~1) used to pick the surface / fallback.
  triageConfidence      Float?
  /// Triage-estimated passage count — progress denominator before real count.
  estimatedPassageCount Int?
  /// (P7-D2) 추출 산출물 모드(잡 단위 "기본 의도"). "verbatim"(원문 그대로) | "restored"(AI 복원).
  /// 진실의 소스는 지문별(Passage.extractionOutput / Draft.restorationStatus).
  /// null = 미전달(비적응 흐름) → finalize는 기존 자동복원 휴리스틱 유지.
  outputMode            String?
  /// 문제생성 페이지 발(發) 잡: finalize가 drafts를 서버에서 곧바로 Passage로 승격한다.
  /// 클라이언트 폴링 승격(useGenerateExtraction)은 표시/폴백용 — 페이지 이탈로 폴링이
  /// 죽어도 결과가 고아가 되지 않게 하는 게 목적. 자료추출(import) 잡은 false(수동 검수).
  autoPromote           Boolean @default(false)

  status       String @default("PENDING")
  totalPages   Int
  successPages Int    @default(0)
  failedPages  Int    @default(0)
  pendingPages Int // init = totalPages

  creditsReserved Int @default(0) // pre-flight projected cost (not actually charged)
  creditsConsumed Int @default(0) // sum of restoration charges
  creditsRefunded Int @default(0) // sum of restoration refunds

  concurrencyLimit Int     @default(5)
  triggerRunId     String? @db.Text // Trigger.dev orchestrator run handle (cancel/cleanup)

  errorSummary String? @db.Text // JSON summary of errors

  /// Free-form metadata for job-scoped extras. Currently stores the list
  /// preview thumbnail info written by create-job
  /// (`{ previewImageUrl, previewMimeType, previewImageBytes }`) and read
  /// by list-jobs for the 자료 목록 card thumbnails.
  metadata Json?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  academy         Academy                    @relation(fields: [academyId], references: [id])
  createdBy       Staff                      @relation("ExtractionJobCreator", fields: [createdById], references: [id])
  sourceMaterial  SourceMaterial?            @relation(fields: [sourceMaterialId], references: [id])
  pages           ExtractionPage[]
  results         ExtractionResult[]
  items           ExtractionItem[]
  m1PassageDrafts ExtractionM1PassageDraft[]
  passageDrafts   ExtractionPassageDraft[]
  questionDrafts  ExtractionQuestionDraft[]

  @@index([academyId, status])
  @@index([academyId, createdAt])
  @@index([academyId, deletedAt, createdAt])
  @@index([deletedAt])
  @@index([status, createdAt])
  @@index([sourceMaterialId])
  @@map("extraction_jobs")
}

/// ExtractionPage — 페이지 1장 = Gemini 호출 1회 단위 (원자 단위)
/// status: "PENDING" | "PROCESSING" | "SUCCESS" | "FAILED" | "DEAD" | "SKIPPED"
/// idempotencyKey = `${jobId}:${pageIndex}` — UNIQUE로 3중 방어선의 2차 방벽 역할
model ExtractionPage {
  id             String  @id @default(cuid())
  jobId          String
  pageIndex      Int // 0-based 순서
  imageUrl       String  @db.Text // Supabase Storage key (not public URL)
  imageBytes     Int?
  sourceFileName String?

  status       String @default("PENDING")
  attemptCount Int    @default(0)
  maxAttempts  Int    @default(3)

  // ─── 멱등성 핵심 ──────────────────────────────
  idempotencyKey String // `${jobId}:${pageIndex}` — UNIQUE
  leaseOwner     String? // Trigger.dev run id
  leaseExpiresAt DateTime? // stuck lease 복구용

  // ─── 결과 ─────────────────────────────────────
  extractedText String?  @db.Text
  confidence    Float?
  modelUsed     String?
  inputTokens   Int?
  outputTokens  Int?
  /// 이 페이지 OCR 호출들의 실측 청구액 합(USD) — OpenRouter usage.cost.
  /// platform-api-costs sync 가 recordedCostUsd(RECORDED 단가)로 흡수한다.
  aiCostUsd     Decimal? @db.Decimal(12, 8)
  latencyMs     Int?

  /// Per-page metadata captured by the structured OCR call (pageNumber /
  /// pageTotal / examCode / subject / etc.). Used by finalize to reorder
  /// mixed-up uploads and to cluster pages by exam fingerprint.
  pageMeta Json?

  // ── Adaptive intake — D4 多페이지 묶음(bundle) 입력 표식 (additive) ──
  /// Non-null marks this page row as a bundle member dispatched in one OCR call.
  /// Members of one bundle share the same key. Null = legacy single-page path.
  bundleKey       String?
  /// Real source pageIndexes a bundle row sends together (e.g. [4,5]). Empty for
  /// single-page rows. The bundle row itself may use a reserved virtual pageIndex.
  spanPageIndices Int[]   @default([])

  /// Raw OCR text returned by Document AI BEFORE Gemini classification.
  /// Stored for debugging: lets us tell whether a missing marker / word
  /// was lost in Document AI (vision limit) or stripped by Gemini classify
  /// (LLM tendency overriding prompt). Null when Document AI was not used.
  documentAiRawText String? @db.Text

  // ─── 크레딧 연결(legacy) ──────────────────────
  creditTxId String? // Legacy OCR charge link. New pure OCR jobs leave this null.

  // ─── 에러 ─────────────────────────────────────
  errorCode    String?
  errorMessage String? @db.Text

  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  job   ExtractionJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  items ExtractionItem[]

  @@unique([idempotencyKey])
  @@unique([jobId, pageIndex])
  @@index([jobId, status])
  @@index([status, leaseExpiresAt])
  @@map("extraction_pages")
}

/// ExtractionResult — 지문 단위 결과 (세그멘테이션 후 산출물)
/// status: "DRAFT" | "REVIEWED" | "SAVED" | "SKIPPED"
model ExtractionResult {
  id           String @id @default(cuid())
  jobId        String
  passageOrder Int // job 내 정렬

  sourcePageIndex Int[] // 예: [3,4,5] — 여러 페이지 걸친 지문 지원

  title   String?
  content String  @db.Text
  meta    Json? // { markerDetected, mergedFromPages, confidenceNote }

  confidence     Float?
  status         String  @default("DRAFT")
  savedPassageId String? // Passage.id after commit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job           ExtractionJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  passageDrafts ExtractionPassageDraft[]

  @@index([jobId, passageOrder])
  @@index([jobId, status])
  @@map("extraction_results")
}

// ============================================================================
// 25. EXTRACTION ITEMS — granular block-level representation
// ============================================================================
// Replaces the legacy ExtractionResult for new jobs. Each extracted document
// is represented as a tree of typed blocks (passage body, question stem,
// choice, explanation, exam meta, etc.) with parent/child relationships so
// the review UI can classify, regroup, and promote them into proper Passage /
// Question / QuestionExplanation / SourceMaterial records.
// ============================================================================

/// ExtractionItem — a typed block emitted by segmentation
/// blockType: "PASSAGE_BODY" | "QUESTION_STEM" | "CHOICE" | "EXPLANATION" | "EXAM_META" | "HEADER" | "FOOTER" | "DIAGRAM" | "NOISE"
/// status:    "DRAFT" | "REVIEWED" | "PROMOTED" | "SKIPPED" | "MERGED"
model ExtractionItem {
  id              String  @id @default(cuid())
  jobId           String
  pageId          String? // ExtractionPage.id (null when item spans multiple pages)
  sourcePageIndex Int[] // supports multi-page items

  // ─── Identity ────────────────────────────────
  blockType    String
  groupId      String? // passage↔question↔choice clustering key (job-scoped)
  parentItemId String? // CHOICE → QUESTION_STEM / EXPLANATION → QUESTION_STEM

  order      Int // global order within job
  localOrder Int? // position within parent group (1st choice, 2nd choice, ...)

  // ─── Content ─────────────────────────────────
  title   String?
  content String  @db.Text // editable final text (what review UI shows)
  rawText String? @db.Text // original OCR text — preserved verbatim

  // ─── Type-specific metadata (Json, validated per blockType in app layer) ──
  questionMeta Json? // { number, points, pattern, answerChoice, ... }
  choiceMeta   Json? // { index, label, isAnswer }
  passageMeta  Json? // { wordCount, paragraphCount, markerDetected }
  examMeta     Json? // { subject, grade, year, round, publisher, school }

  boundingBox Json? // { page, x, y, w, h } — click-to-highlight in viewer

  // ── Adaptive intake (additive) ──
  /// Normalized crop rectangle {x,y,w,h} in 0~1 (EXIF-corrected). The region a
  /// user marqueed on a page; the OCR input for crop segments. Distinct from
  /// boundingBox (viewer highlight only) to avoid overloading. (D-G2)
  cropBox          Json?
  /// "page" | "span" | "crop" | "text-block" | "manual" — how this segment was
  /// produced, so the review UI and bench can reason about provenance.
  segmentKind      String?
  /// Why a block was flagged incomplete: "LENGTH" | "CROP_SIGNAL" | "LOW_OCR"
  /// | "SKEW" | "NON_TERMINAL". Replaces the old silent length-only discard. (G4)
  incompleteReason String?

  // ─── Quality ────────────────────────────────
  confidence  Float?
  needsReview Boolean @default(false)
  status      String  @default("DRAFT")

  // ─── Promotion tracking ─────────────────────
  // URN string — e.g. "Passage:clxxxxx" / "Question:clxxxxx" / "QuestionExplanation:clxxxxx"
  promotedTo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job      ExtractionJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  page     ExtractionPage?  @relation(fields: [pageId], references: [id], onDelete: SetNull)
  parent   ExtractionItem?  @relation("ItemTree", fields: [parentItemId], references: [id], onDelete: SetNull)
  children ExtractionItem[] @relation("ItemTree")

  @@index([jobId, order])
  @@index([jobId, blockType])
  @@index([jobId, groupId])
  @@index([parentItemId])
  @@map("extraction_items")
}

// ============================================================================
// 26. SOURCE MATERIAL — "a single exam / textbook / worksheet" as first-class citizen
// ============================================================================
// Every Passage / Question / Exam that originated from a physical document
// points back to one SourceMaterial. This is the hub that lets us answer
// "where did this passage come from?" and "show me everything from that exam"
// without denormalising metadata into every child row.
// ============================================================================

/// SourceMaterial — one physical source document (exam paper, textbook chapter, handout)
/// type: "EXAM" | "TEXTBOOK" | "WORKBOOK" | "HANDOUT" | "MOCK" | "SUNEUNG" | "OTHER"
/// subject: "ENGLISH" | "KOREAN" | "MATH" | "OTHER"
/// examType: "MIDTERM" | "FINAL" | "MOCK" | "SUNEUNG" | "DIAGNOSTIC" | "EBS" | "PRIVATE"
model SourceMaterial {
  id        String  @id @default(cuid())
  academyId String
  schoolId  String?

  type        String
  title       String
  /// Teacher-set override displayed in the 자료 관리 (extraction-manage) page.
  /// Auto-set `title` (extraction AI guess) is unreliable, so the manage UI
  /// reads `customLabel` first and falls back to a derived "{job name} 시험지 N"
  /// label. Other pages keep using `title`.
  customLabel String?
  subtitle    String?

  // Common metadata (first-class columns for fast filtering)
  subject   String? @default("ENGLISH")
  grade     Int?
  semester  String? // "FIRST" | "SECOND"
  year      Int?
  round     String? // "6월", "9월", "11월" or "1회", "2회"
  examType  String?
  publisher String?
  sourceRef String? // free-form reference (URL, ISBN, distributor)

  // Extraction linkage
  originalFileUrl String? @db.Text // archived PDF in Supabase Storage
  contentHash     String? // sha1 of concatenated extracted texts — duplicate detection

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy   Academy @relation(fields: [academyId], references: [id])
  school    School? @relation(fields: [schoolId], references: [id])
  createdBy Staff?  @relation("SourceMaterialCreator", fields: [createdById], references: [id])

  bundles         PassageBundle[]
  passages        Passage[]
  questions       Question[]
  exams           Exam[]
  extractionJobs  ExtractionJob[]
  m1PassageDrafts ExtractionM1PassageDraft[]
  passageDrafts   ExtractionPassageDraft[]

  @@unique([academyId, contentHash], name: "academy_content_hash_unique")
  @@index([academyId, type])
  @@index([academyId, grade, year])
  @@index([academyId, createdAt])
  @@index([schoolId])
  @@index([contentHash])
  @@map("source_materials")
}

// ============================================================================
// 27. PASSAGE BUNDLE — a passage + its shared questions (e.g. CSAT [2~4])
// ============================================================================

/// PassageBundle — groups one passage with its sharing questions, scoped per source
/// A single Passage can appear in multiple bundles (reused across exams).
model PassageBundle {
  id               String  @id @default(cuid())
  sourceMaterialId String
  passageId        String
  orderInMaterial  Int // order within the source (e.g. passage #2 on the exam)
  sharedLabel      String? // "[32~34]" label as printed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceMaterial SourceMaterial @relation(fields: [sourceMaterialId], references: [id], onDelete: Cascade)
  passage        Passage        @relation(fields: [passageId], references: [id], onDelete: Cascade)
  questions      Question[]     @relation("BundleQuestions")

  @@unique([sourceMaterialId, passageId])
  @@index([sourceMaterialId])
  @@index([passageId])
  @@map("passage_bundles")
}

/// QuestionSet — one shared passage carrying N ordered questions (장문 세트; generalizes CSAT 43~45).
/// canonicalPassage is the ordered source and is NEVER shown to students (would leak SENTENCE_ORDER).
/// displayedPassageLayout (JSON LayoutDescriptor) is the visible base every member anchors into.
/// status: "OK" | "DEGRADED" (anchor resolution failed → manual review required).
model QuestionSet {
  id                     String  @id @default(cuid())
  jobId                  String? // generation lineage → WorkbenchAiJob (nullable: hand-assembled sets)
  academyId              String
  structuralMode         String  @default("NONE") // "NONE" | "SENTENCE_ORDER" | "SENTENCE_INSERT"
  canonicalPassage       String  @db.Text // ordered; never rendered to students
  displayedPassageLayout String  @db.Text // JSON LayoutDescriptor; the visible base
  layoutFingerprint      String // sha256(displayedPassageLayout) — anchor-resolution gate
  itemCount              Int     @default(0)
  setLabel               String? // "[43~45]" — printed group header
  basePassageId          String? // optional: structural member promoted to a stored Passage (Phase 7+)
  status                 String  @default("OK")

  /// 문제 세트 과목 — null=ENGLISH(기존 세트 전부·영어 무회귀), "KOREAN"=국어 세트.
  /// passages.subject 규약. surgical ALTER (migrate deploy / db push 금지):
  ///   ALTER TABLE question_sets ADD COLUMN IF NOT EXISTS subject text;  (ko-exam-set-subject.sql)
  subject String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job         WorkbenchAiJob?   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  academy     Academy           @relation(fields: [academyId], references: [id])
  basePassage Passage?          @relation("SetBasePassage", fields: [basePassageId], references: [id], onDelete: SetNull)
  items       QuestionSetItem[]

  @@index([jobId])
  @@index([academyId])
  @@map("question_sets")
}

/// QuestionSetItem — one member of a set. spans are RE-DERIVABLE ANCHORS (never absolute offsets).
/// isStructural=true => this member DEFINES displayedPassageLayout (글의 순서 / 문장 삽입).
model QuestionSetItem {
  id           String   @id @default(cuid())
  setId        String
  questionId   String   @unique // one Question ⇄ one set membership
  orderInSet   Int // 0-indexed; SPARSE allowed after deletes (0,1,3)
  isStructural Boolean  @default(false)
  spans        Json? // Array<Anchor>; authoritative anchor store
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  set      QuestionSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  question Question    @relation("SetItemQuestion", fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([setId, orderInSet])
  @@index([setId])
  @@map("question_set_items")
}

// ============================================================================
// 28. M1 PASSAGE EXTRACTION DRAFTS — raw + restored passage pairs
// ============================================================================

/// ExtractionM1PassageDraft — one passage result from M1 extraction.
/// Stores both the raw extracted text and the restored text used for review.
model ExtractionM1PassageDraft {
  id               String  @id @default(cuid())
  jobId            String
  sourceMaterialId String?

  passageOrder    Int
  sourcePageIndex Int[]

  title        String?
  rawText      String  @db.Text
  restoredText String  @db.Text
  teacherText  String  @db.Text

  restorationStatus String @default("RESTORED")
  reviewStatus      String @default("DRAFT")
  confidence        Float?
  warnings          Json?
  metadata          Json?

  confirmedAt           DateTime?
  savedPassageId        String?
  /// (P7-D2) AI 복원 차감 CreditTransaction.id. null=미과금. 환불 후 null 복원.
  /// Pure OCR/Document AI does not set a credit transaction.
  restorationCreditTxId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  deletedById           String?

  job             ExtractionJob                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceMaterial  SourceMaterial?                  @relation(fields: [sourceMaterialId], references: [id], onDelete: SetNull)
  changes         ExtractionM1PassageDraftChange[]
  sourceMatches   ExtractionM1PassageSourceMatch[]
  collectionItems M1PassageDraftCollectionItem[]

  @@unique([jobId, passageOrder])
  @@index([jobId])
  @@index([jobId, deletedAt])
  @@index([sourceMaterialId])
  @@index([reviewStatus])
  @@index([deletedAt])
  @@map("extraction_m1_passage_drafts")
}

/// ExtractionM1PassageDraftChange — restorable before/after spans for UI highlights.
model ExtractionM1PassageDraftChange {
  id             String @id @default(cuid())
  passageDraftId String

  sentenceOrder Int?
  before        String  @db.Text
  after         String  @db.Text
  changeType    String?
  reason        String? @db.Text
  confidence    Float?

  sourcePageIndex Int[]
  createdAt       DateTime @default(now())

  passageDraft ExtractionM1PassageDraft @relation(fields: [passageDraftId], references: [id], onDelete: Cascade)

  @@index([passageDraftId])
  @@map("extraction_m1_passage_draft_changes")
}

/// ExtractionAuditLog — Append-only audit trail for destructive or
/// membership-changing extraction review actions.
/// action: "M1_DRAFT_DELETE" | "M1_DRAFT_BULK_DELETE" |
///         "M1_DRAFT_REMOVE_FROM_COLLECTION" | "EXTRACTION_JOB_DELETE"
model ExtractionAuditLog {
  id           String  @id @default(cuid())
  academyId    String
  actorStaffId String?

  action      String
  targetType  String
  targetId    String
  targetLabel String?
  metadata    Json?

  createdAt DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  actor   Staff?  @relation("ExtractionAuditActor", fields: [actorStaffId], references: [id], onDelete: SetNull)

  @@index([academyId, createdAt])
  @@index([actorStaffId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("extraction_audit_logs")
}

model ExtractionM1PassageSourceMatch {
  id             String @id @default(cuid())
  passageDraftId String

  sourceType String
  sourceId   String?
  sourceRef  String? @db.Text
  title      String?
  publisher  String?
  unit       String?
  year       Int?
  confidence Float?
  method     String
  reason     String? @db.Text
  selected   Boolean @default(false)
  metadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passageDraft ExtractionM1PassageDraft @relation(fields: [passageDraftId], references: [id], onDelete: Cascade)

  @@index([passageDraftId])
  @@index([sourceId])
  @@map("extraction_m1_passage_source_matches")
}

// ============================================================================
// 29. M2 EXTRACTION DRAFTS — review-first passage + question registration
// ============================================================================

/// ExtractionPassageDraft — restored passage candidate created from M2.
/// The final Passage row is created later, after teacher review/registration.
model ExtractionPassageDraft {
  id                 String  @id @default(cuid())
  jobId              String
  extractionResultId String?
  sourceMaterialId   String?

  passageOrder    Int
  sourcePageIndex Int[]

  problemText        String  @db.Text
  restoredText       String? @db.Text
  teacherText        String? @db.Text
  restorationStatus  String  @default("PENDING")
  verificationStatus String  @default("PENDING")
  reviewStatus       String  @default("DRAFT")

  confidence Float?
  warnings   Json?
  metadata   Json?

  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  job              ExtractionJob                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  extractionResult ExtractionResult?              @relation(fields: [extractionResultId], references: [id], onDelete: SetNull)
  sourceMaterial   SourceMaterial?                @relation(fields: [sourceMaterialId], references: [id], onDelete: SetNull)
  sentences        ExtractionPassageSentence[]
  questions        ExtractionQuestionDraft[]
  restoration      ExtractionPassageRestoration?
  sourceMatches    ExtractionPassageSourceMatch[]

  @@unique([jobId, passageOrder])
  @@index([jobId])
  @@index([sourceMaterialId])
  @@index([reviewStatus])
  @@map("extraction_passage_drafts")
}

/// ExtractionQuestionDraft — question candidate linked to an M2 passage draft.
/// The final Question row is created later, after teacher review/registration.
model ExtractionQuestionDraft {
  id             String  @id @default(cuid())
  jobId          String
  passageDraftId String?

  questionOrder   Int
  questionNumber  Int?
  sourcePageIndex Int[]

  stem         String  @db.Text
  choices      Json?
  answer       String? @db.Text
  explanation  String? @db.Text
  questionType String?

  confidence   Float?
  warnings     Json?
  reviewStatus String @default("DRAFT")
  metadata     Json?

  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  job          ExtractionJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  passageDraft ExtractionPassageDraft? @relation(fields: [passageDraftId], references: [id], onDelete: SetNull)

  @@unique([jobId, questionOrder])
  @@index([jobId])
  @@index([passageDraftId])
  @@index([reviewStatus])
  @@map("extraction_question_drafts")
}

/// ExtractionPassageSentence — sentence-numbered review view for a passage draft.
model ExtractionPassageSentence {
  id             String @id @default(cuid())
  passageDraftId String
  order          Int

  problemText  String? @db.Text
  restoredText String  @db.Text
  status       String  @default("OK")
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passageDraft ExtractionPassageDraft @relation(fields: [passageDraftId], references: [id], onDelete: Cascade)

  @@unique([passageDraftId, order])
  @@index([passageDraftId])
  @@map("extraction_passage_sentences")
}

/// ExtractionPassageRestoration — one restoration attempt/result per passage draft.
model ExtractionPassageRestoration {
  id             String @id @default(cuid())
  passageDraftId String @unique

  method     String
  status     String
  confidence Float?

  originalText      String  @db.Text
  restoredText      String  @db.Text
  modelUsed         String?
  unresolvedMarkers Json?
  warnings          Json?
  rawResponse       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passageDraft ExtractionPassageDraft               @relation(fields: [passageDraftId], references: [id], onDelete: Cascade)
  changes      ExtractionPassageRestorationChange[]

  @@index([status])
  @@map("extraction_passage_restorations")
}

/// ExtractionPassageRestorationChange — auditable before/after restoration diff.
model ExtractionPassageRestorationChange {
  id            String @id @default(cuid())
  restorationId String

  sentenceOrder          Int?
  before                 String  @db.Text
  after                  String  @db.Text
  reason                 String? @db.Text
  evidenceQuestionNumber Int?
  evidenceType           String?
  confidence             Float?

  createdAt DateTime @default(now())

  restoration ExtractionPassageRestoration @relation(fields: [restorationId], references: [id], onDelete: Cascade)

  @@index([restorationId])
  @@map("extraction_passage_restoration_changes")
}

/// ExtractionPassageSourceMatch — candidate source/original match for a draft.
model ExtractionPassageSourceMatch {
  id             String @id @default(cuid())
  passageDraftId String

  sourceType String
  sourceId   String?
  sourceRef  String? @db.Text
  title      String?
  publisher  String?
  unit       String?
  year       Int?
  confidence Float?
  method     String
  reason     String? @db.Text
  selected   Boolean @default(false)
  metadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passageDraft ExtractionPassageDraft @relation(fields: [passageDraftId], references: [id], onDelete: Cascade)

  @@index([passageDraftId])
  @@index([sourceId])
  @@map("extraction_passage_source_matches")
}

// ============================================================================
// 25. WEBTOON — AI-generated multi-panel webtoon images per passage
// ============================================================================

/// Webtoon — One generated 9:16 multi-panel webtoon image per passage.
/// Generation is async via Trigger.dev: status PENDING → GENERATING → COMPLETED|FAILED.
/// imageUrl is the permanent Supabase public URL once COMPLETED.
/// status: "PENDING" | "GENERATING" | "COMPLETED" | "FAILED"
model Webtoon {
  id          String @id @default(cuid())
  academyId   String
  passageId   String
  createdById String // staff.id

  style        String // "KOREAN_WEBTOON" | "PIXAR_3D" | "GHIBLI" | "MANHWA_ROMANCE" | "REALISTIC"
  language     String  @default("KO") // "KO" | "KO_EN" | "EN" | "EN_KO_GLOSS" — 대사/나레이션 언어
  customPrompt String? @db.Text

  status      String  @default("PENDING")
  approved    Boolean @default(false) // Teacher review status (검수완료)
  imageUrl    String? @db.Text // Supabase public URL (final, permanent)
  storagePath String? // Supabase storage path for cleanup
  rawAtlasUrl String? @db.Text // Original AtlasCloud URL (kept for debug)

  promptSnapshot    String? @db.Text // Exact prompt sent to the image model
  promptHash        String?
  imageModel        String?
  imageSize         String?
  imageQuality      String?
  imageOutputFormat String?
  atlasPredictionId String?

  errorMessage        String? @db.Text
  triggerRunId        String? // Trigger.dev run id for tracking
  creditTransactionId String? @unique // For refunds

  // Editable text layer ("자막 편집"). Layered doc: detected text regions (geometry +
  // text + style) over the baked image, so users can fix typos/mistranslations in-browser.
  // Shape = WebtoonTextDoc (src/lib/webtoon-text/types.ts). Added via surgical ALTER.
  textDoc           Json?   @map("text_doc")
  editedImageUrl    String? @map("edited_image_url") @db.Text // Supabase URL of the re-typeset export
  editedStoragePath String? @map("edited_storage_path")

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  academy   Academy @relation(fields: [academyId], references: [id])
  passage   Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  createdBy Staff   @relation("WebtoonCreator", fields: [createdById], references: [id])

  collectionItems WebtoonCollectionItem[]

  @@index([academyId])
  @@index([passageId])
  @@index([status])
  @@index([academyId, status])
  @@index([createdAt])
  @@map("webtoons")
}

/// ExamPassageWebtoonAsset — Platform-owned, pre-generated webtoon for a static
/// 수능·모평 기출 corpus passage. Only REVIEWED/APPROVED assets are exposed for
/// teacher download; generation success alone must not unlock the image.
/// status: "PENDING" | "GENERATING" | "REVIEW_REQUIRED" | "APPROVED" | "REJECTED" | "FAILED"
model ExamPassageWebtoonAsset {
  id            String @id @default(cuid())
  examPassageId String

  style    String @default("KOREAN_WEBTOON")
  language String @default("KO") // "KO" | "KO_EN" | "EN" | "EN_KO_GLOSS"
  status   String @default("PENDING")

  imageUrl    String? @db.Text
  storagePath String?
  rawAtlasUrl String? @db.Text

  promptSnapshot    String? @db.Text
  promptHash        String?
  imageModel        String?
  imageSize         String?
  imageQuality      String?
  imageOutputFormat String?
  atlasPredictionId String?

  sourceHash String?
  sourceMeta Json?
  qaReport   Json?
  attempts   Int     @default(0)

  errorMessage String?   @db.Text
  generatedAt  DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([examPassageId, language, style])
  @@index([examPassageId])
  @@index([status])
  @@index([updatedAt])
  @@map("exam_passage_webtoon_assets")
}

/// ExamPassageWebtoonPurchase — Per-academy unlock ledger for downloading an
/// approved platform-owned 기출 웹툰. One unlock covers one passage/language/style.
model ExamPassageWebtoonPurchase {
  id            String @id @default(cuid())
  academyId     String
  createdById   String
  examPassageId String
  assetId       String
  language      String
  style         String @default("KOREAN_WEBTOON")

  creditTransactionId String   @unique
  createdAt           DateTime @default(now())

  @@unique([academyId, examPassageId, language, style])
  @@index([academyId])
  @@index([assetId])
  @@index([examPassageId])
  @@map("exam_passage_webtoon_purchases")
}

// ============================================================================
// WEBTOON COLLECTIONS — Folder-like organization for webtoons
// ============================================================================

model WebtoonCollection {
  id          String   @id @default(cuid())
  academyId   String
  parentId    String? // Self-reference for nested folders (null = root)
  name        String
  description String?  @db.Text
  color       String? // Hex color for visual distinction
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// 폴더 과목 — null=ENGLISH(기존 폴더 전부·영어 경로 무회귀), "KOREAN"=국어.
  /// passages.subject·passage_collections.subject 와 동일 규약. DB 반영은 surgical
  /// ALTER 관례(scripts/sql/ko-collections-subject.sql — migrate deploy / db push 금지):
  ///   ALTER TABLE webtoon_collections ADD COLUMN IF NOT EXISTS subject TEXT;
  subject String?

  academy  Academy                 @relation(fields: [academyId], references: [id])
  parent   WebtoonCollection?      @relation("WebtoonFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children WebtoonCollection[]     @relation("WebtoonFolderTree")
  items    WebtoonCollectionItem[]

  @@index([academyId])
  @@index([parentId])
  @@map("webtoon_collections")
}

model WebtoonCollectionItem {
  id           String @id @default(cuid())
  collectionId String
  webtoonId    String
  orderNum     Int    @default(0)

  collection WebtoonCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  webtoon    Webtoon           @relation(fields: [webtoonId], references: [id], onDelete: Cascade)

  @@unique([collectionId, webtoonId])
  @@index([collectionId])
  @@map("webtoon_collection_items")
}

// ============================================================================
// 26. TUTOR — Mobile/tablet 내신 learning system (isolated from legacy learning)

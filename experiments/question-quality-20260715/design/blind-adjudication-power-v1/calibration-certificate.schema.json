{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smoat:question-quality:reviewer-calibration-certificate:v1",
  "title": "Per-reviewer, family-scoped calibration certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "certificateId",
    "reviewerPseudonym",
    "packetSha256",
    "oracleSha256",
    "scorerSha256",
    "contractSha256",
    "perReviewer",
    "scope",
    "goldComposition",
    "comparisonRule",
    "metrics",
    "decision",
    "reasonCodes",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": "reviewer-calibration-certificate-v1" },
    "certificateId": { "type": "string", "pattern": "^[A-Z0-9_-]{3,80}$" },
    "reviewerPseudonym": { "type": "string", "pattern": "^[A-Z0-9_-]{3,40}$" },
    "packetSha256": { "$ref": "#/$defs/sha256" },
    "oracleSha256": { "$ref": "#/$defs/sha256" },
    "scorerSha256": { "$ref": "#/$defs/sha256" },
    "contractSha256": { "$ref": "#/$defs/sha256" },
    "perReviewer": { "const": true },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focusBlocks", "evidenceFamilies", "grammarSurfaceContract", "blankAxes", "allActiveTypesCertified"],
      "properties": {
        "focusBlocks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["GRAMMAR", "BLANK"] }
        },
        "evidenceFamilies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "marked_selection",
              "option_selection",
              "ordering_or_insertion",
              "closed_constructed",
              "open_constructed",
              "correction",
              "lexical"
            ]
          }
        },
        "grammarSurfaceContract": { "const": "EXACT_5_MARKERS_1_INVALID" },
        "blankAxes": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "actorOrTarget",
              "polarity",
              "conditionOrModality",
              "causalRelationAndDirection",
              "scopeOrQuantifier",
              "stance",
              "temporalRelation"
            ]
          }
        },
        "allActiveTypesCertified": { "const": false }
      }
    },
    "goldComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "fatal", "nonfatal", "gradeF", "gradeC", "gradeB", "gradeA", "perBlock"],
      "properties": {
        "total": { "const": 24 },
        "fatal": { "const": 6 },
        "nonfatal": { "const": 18 },
        "gradeF": { "const": 6 },
        "gradeC": { "const": 6 },
        "gradeB": { "const": 6 },
        "gradeA": { "const": 6 },
        "perBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["GRAMMAR", "BLANK", "NONFOCUS"],
          "properties": {
            "GRAMMAR": { "$ref": "#/$defs/blockComposition" },
            "BLANK": { "$ref": "#/$defs/blockComposition" },
            "NONFOCUS": { "$ref": "#/$defs/blockComposition" }
          }
        }
      }
    },
    "comparisonRule": { "const": "RAW_INTEGER_FRACTIONS_NO_ROUNDING" },
    "metrics": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["global", "blocks"],
          "properties": {
            "global": { "$ref": "#/$defs/globalMetricSet" },
            "blocks": {
              "type": "object",
              "additionalProperties": false,
              "required": ["GRAMMAR", "BLANK", "NONFOCUS"],
              "properties": {
                "GRAMMAR": { "$ref": "#/$defs/blockMetricSet" },
                "BLANK": { "$ref": "#/$defs/blockMetricSet" },
                "NONFOCUS": { "$ref": "#/$defs/blockMetricSet" }
              }
            }
          }
        }
      ]
    },
    "decision": { "enum": ["PASS", "FAIL_METRICS", "FAIL_INCOMPLETE"] },
    "reasonCodes": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z0-9_-]{3,120}$" }
    },
    "issuedAt": { "$ref": "#/$defs/timestamp" },
    "expiresAt": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "FAIL_INCOMPLETE" } } },
      "then": {
        "properties": {
          "metrics": { "type": "null" },
          "reasonCodes": { "minItems": 1 }
        }
      },
      "else": {
        "properties": { "metrics": { "type": "object" } }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "PASS" } } },
      "then": { "properties": { "reasonCodes": { "maxItems": 0 } } },
      "else": { "properties": { "reasonCodes": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "blockComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "fatal", "nonfatal", "gradeF", "gradeC", "gradeB", "gradeA"],
      "properties": {
        "total": { "const": 8 },
        "fatal": { "const": 2 },
        "nonfatal": { "const": 6 },
        "gradeF": { "const": 2 },
        "gradeC": { "const": 2 },
        "gradeB": { "const": 2 },
        "gradeA": { "const": 2 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["TP", "TN", "FP", "FN"],
      "properties": {
        "TP": { "type": "integer", "minimum": 0, "maximum": 24 },
        "TN": { "type": "integer", "minimum": 0, "maximum": 24 },
        "FP": { "type": "integer", "minimum": 0, "maximum": 24 },
        "FN": { "type": "integer", "minimum": 0, "maximum": 24 }
      }
    },
    "metricFraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "rawValue", "display4"],
      "properties": {
        "numerator": { "type": "integer" },
        "denominator": { "type": "integer", "minimum": 1 },
        "rawValue": { "type": "number", "minimum": -1, "maximum": 1 },
        "display4": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{4}$" }
      }
    },
    "focusFieldCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "required"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "required": { "type": "integer", "minimum": 1 }
      }
    },
    "globalMetricSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "blindSolveExactAgreement",
        "blindSolveCounts",
        "exactFatalAgreement",
        "gwetAc1Fatal",
        "fatalSensitivity",
        "fatalSpecificity",
        "quadraticWeightedKappaGrade",
        "focusFieldCompleteness",
        "focusFieldCounts",
        "grammarSiteAgreement",
        "grammarSiteCounts",
        "blankOptionAgreement",
        "blankOptionCounts",
        "blankAxisAgreement",
        "blankAxisCounts"
      ],
      "properties": {
        "counts": { "$ref": "#/$defs/counts" },
        "blindSolveExactAgreement": { "$ref": "#/$defs/metricFraction" },
        "blindSolveCounts": { "$ref": "#/$defs/diagnosticCounts" },
        "exactFatalAgreement": { "$ref": "#/$defs/metricFraction" },
        "gwetAc1Fatal": { "$ref": "#/$defs/metricFraction" },
        "fatalSensitivity": { "$ref": "#/$defs/metricFraction" },
        "fatalSpecificity": { "$ref": "#/$defs/metricFraction" },
        "quadraticWeightedKappaGrade": { "$ref": "#/$defs/metricFraction" },
        "focusFieldCompleteness": { "$ref": "#/$defs/metricFraction" },
        "focusFieldCounts": { "$ref": "#/$defs/focusFieldCounts" },
        "grammarSiteAgreement": { "$ref": "#/$defs/metricFraction" },
        "grammarSiteCounts": { "$ref": "#/$defs/diagnosticCounts" },
        "blankOptionAgreement": { "$ref": "#/$defs/metricFraction" },
        "blankOptionCounts": { "$ref": "#/$defs/diagnosticCounts" },
        "blankAxisAgreement": { "$ref": "#/$defs/metricFraction" },
        "blankAxisCounts": { "$ref": "#/$defs/diagnosticCounts" }
      }
    },
    "blockMetricSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "blindSolveExactAgreement",
        "blindSolveCounts",
        "exactFatalAgreement",
        "gwetAc1Fatal",
        "fatalSensitivity",
        "fatalSpecificity",
        "quadraticWeightedKappaGrade",
        "focusFieldCompleteness",
        "focusFieldCounts",
        "grammarSiteAgreement",
        "grammarSiteCounts",
        "blankOptionAgreement",
        "blankOptionCounts",
        "blankAxisAgreement",
        "blankAxisCounts"
      ],
      "properties": {
        "counts": { "$ref": "#/$defs/counts" },
        "blindSolveExactAgreement": { "$ref": "#/$defs/metricFraction" },
        "blindSolveCounts": { "$ref": "#/$defs/diagnosticCounts" },
        "exactFatalAgreement": { "$ref": "#/$defs/metricFraction" },
        "gwetAc1Fatal": { "$ref": "#/$defs/metricFraction" },
        "fatalSensitivity": { "$ref": "#/$defs/metricFraction" },
        "fatalSpecificity": { "$ref": "#/$defs/metricFraction" },
        "quadraticWeightedKappaGrade": { "$ref": "#/$defs/metricFraction" },
        "focusFieldCompleteness": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/metricFraction" }
          ]
        },
        "focusFieldCounts": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/focusFieldCounts" }
          ]
        },
        "grammarSiteAgreement": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/metricFraction" }
          ]
        },
        "grammarSiteCounts": { "$ref": "#/$defs/diagnosticCounts" },
        "blankOptionAgreement": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/metricFraction" }
          ]
        },
        "blankOptionCounts": { "$ref": "#/$defs/diagnosticCounts" },
        "blankAxisAgreement": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/metricFraction" }
          ]
        },
        "blankAxisCounts": { "$ref": "#/$defs/diagnosticCounts" }
      }
    },
    "diagnosticCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correct", "required"],
      "properties": {
        "correct": { "type": "integer", "minimum": 0 },
        "required": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

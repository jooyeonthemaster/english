{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewer-calibration-v4-production-bound-v3-events",
  "title": "Reviewer calibration v4 production-bound v3 future evidence",
  "description": "Schemas only; this design contains zero event instances.",
  "oneOf": [
    { "$ref": "#/$defs/roleAssignment" },
    { "$ref": "#/$defs/artifactAuthorshipRecord" },
    { "$ref": "#/$defs/slotMaterialization" },
    { "$ref": "#/$defs/fingerprintReservation" },
    { "$ref": "#/$defs/fingerprintTombstone" },
    { "$ref": "#/$defs/disjointnessProof" },
    { "$ref": "#/$defs/passedCoverageEvent" },
    { "$ref": "#/$defs/reviewerCertificate" },
    { "$ref": "#/$defs/freshAdjudicatorBinding" },
    { "$ref": "#/$defs/trustedGoldAuditReport" },
    { "$ref": "#/$defs/authorization" },
    { "$ref": "#/$defs/openEvent" },
    { "$ref": "#/$defs/capabilityConsume" },
    { "$ref": "#/$defs/closeEvent" },
    { "$ref": "#/$defs/denial" },
    { "$ref": "#/$defs/phaseTransition" },
    { "$ref": "#/$defs/certificationEvidenceSeal" },
    { "$ref": "#/$defs/activationCandidate" },
    { "$ref": "#/$defs/activationCandidateAuditReport" },
    { "$ref": "#/$defs/activationGrant" }
  ],
  "x-semanticConstraints": [
    "ROLE_ASSIGNMENT_MUST_SATISFY_ROLE_AND_ARTIFACT_AUTHORSHIP_INCOMPATIBILITY_GRAPH",
    "ARTIFACT_CLASS_MUST_MAP_TO_ITS_EXACT_AUTHOR_ROLE",
    "TRUSTED_GOLD_AUDITOR_CANNOT_BE_PACKET_ITEM_OR_GOLD_AUTHOR_OR_ANY_RATER_REVIEWER_ADJUDICATOR_CUSTODIAN_RESULT_VIEWER",
    "ACTIVATION_AUDITOR_CANNOT_BE_ANY_AUTHOR_REVIEWER_GOLD_AUDITOR_ADJUDICATOR_CUSTODIAN_RESULT_VIEWER_OR_AUDIT_OWN_ARTIFACT",
    "SLOT_TYPE_FAMILY_EPOCH_MUST_EQUAL_BINDING_V4_SELECTED_AT_FOR_PHASE_AND_EPOCH",
    "ALL_60_FINGERPRINT_BUNDLES_MUST_BE_PAIRWISE_DISJOINT_AND_ABSENT_FROM_FAILED_REJECTED_PREVIOUSLY_ISSUED_TOMBSTONES",
    "CONTACT_EVENT_IS_NEVER_A_PASSED_COVERAGE_EVENT",
    "FOCUS_ONLY_REQUIRES_EXACT_TWO_TYPE_IDS_AND_TWO_PASSED_COVERAGE_EVENT_HASHES_FOR_BOTH_REVIEWERS",
    "ALL_25_REQUIRES_EXACT_25_TYPE_IDS_AND_25_PASSED_COVERAGE_EVENT_HASHES_FOR_BOTH_REVIEWERS",
    "EACH_COVERAGE_HASH_RESOLVES_TO_A_DISTINCT_PASSED_EVENT_WITH_CANONICAL_TYPE_EQUAL_TO_ITS_MAP_KEY",
    "ACTIVATION_CANDIDATE_HAS_AUTHORITY_FALSE_AND_CONTAINS_NO_FUTURE_AUDIT_HASH",
    "CANDIDATE_AUDIT_BINDS_EXACT_PREEXISTING_CANDIDATE_BYTES_AND_HAS_AUTHORITY_FALSE",
    "CANDIDATE_AUDIT_REPORT_CONTAINS_NO_HASH_OF_ITS_OWN_FUTURE_PACKAGE_MANIFEST",
    "FINAL_GRANT_BINDS_PREEXISTING_PASS_AUDIT_REPORT_AND_MANIFEST_AND_CANNOT_EXCEED_CANDIDATE_OR_CERTIFICATE_SCOPE",
    "AUTHORIZATION_AND_DENIAL_BIND_CURRENT_STATE_RESOURCE_CLASS_POLICY_ALLOWLIST_DENY_SET_AND_POLICY_PROOF",
    "PHASE1_AUTHORIZATION_SCHEMA_CANNOT_ENCODE_ANSWER_REVEAL_OR_TRUSTED_GOLD_RESOURCE_CLASS",
    "AUTHORIZATION_OPEN_CONSUME_CLOSE_ARE_FOUR_IMMEDIATELY_CONSECUTIVE_APPEND_ONLY_EVENTS",
    "CAPABILITY_HASH_IS_UNIQUE_SINGLE_USE_AND_CONSUME_USE_ORDINAL_IS_ONE",
    "AUTHORIZED_AT_LT_OPENED_AT_LTE_CONSUMED_AT_LTE_CLOSED_AT_AND_EACH_TIME_EQUALS_ITS_EVENT_OCCURRED_AT",
    "NO_RESULT_ACCESS_BEFORE_FINAL_ACTIVATION_GRANT"
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "rfc3339": { "type": "string", "format": "date-time" },
    "pseudonym": { "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "state": {
      "type": "string",
      "enum": [
        "PRE_ACCESS_UNAUTHORIZED", "TAXONOMY_PILOT_12_ISSUED", "TAXONOMY_PILOT_12_PASSED_SEALED",
        "MAIN_CERTIFICATION_24_ISSUED", "MAIN_CERTIFICATION_24_PASSED_SEALED",
        "INDEPENDENT_TRUSTED_GOLD_AUDIT_PASSED_SEALED", "ACTIVATION_HOLDOUT_24_ISSUED",
        "ACTIVATION_HOLDOUT_24_PASSED_SEALED", "CERTIFICATION_EVIDENCE_SEALED_AUTHORITY_FALSE",
        "ACTIVATION_CANDIDATE_RECORDED_AUTHORITY_FALSE", "ACTIVATION_CANDIDATE_AUDIT_PASSED_AUTHORITY_FALSE",
        "ACTIVATION_GRANTED"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "TAXONOMY_PILOT", "TAXONOMY_PILOT_PHASE1", "MAIN_CERTIFICATION", "MAIN_CERTIFICATION_PHASE1",
        "MAIN_CERTIFICATION_PHASE2", "MAIN_CERTIFICATION_PHASE3", "INDEPENDENT_TRUSTED_GOLD_AUDIT",
        "ACTIVATION_HOLDOUT", "ACTIVATION_HOLDOUT_PHASE1", "ACTIVATION_CANDIDATE_AUDIT",
        "POST_ACTIVATION_RESULT", "SEPARATE_ACTIVATION"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "PACKET_AUTHOR", "ITEM_AUTHOR", "GOLD_AUTHOR", "TAXONOMY_PILOT_RATER", "MAIN_CERTIFICATION_RATER",
        "ACTIVATION_HOLDOUT_RATER", "CERTIFICATION_REVIEWER", "TRUSTED_GOLD_AUDITOR", "CALIBRATION_ADJUDICATOR",
        "S1_REVIEWER", "S1_ADJUDICATOR", "S1_RESULT_CUSTODIAN", "S1_RESULT_VIEWER",
        "ACTIVATION_CANDIDATE_AUTHOR", "INDEPENDENT_ACTIVATION_AUDITOR", "ACTIVATION_GRANT_AUTHOR"
      ]
    },
    "typeId": {
      "type": "string",
      "enum": [
        "BLANK_INFERENCE", "GRAMMAR_ERROR", "GRAMMAR_CHOICE_COMBO", "VOCAB_CHOICE", "SENTENCE_ORDER",
        "SENTENCE_INSERT", "TOPIC", "MAIN_IDEA", "TITLE", "IMPLIED_MEANING", "REFERENCE", "CONTENT_MATCH",
        "SUMMARY_COMPLETE_MC", "IRRELEVANT", "CONDITIONAL_WRITING", "SENTENCE_TRANSFORM", "FILL_BLANK_KEY",
        "SUMMARY_COMPLETE", "SUMMARY_WRITING", "WORD_ORDER", "TOPIC_SENTENCE_WRITING", "GRAMMAR_CORRECTION",
        "CONTEXT_MEANING", "SYNONYM", "ANTONYM"
      ]
    },
    "familyId": {
      "type": "string",
      "enum": [
        "NF-F1-GLOBAL_MEANING_SELECTION", "NF-F2-LOCAL_INFERENCE_AND_REFERENCE", "NF-F3-DISCOURSE_STRUCTURE",
        "NF-F4-GRAMMAR_FORM_DIAGNOSIS", "NF-F5-LEXICAL_SEMANTICS", "NF-F6-SUMMARY_AND_COMPRESSION",
        "NF-F7-CONTROLLED_REWRITE_AND_ORDER", "NF-F8-TARGETED_CONSTRUCTED_EXPRESSION"
      ]
    },
    "resourceClass": {
      "type": "string",
      "enum": [
        "BLIND_STUDENT_VISIBLE_SURFACE", "FROZEN_PUBLIC_CODEBOOK", "OWN_PHASE1_RESPONSE",
        "BOUND_ANSWER_EXPLANATION_REVEAL", "TRUSTED_GOLD_AUDIT_BUNDLE", "ADJUDICATION_BUNDLE",
        "ACTIVATION_CANDIDATE_BYTES", "ACTIVATION_AUDIT_REPORT_BYTES", "S1_RESULT_SCOPE_BOUND",
        "OUT_OF_SCOPE_S1_RESULT", "OTHER_RATER_IDENTITY", "RAW_HIDDEN_COMMITMENT", "REJECTION_SURPLUS_HISTORY",
        "RAW_PRIVATE_TRUSTED_GOLD"
      ]
    },
    "baseEvent": {
      "type": "object",
      "required": ["schemaVersion", "eventKind", "eventId", "eventOrdinal", "priorEventSha256", "occurredAtRfc3339", "artifactId", "eventSha256"],
      "properties": {
        "schemaVersion": { "const": "reviewer-calibration-v4-production-bound-event-3" },
        "eventKind": { "type": "string" },
        "eventId": { "type": "string", "minLength": 12, "maxLength": 128 },
        "eventOrdinal": { "type": "integer", "minimum": 1 },
        "priorEventSha256": { "$ref": "#/$defs/sha256" },
        "occurredAtRfc3339": { "$ref": "#/$defs/rfc3339" },
        "artifactId": { "type": "string", "minLength": 8 },
        "eventSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "roleAssignment": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        { "type": "object", "required": ["roleSlotId", "actorPseudonym", "role", "roleRegistryBeforeSha256", "roleRegistryAfterSha256", "roleExclusionProofSha256", "artifactAuthorshipExclusionProofSha256", "decision"], "properties": {
          "eventKind": { "const": "ROLE_ASSIGNMENT" },
          "roleSlotId": { "type": "string", "minLength": 4 },
          "actorPseudonym": { "$ref": "#/$defs/pseudonym" },
          "role": { "$ref": "#/$defs/role" },
          "roleRegistryBeforeSha256": { "$ref": "#/$defs/sha256" },
          "roleRegistryAfterSha256": { "$ref": "#/$defs/sha256" },
          "roleExclusionProofSha256": { "$ref": "#/$defs/sha256" },
          "artifactAuthorshipExclusionProofSha256": { "$ref": "#/$defs/sha256" },
          "decision": { "enum": ["ASSIGN", "DENY"] }
        } }
      ],
      "unevaluatedProperties": false
    },
    "artifactAuthorshipRecord": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        { "if": { "properties": { "artifactClass": { "const": "PACKET" } }, "required": ["artifactClass"] }, "then": { "properties": { "authorRole": { "const": "PACKET_AUTHOR" } } } },
        { "if": { "properties": { "artifactClass": { "const": "ITEM" } }, "required": ["artifactClass"] }, "then": { "properties": { "authorRole": { "const": "ITEM_AUTHOR" } } } },
        { "if": { "properties": { "artifactClass": { "const": "GOLD" } }, "required": ["artifactClass"] }, "then": { "properties": { "authorRole": { "const": "GOLD_AUTHOR" } } } },
        { "if": { "properties": { "artifactClass": { "const": "REVIEWER_CERTIFICATE" } }, "required": ["artifactClass"] }, "then": { "properties": { "authorRole": { "const": "CERTIFICATION_REVIEWER" } } } },
        { "if": { "properties": { "artifactClass": { "const": "TRUSTED_GOLD_AUDIT" } }, "required": ["artifactClass"] }, "then": { "properties": { "authorRole": { "const": "TRUSTED_GOLD_AUDITOR" } } } },
        { "if": { "properties": { "artifactClass": { "const": "ACTIVATION_CANDIDATE" } }, "required": ["artifactClass"] }, "then": { "properties": { "authorRole": { "const": "ACTIVATION_CANDIDATE_AUTHOR" } } } },
        { "if": { "properties": { "artifactClass": { "const": "ACTIVATION_AUDIT_REPORT" } }, "required": ["artifactClass"] }, "then": { "properties": { "authorRole": { "const": "INDEPENDENT_ACTIVATION_AUDITOR" } } } },
        { "if": { "properties": { "artifactClass": { "const": "ACTIVATION_GRANT" } }, "required": ["artifactClass"] }, "then": { "properties": { "authorRole": { "const": "ACTIVATION_GRANT_AUTHOR" } } } },
        { "type": "object", "required": ["artifactSha256", "artifactClass", "authorPseudonym", "authorRole", "authorshipRegistryBeforeSha256", "authorshipRegistryAfterSha256"], "properties": {
          "eventKind": { "const": "ARTIFACT_AUTHORSHIP_RECORD" },
          "artifactSha256": { "$ref": "#/$defs/sha256" },
          "artifactClass": { "enum": ["PACKET", "ITEM", "GOLD", "REVIEWER_CERTIFICATE", "TRUSTED_GOLD_AUDIT", "ACTIVATION_CANDIDATE", "ACTIVATION_AUDIT_REPORT", "ACTIVATION_GRANT"] },
          "authorPseudonym": { "$ref": "#/$defs/pseudonym" },
          "authorRole": { "$ref": "#/$defs/role" },
          "authorshipRegistryBeforeSha256": { "$ref": "#/$defs/sha256" },
          "authorshipRegistryAfterSha256": { "$ref": "#/$defs/sha256" }
        } }
      ],
      "unevaluatedProperties": false
    },
    "fingerprintBundle": {
      "type": "object",
      "required": ["normalizedFullTextSha256", "hashedEightWordWindowSetSha256", "topicTagSetSha256", "scenarioEntityTupleSha256", "itemAuthorPseudonymSha256", "surfaceTemplateFingerprintSha256", "compositeFingerprintSha256"],
      "properties": {
        "normalizedFullTextSha256": { "$ref": "#/$defs/sha256" },
        "hashedEightWordWindowSetSha256": { "$ref": "#/$defs/sha256" },
        "topicTagSetSha256": { "$ref": "#/$defs/sha256" },
        "scenarioEntityTupleSha256": { "$ref": "#/$defs/sha256" },
        "itemAuthorPseudonymSha256": { "$ref": "#/$defs/sha256" },
        "surfaceTemplateFingerprintSha256": { "$ref": "#/$defs/sha256" },
        "compositeFingerprintSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "slotMaterialization": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        { "if": { "properties": { "block": { "const": "GRAMMAR" } }, "required": ["block"] }, "then": { "properties": { "canonicalTypeId": { "const": "GRAMMAR_ERROR" }, "canonicalFamilyId": { "type": "null" } } } },
        { "if": { "properties": { "block": { "const": "BLANK" } }, "required": ["block"] }, "then": { "properties": { "canonicalTypeId": { "const": "BLANK_INFERENCE" }, "canonicalFamilyId": { "type": "null" } } } },
        { "if": { "properties": { "block": { "const": "NONFOCUS" } }, "required": ["block"] }, "then": { "properties": { "canonicalFamilyId": { "$ref": "#/$defs/familyId" } } } },
        { "type": "object", "required": [
          "slotId", "phase", "block", "slotOrdinal", "canonicalTypeId", "canonicalFamilyId", "rotationEpoch",
          "itemIdentityAndSourceSha256", "visibleSurfaceSha256", "answerKeySha256", "trustedGoldSha256",
          "explanationFatalCraftEvidenceSha256", "authorHypothesisTargetSha256", "rejectionHistoryRootSha256",
          "surplusHistoryRootSha256", "packetOrderRelabelSha256", "rightsPiiEvidenceSha256", "fingerprintBundle",
          "fingerprintReservationEventSha256", "typeFamilyRotationProofSha256", "bindingV4ManifestSha256", "decision"
        ], "properties": {
          "eventKind": { "const": "SLOT_MATERIALIZATION" },
          "slotId": { "type": "string", "pattern": "^(TP|MC|AH)-(G|B|N)-[0-9]{2}$" },
          "phase": { "enum": ["TAXONOMY_PILOT", "MAIN_CERTIFICATION", "ACTIVATION_HOLDOUT"] },
          "block": { "enum": ["GRAMMAR", "BLANK", "NONFOCUS"] },
          "slotOrdinal": { "type": "integer", "minimum": 1, "maximum": 8 },
          "canonicalTypeId": { "$ref": "#/$defs/typeId" },
          "canonicalFamilyId": { "oneOf": [{ "$ref": "#/$defs/familyId" }, { "type": "null" }] },
          "rotationEpoch": { "type": "integer", "minimum": 1 },
          "itemIdentityAndSourceSha256": { "$ref": "#/$defs/sha256" }, "visibleSurfaceSha256": { "$ref": "#/$defs/sha256" },
          "answerKeySha256": { "$ref": "#/$defs/sha256" }, "trustedGoldSha256": { "$ref": "#/$defs/sha256" },
          "explanationFatalCraftEvidenceSha256": { "$ref": "#/$defs/sha256" }, "authorHypothesisTargetSha256": { "$ref": "#/$defs/sha256" },
          "rejectionHistoryRootSha256": { "$ref": "#/$defs/sha256" }, "surplusHistoryRootSha256": { "$ref": "#/$defs/sha256" },
          "packetOrderRelabelSha256": { "$ref": "#/$defs/sha256" }, "rightsPiiEvidenceSha256": { "$ref": "#/$defs/sha256" },
          "fingerprintBundle": { "$ref": "#/$defs/fingerprintBundle" }, "fingerprintReservationEventSha256": { "$ref": "#/$defs/sha256" },
          "typeFamilyRotationProofSha256": { "$ref": "#/$defs/sha256" },
          "bindingV4ManifestSha256": { "const": "715818a82951a8c51460a3216b81d46c3184a1db934cc96e27602bc666024f04" },
          "decision": { "const": "MATERIALIZE" }
        } }
      ],
      "unevaluatedProperties": false
    },
    "fingerprintReservation": {
      "allOf": [{ "$ref": "#/$defs/baseEvent" }, { "type": "object", "required": ["slotId", "phase", "fingerprintBundle", "registryBeforeSha256", "failedRejectedPriorIssuedTombstoneRootSha256", "collisionCheckProofSha256", "registryAfterSha256", "decision"], "properties": {
        "eventKind": { "const": "FINGERPRINT_RESERVATION" }, "slotId": { "type": "string" }, "phase": { "$ref": "#/$defs/phase" },
        "fingerprintBundle": { "$ref": "#/$defs/fingerprintBundle" }, "registryBeforeSha256": { "$ref": "#/$defs/sha256" },
        "failedRejectedPriorIssuedTombstoneRootSha256": { "$ref": "#/$defs/sha256" }, "collisionCheckProofSha256": { "$ref": "#/$defs/sha256" },
        "registryAfterSha256": { "$ref": "#/$defs/sha256" }, "decision": { "enum": ["RESERVE", "DENY_COLLISION"] }
      } }],
      "unevaluatedProperties": false
    },
    "fingerprintTombstone": {
      "allOf": [{ "$ref": "#/$defs/baseEvent" }, { "type": "object", "required": ["slotId", "fingerprintBundle", "terminalDisposition", "registryBeforeSha256", "registryAfterSha256", "neverReissue"], "properties": {
        "eventKind": { "const": "FINGERPRINT_TOMBSTONE" }, "slotId": { "type": "string" }, "fingerprintBundle": { "$ref": "#/$defs/fingerprintBundle" },
        "terminalDisposition": { "enum": ["FAILED", "REJECTED", "PREVIOUSLY_ISSUED"] }, "registryBeforeSha256": { "$ref": "#/$defs/sha256" },
        "registryAfterSha256": { "$ref": "#/$defs/sha256" }, "neverReissue": { "const": true }
      } }],
      "unevaluatedProperties": false
    },
    "disjointnessProof": {
      "allOf": [{ "$ref": "#/$defs/baseEvent" }, { "type": "object", "required": ["pilotCount", "mainCount", "holdoutCount", "all60CompositeFingerprintRootSha256", "componentRootsByPhaseSha256", "pairwiseComparisonCount", "allPairwiseComparisonsRootSha256", "failedRejectedTombstoneRootSha256", "priorIssuedFingerprintRootSha256", "noCollisionVerdict", "proofSha256"], "properties": {
        "eventKind": { "const": "DISJOINTNESS_PROOF" }, "pilotCount": { "const": 12 }, "mainCount": { "const": 24 }, "holdoutCount": { "const": 24 },
        "all60CompositeFingerprintRootSha256": { "$ref": "#/$defs/sha256" }, "componentRootsByPhaseSha256": { "$ref": "#/$defs/sha256" },
        "pairwiseComparisonCount": { "const": 1770 }, "allPairwiseComparisonsRootSha256": { "$ref": "#/$defs/sha256" },
        "failedRejectedTombstoneRootSha256": { "$ref": "#/$defs/sha256" }, "priorIssuedFingerprintRootSha256": { "$ref": "#/$defs/sha256" },
        "noCollisionVerdict": { "const": true }, "proofSha256": { "$ref": "#/$defs/sha256" }
      } }],
      "unevaluatedProperties": false
    },
    "passedCoverageEvent": {
      "allOf": [{ "$ref": "#/$defs/baseEvent" }, { "type": "object", "required": ["canonicalTypeId", "phase", "slotId", "decisionSealSha256", "uniqueAnswerCheckPassed", "fatalChecksPassed", "coverageVerdict"], "properties": {
        "eventKind": { "const": "PASSED_COVERAGE_EVENT" }, "canonicalTypeId": { "$ref": "#/$defs/typeId" },
        "phase": { "enum": ["MAIN_CERTIFICATION", "ACTIVATION_HOLDOUT"] }, "slotId": { "type": "string" },
        "decisionSealSha256": { "$ref": "#/$defs/sha256" }, "uniqueAnswerCheckPassed": { "const": true },
        "fatalChecksPassed": { "const": true }, "coverageVerdict": { "const": "PASS" }
      } }],
      "unevaluatedProperties": false
    },
    "focusCoverageEvidence": {
      "type": "object",
      "required": ["scopeEnum", "canonicalTypeIds", "coverageCount", "passedCoverageEventSha256ByCanonicalType", "coverageMapRootSha256"],
      "properties": {
        "scopeEnum": { "const": "FOCUS_ONLY" },
        "canonicalTypeIds": { "type": "array", "prefixItems": [{ "const": "GRAMMAR_ERROR" }, { "const": "BLANK_INFERENCE" }], "minItems": 2, "maxItems": 2 },
        "coverageCount": { "const": 2 },
        "passedCoverageEventSha256ByCanonicalType": {
          "type": "object", "required": ["GRAMMAR_ERROR", "BLANK_INFERENCE"],
          "properties": { "GRAMMAR_ERROR": { "$ref": "#/$defs/sha256" }, "BLANK_INFERENCE": { "$ref": "#/$defs/sha256" } },
          "additionalProperties": false
        },
        "coverageMapRootSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "all25CoverageMap": {
      "type": "object",
      "required": [
        "BLANK_INFERENCE", "GRAMMAR_ERROR", "GRAMMAR_CHOICE_COMBO", "VOCAB_CHOICE", "SENTENCE_ORDER", "SENTENCE_INSERT", "TOPIC", "MAIN_IDEA", "TITLE", "IMPLIED_MEANING", "REFERENCE", "CONTENT_MATCH", "SUMMARY_COMPLETE_MC", "IRRELEVANT", "CONDITIONAL_WRITING", "SENTENCE_TRANSFORM", "FILL_BLANK_KEY", "SUMMARY_COMPLETE", "SUMMARY_WRITING", "WORD_ORDER", "TOPIC_SENTENCE_WRITING", "GRAMMAR_CORRECTION", "CONTEXT_MEANING", "SYNONYM", "ANTONYM"
      ],
      "properties": {
        "BLANK_INFERENCE": { "$ref": "#/$defs/sha256" }, "GRAMMAR_ERROR": { "$ref": "#/$defs/sha256" }, "GRAMMAR_CHOICE_COMBO": { "$ref": "#/$defs/sha256" }, "VOCAB_CHOICE": { "$ref": "#/$defs/sha256" }, "SENTENCE_ORDER": { "$ref": "#/$defs/sha256" }, "SENTENCE_INSERT": { "$ref": "#/$defs/sha256" }, "TOPIC": { "$ref": "#/$defs/sha256" }, "MAIN_IDEA": { "$ref": "#/$defs/sha256" }, "TITLE": { "$ref": "#/$defs/sha256" }, "IMPLIED_MEANING": { "$ref": "#/$defs/sha256" }, "REFERENCE": { "$ref": "#/$defs/sha256" }, "CONTENT_MATCH": { "$ref": "#/$defs/sha256" }, "SUMMARY_COMPLETE_MC": { "$ref": "#/$defs/sha256" }, "IRRELEVANT": { "$ref": "#/$defs/sha256" }, "CONDITIONAL_WRITING": { "$ref": "#/$defs/sha256" }, "SENTENCE_TRANSFORM": { "$ref": "#/$defs/sha256" }, "FILL_BLANK_KEY": { "$ref": "#/$defs/sha256" }, "SUMMARY_COMPLETE": { "$ref": "#/$defs/sha256" }, "SUMMARY_WRITING": { "$ref": "#/$defs/sha256" }, "WORD_ORDER": { "$ref": "#/$defs/sha256" }, "TOPIC_SENTENCE_WRITING": { "$ref": "#/$defs/sha256" }, "GRAMMAR_CORRECTION": { "$ref": "#/$defs/sha256" }, "CONTEXT_MEANING": { "$ref": "#/$defs/sha256" }, "SYNONYM": { "$ref": "#/$defs/sha256" }, "ANTONYM": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "all25CoverageEvidence": {
      "type": "object",
      "required": ["scopeEnum", "canonicalTypeIds", "coverageCount", "passedCoverageEventSha256ByCanonicalType", "coverageMapRootSha256"],
      "properties": {
        "scopeEnum": { "const": "ALL_25" },

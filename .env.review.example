# ============================================================================
# .env.review.example — PG 계약/카드사 심사 의뢰 직전 환경변수 템플릿
# 실제 값은 커밋하지 말고 Vercel Project Settings > Environment Variables에
# Preview 또는 Production 범위로 입력하세요.
#
# 목표:
# - 실 도메인 https://www.smoat.co.kr 에서 상품/약관/환불/사업자정보 확인
# - PortOne 테스트 채널로 결제창 호출 확인
# - 실연동 키/실결제 오픈은 PG 계약 및 카드사 심사 완료 후 진행
# ============================================================================

# ─── App URL / Auth ─────────────────────────────────────────────────────────
NEXTAUTH_URL="https://www.smoat.co.kr"
NEXT_PUBLIC_SITE_URL="https://www.smoat.co.kr"
NEXT_PUBLIC_APP_URL="https://www.smoat.co.kr"
NEXTAUTH_SECRET="<review-random-secret>"
ADMIN_JWT_SECRET="<review-random-secret>"

# ─── Supabase / Database ────────────────────────────────────────────────────
# 심사용으로 운영 DB를 쓸지, 별도 review DB를 쓸지는 팀에서 결정한다.
# 실제 학원/결제 데이터 보호가 중요하면 별도 review DB를 권장한다.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<supabase-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-key>"

# ─── PortOne V2 / 테스트 채널 ───────────────────────────────────────────────
# 계약/심사 전 단계에서는 테스트 채널로 일반 결제창과 카드 빌링키 발급창을
# 모두 확인한다.
# 아래 값들은 같은 Store, 같은 테스트 연동 환경에서 복사해야 한다.
PORTONE_API_SECRET="<portone-v2-api-secret-for-review-or-test>"
PORTONE_WEBHOOK_SECRET="<portone-v2-test-webhook-secret>"
# PORTONE_WEBHOOK_SECRET1="<portone-v2-test-webhook-secret-1>"
# PORTONE_WEBHOOK_SECRET2="<portone-v2-test-webhook-secret-2>"
PORTONE_STORE_ID="store-..."
PORTONE_CHANNEL_KEY="channel-key-..."
NEXT_PUBLIC_PORTONE_STORE_ID="store-..."
NEXT_PUBLIC_PORTONE_CHANNEL_KEY="channel-key-..."
# 카드사 심사 전에는 계약 범위가 명확한 수단만 노출한다.
PORTONE_TOP_UP_PAY_METHODS="CARD"
NEXT_PUBLIC_PORTONE_TOP_UP_PAY_METHODS="CARD"

# PortOne 콘솔 등록값:
# Webhook version: 결제모듈 V2
# Mode: 테스트 또는 심사용 테스트 채널
# Endpoint URL: https://www.smoat.co.kr/api/portone/webhook
# Content-Type: application/json
# Event: Payment.* 및 BillingKey.* 이벤트 전송

# ─── Business / Legal Info ──────────────────────────────────────────────────
NEXT_PUBLIC_BUSINESS_COMPANY_NAME="NEANDER Co.,LTD"
NEXT_PUBLIC_BUSINESS_BRAND_NAME="SMOAT"
NEXT_PUBLIC_BUSINESS_REPRESENTATIVE="유재영, 이동주"
NEXT_PUBLIC_BUSINESS_REGISTRATION_NUMBER="683-86-02812"
NEXT_PUBLIC_BUSINESS_MAIL_ORDER_NUMBER="2023-서울서대문-1558"
NEXT_PUBLIC_BUSINESS_ADDRESS="서울 마포구 독막로36길 10-6, 1층(대흥동)"
NEXT_PUBLIC_BUSINESS_PHONE="02-336-3368"
NEXT_PUBLIC_BUSINESS_EMAIL="neander@neander.co.kr"
NEXT_PUBLIC_BUSINESS_HOSTING_PROVIDER="Vercel"
NEXT_PUBLIC_BUSINESS_INFO_VERIFY_URL="https://www.ftc.go.kr/bizCommPop.do?wrkr_no=6838602812"

# ─── Temporary PG Review UI Flags ───────────────────────────────────────────
# 심사 의뢰 직전에는 true로 두면 학생/학부모/튜터 결과 화면이 다시 노출된다.
NEXT_PUBLIC_SHOW_USER_RESULTS=true
# 심사 의뢰 직전에는 true로 두면 크레딧 충전 버튼이 다시 활성화된다.
NEXT_PUBLIC_SHOW_CREDIT_TOP_UP=true
# 심사 의뢰 직전에는 true로 두면 정기결제 등록/자동갱신 버튼이 다시 활성화된다.
NEXT_PUBLIC_SHOW_SUBSCRIPTION_BILLING=true

# ─── OAuth / Email / AI Providers ───────────────────────────────────────────
KAKAO_CLIENT_ID="<kakao-client-id>"
KAKAO_CLIENT_SECRET="<kakao-client-secret>"
RESEND_API_KEY="<resend-api-key>"
REGISTRATION_NOTIFICATION_EMAIL="neander@neander.co.kr"
GEMINI_API_KEY="<gemini-api-key>"
GOOGLE_GENERATIVE_AI_API_KEY="<google-generative-ai-api-key>"
GEMINI_MODEL="gemini-3.5-flash"

# ─── Platform cost dashboard (/admin/costs) ────────────────────────────────
PLATFORM_USD_KRW_RATE=1350
PLATFORM_BILLING_USD_KRW_RATE=1350
PLATFORM_FIXED_MONTHLY_COST_KRW=0
GEMINI_PRICE_INPUT_PER_1M_USD=0
GEMINI_PRICE_OUTPUT_PER_1M_USD=0
ANTHROPIC_PRICE_INPUT_PER_1M_USD=0
ANTHROPIC_PRICE_OUTPUT_PER_1M_USD=0
GOOGLE_DOC_AI_PAGE_COST_USD=0
WEBTOON_IMAGE_COST_USD=0
GOOGLE_BILLING_BIGQUERY_TABLE="<project.dataset.gcp_billing_export_v1_xxx>"
GOOGLE_BILLING_BIGQUERY_PROJECT_ID="<bigquery-project-id>"
GOOGLE_BILLING_BIGQUERY_LOCATION="US"
GOOGLE_BILLING_SERVICE_ACCOUNT_B64="<base64-service-account-json>"
GOOGLE_BILLING_SERVICE_PATTERNS="gemini,generative ai,generative language,document ai"
ANTHROPIC_ADMIN_KEY="<sk-ant-admin...>"

# ─── Trigger.dev / Background Jobs ──────────────────────────────────────────
TRIGGER_SECRET_KEY="<trigger-secret-key>"
TRIGGER_WORKBENCH_QUESTION_QUEUE_NAME="wb-question-generation"
TRIGGER_WORKBENCH_ANALYSIS_QUEUE_NAME="wb-passage-analysis"
TRIGGER_EXTRACTION_PAGE_QUEUE_NAME="extraction-page"
TRIGGER_EXTRACTION_ORCHESTRATOR_QUEUE_NAME="extraction-orchestrator"
TRIGGER_EXTRACTION_FINALIZE_QUEUE_NAME="extraction-finalize"
TRIGGER_WORKBENCH_QUESTION_CONCURRENCY=4
TRIGGER_WORKBENCH_QUESTION_PER_ACADEMY=4
TRIGGER_WORKBENCH_ANALYSIS_CONCURRENCY=2
TRIGGER_WORKBENCH_ANALYSIS_PER_ACADEMY=2
TRIGGER_EXTRACTION_PAGE_CONCURRENCY=2
TRIGGER_EXTRACTION_PAGE_PER_ACADEMY=2
TRIGGER_EXTRACTION_ORCHESTRATOR_CONCURRENCY=1
TRIGGER_EXTRACTION_ORCHESTRATOR_PER_ACADEMY=1
TRIGGER_EXTRACTION_FINALIZE_CONCURRENCY=1
TRIGGER_EXTRACTION_FINALIZE_PER_ACADEMY=1
TRIGGER_WORKBENCH_QUESTION_MAX_ATTEMPTS=2
TRIGGER_WORKBENCH_ANALYSIS_MAX_ATTEMPTS=2
TRIGGER_EXTRACTION_PAGE_MAX_ATTEMPTS=3
TRIGGER_EXTRACTION_FINALIZE_MAX_ATTEMPTS=2
GEMINI_QUESTION_MAX_RETRIES=2
GEMINI_QUESTION_EMPTY_RESULT_MAX_ATTEMPTS=2
QUESTION_PERSISTENCE_TRANSACTION_TIMEOUT_MS=30000

# ─── Google Document AI, if review extraction uses it ───────────────────────
GOOGLE_DOC_AI_PROJECT_NUMBER="<gcp-project-number>"
GOOGLE_DOC_AI_LOCATION="us"
GOOGLE_DOC_AI_PROCESSOR_ID="<processor-id>"
GOOGLE_DOC_AI_SERVICE_ACCOUNT_B64="<base64-service-account-json>"
EXTRACTION_USE_DOCUMENT_AI=true

# ─── Workbench Client Tunables ──────────────────────────────────────────────
NEXT_PUBLIC_WORKBENCH_FAST_BATCH_CONCURRENCY=12
NEXT_PUBLIC_WORKBENCH_ANALYSIS_FAST_BATCH_CONCURRENCY=4

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.mcp.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
prisma/dev.db
prisma/dev.db-journal

# generated analysis files
scripts/analyses/
scripts/_gen_audit_out/
scripts/*-passages.json
scripts/passages-to-analyze.json
nul

# local scratch / temporary debug files (page dumps, OCR text exports, one-off scripts)
temp_*
text*.txt
verify-db.mjs

# Google Cloud service account JSON keys (contain private_key — NEVER commit)
# Pattern matches GCP convention: <project-id>-<12-hex-chars>.json
valued-mission-*.json
nara-ai-*.json
*-service-account*.json
google-credentials*.json

# Test PDFs / one-off OCR text dumps used during extraction-pipeline debugging.
# These can be 1+ MB each and are not project assets.
/nara*.pdf
/고등영어_*.pdf
.*-pdf.tmp.txt

.vercel
.playwright-mcp/
.trigger/

# Local test materials (uploaded exam sheets / images for extraction testing).
/test files/

# Claude Code working directory (per-machine session state, lock files).
.claude/

# Local scratch / promo experiments
/ExtremePromo.tsx
/PromoVideo.tsx
/Root.tsx
/test_ui.html
/cyberpunk_seoul_test.png
/higgsfield-promo.mp4
/hwp_mcp.log
/data/
/public/promo/
/.agents/
/.codex/
/skills-lock.json

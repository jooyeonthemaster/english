# ?�?�?� Google Cloud Document AI (RECITATION-free OCR for the extraction
#      pipeline). All four keys required for M1 PASSAGE_ONLY extraction.
#      `SERVICE_ACCOUNT_B64` is the GCP service-account JSON key base64-
#      encoded; the worker decodes it and signs an OAuth2 JWT at runtime.
GOOGLE_DOC_AI_PROJECT_NUMBER=""
GOOGLE_DOC_AI_LOCATION="us"
GOOGLE_DOC_AI_PROCESSOR_ID=""
GOOGLE_DOC_AI_SERVICE_ACCOUNT_B64=""

# Optional ??toggle the Document AI OCR path (default: ON). Set to "false"
# to fall back to legacy Gemini-vision OCR.
# EXTRACTION_USE_DOCUMENT_AI=true

# =========================== SEO / Indexing ================================
# IndexNow (instant index notification to Naver/Bing). If unset, code uses a
# hardcoded default key that MUST match the public/<key>.txt file in the repo.
# To rotate: set a new key here AND add public/<newkey>.txt with the same value.
INDEXNOW_KEY=""
# Auth token for /api/seo/submit (submits sitemap to Google Search Console +
# pings IndexNow). The Vercel Cron in vercel.json runs daily and Vercel injects
# CRON_SECRET as the Authorization header — you MUST set CRON_SECRET (or
# SEO_TASK_SECRET) in the Vercel project env for the cron to actually submit.
# Manual trigger:
#   curl -X POST -H "Authorization: Bearer <secret>" https://www.smoat.co.kr/api/seo/submit
SEO_TASK_SECRET=""
# CRON_SECRET=""
# GSC service account (base64 JSON) for automatic sitemap submission. The
# service-account email must be added as an "owner" on the Search Console
# property. Reuses GOOGLE_DOC_AI_SERVICE_ACCOUNT_B64 if that SA has GSC access.
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_B64=""
GOOGLE_SEARCH_CONSOLE_SITE_URL="sc-domain:smoat.co.kr"
# Search-engine ownership verification (fallback hardcoded in seo/config.ts).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=""
# Official SNS real-account URLs -> fills Organization.sameAs (real accounts only).
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""
NEXT_PUBLIC_SOCIAL_BLOG=""
NEXT_PUBLIC_SOCIAL_KAKAO=""


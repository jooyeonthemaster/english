# ============================================================================
# .env.example — copy to `.env` (and `.env.local` for Next.js dev) and fill in.
# Real values are NOT committed; ask the project owner for the production
# secrets via a secure channel (Slack DM / 1Password vault / etc.).
# ============================================================================

# ─── Supabase (DB + Storage + Auth) ─────────────────────────────────────────
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ─── Auth (NextAuth) ────────────────────────────────────────────────────────
NEXTAUTH_SECRET="<random-string>"
NEXTAUTH_URL="http://localhost:3000"

# ─── Kakao OAuth (direct, bypassing Supabase Auth) ──────────────────────────
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# ─── AI providers ───────────────────────────────────────────────────────────
# Gemini API key (used by trigger.dev workers for OCR classification +
# grounded restoration calls).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
# Question generation latency guardrails. Gemini can occasionally hang on a
# single structured-output request; low thinking + bounded timeout keeps tail
# latency under control while retry handles transient stalls.
GEMINI_QUESTION_THINKING_BUDGET=0
GEMINI_QUESTION_TIMEOUT_MS=60000
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional second provider (Anthropic) — only required by .env.local
# ANTHROPIC_API_KEY=""

# ─── Trigger.dev (background worker) ────────────────────────────────────────
TRIGGER_SECRET_KEY=""

# Trigger.dev concurrency tuning.
# Defaults below are development-safe. For Production Hobby 50, raise only in
# the Trigger/Vercel production environments after confirming the dashboard
# concurrency limit.
# *_CONCURRENCY is the queue budget cap. *_PER_ACADEMY is the per-academy
# limit applied through Trigger concurrencyKey; the effective queue limit is
# min(*_CONCURRENCY, *_PER_ACADEMY).
TRIGGER_WORKBENCH_QUESTION_QUEUE_NAME="wb-question-generation"
TRIGGER_WORKBENCH_ANALYSIS_QUEUE_NAME="wb-passage-analysis"
TRIGGER_EXTRACTION_PAGE_QUEUE_NAME="extraction-page"
TRIGGER_EXTRACTION_ORCHESTRATOR_QUEUE_NAME="extraction-orchestrator"
TRIGGER_EXTRACTION_FINALIZE_QUEUE_NAME="extraction-finalize"

# Development-safe defaults
TRIGGER_WORKBENCH_QUESTION_CONCURRENCY=4
TRIGGER_WORKBENCH_QUESTION_PER_ACADEMY=4
TRIGGER_WORKBENCH_ANALYSIS_CONCURRENCY=2
TRIGGER_WORKBENCH_ANALYSIS_PER_ACADEMY=2
TRIGGER_EXTRACTION_PAGE_CONCURRENCY=2
TRIGGER_EXTRACTION_PAGE_PER_ACADEMY=2
TRIGGER_EXTRACTION_ORCHESTRATOR_CONCURRENCY=1
TRIGGER_EXTRACTION_ORCHESTRATOR_PER_ACADEMY=1
TRIGGER_EXTRACTION_FINALIZE_CONCURRENCY=1
TRIGGER_EXTRACTION_FINALIZE_PER_ACADEMY=1

# Production Hobby 50 starting point after dashboard confirmation:
# TRIGGER_WORKBENCH_QUESTION_CONCURRENCY=24
# TRIGGER_WORKBENCH_QUESTION_PER_ACADEMY=10
# TRIGGER_WORKBENCH_ANALYSIS_CONCURRENCY=10
# TRIGGER_WORKBENCH_ANALYSIS_PER_ACADEMY=4
# TRIGGER_EXTRACTION_PAGE_CONCURRENCY=15
# TRIGGER_EXTRACTION_PAGE_PER_ACADEMY=6
# TRIGGER_EXTRACTION_ORCHESTRATOR_CONCURRENCY=3
# TRIGGER_EXTRACTION_ORCHESTRATOR_PER_ACADEMY=1
# TRIGGER_EXTRACTION_FINALIZE_CONCURRENCY=3
# TRIGGER_EXTRACTION_FINALIZE_PER_ACADEMY=1

TRIGGER_WORKBENCH_QUESTION_MAX_ATTEMPTS=2
TRIGGER_WORKBENCH_ANALYSIS_MAX_ATTEMPTS=2
TRIGGER_EXTRACTION_PAGE_MAX_ATTEMPTS=3
TRIGGER_EXTRACTION_FINALIZE_MAX_ATTEMPTS=2
GEMINI_QUESTION_MAX_RETRIES=2
GEMINI_QUESTION_EMPTY_RESULT_MAX_ATTEMPTS=2
QUESTION_PERSISTENCE_TRANSACTION_TIMEOUT_MS=30000

# Workbench direct fast path. Used only for selected passages x 1 question,
# which bypasses Trigger.dev and runs direct Vercel function calls.
NEXT_PUBLIC_WORKBENCH_FAST_BATCH_CONCURRENCY=12

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=""
REGISTRATION_NOTIFICATION_EMAIL=""

# ─── Google Cloud Document AI (RECITATION-free OCR for the extraction
#      pipeline). All four keys required for M1 PASSAGE_ONLY extraction.
#      `SERVICE_ACCOUNT_B64` is the GCP service-account JSON key base64-
#      encoded; the worker decodes it and signs an OAuth2 JWT at runtime.
GOOGLE_DOC_AI_PROJECT_NUMBER=""
GOOGLE_DOC_AI_LOCATION="us"
GOOGLE_DOC_AI_PROCESSOR_ID=""
GOOGLE_DOC_AI_SERVICE_ACCOUNT_B64=""

# Optional — toggle the Document AI OCR path (default: ON). Set to "false"
# to fall back to legacy Gemini-vision OCR.
# EXTRACTION_USE_DOCUMENT_AI=true

PORTONE_TOP_UP_PAY_METHODS="CARD"
NEXT_PUBLIC_PORTONE_TOP_UP_PAY_METHODS="CARD"

# ─── 무통장입금 (manual bank transfer, auto-credited) ────────────────────────
# PG-independent path: ships without a PortOne/PG contract. A bank deposit-alert
# SMS/push is relayed to POST /api/credits/top-ups/bank-notify and credits are
# granted automatically when amount + 입금자명 + time window match a pending order.
# Set ENABLED="true" AND fill the account fields to expose the 무통장입금 button.
NEXT_PUBLIC_BANK_DEPOSIT_ENABLED="false"
NEXT_PUBLIC_BANK_DEPOSIT_BANK_NAME=""
NEXT_PUBLIC_BANK_DEPOSIT_ACCOUNT_NUMBER=""
NEXT_PUBLIC_BANK_DEPOSIT_ACCOUNT_HOLDER=""
# How long after a deposit request an incoming deposit can still auto-match (min).
BANK_DEPOSIT_MATCH_WINDOW_MINUTES="30"
# Auth for the deposit-alert relay. EITHER is sufficient:
#  (A) Simplest — phone hits SMOAT directly with `Authorization: Bearer <token>`,
#      body = raw SMS text (Content-Type: text/plain). No Cloudflare needed.
#  (B) Hardened — a proxy signs the raw body with HMAC-SHA256 and sends header
#      `x-bank-notify-signature: sha256=<hex>` (see tools/bank-notify-proxy).
# Generate either: openssl rand -hex 32
BANK_NOTIFY_INGEST_TOKEN=""
BANK_NOTIFY_RELAY_SECRET=""

# 카드(PG) 결제를 허용할 계정(콤마 구분 학원ID 또는 이메일). "*"=전체 허용,
# 미설정/빈값=전체 비활성화(무통장입금만 노출). 결제수단 선택 모달과 PG prepare에 모두 적용.
CARD_TOPUP_ALLOWED=""

